@model ECommerce.Application.DTOs.Hakkimizda.HakkimizdaAyariDto
@{
    ViewData["Title"] = "Hakkımızda Sayfasını Düzenle";
}

<div class="container-fluid py-4">
    <form asp-action="Duzenle" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="/Admin/HakkimizdaAyari" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                <i class="bi bi-arrow-left me-2"></i> Geri Dön
            </a>
            <button type="submit" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold shadow-sm">
                <i class="bi bi-save2-fill me-2"></i> Değişiklikleri Kaydet
            </button>
        </div>

        <div class="row g-4">

            <!-- 1. HİKAYEMİZ, GÖRSEL & SEO -->
            <div class="col-lg-12">
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <h4 class="fw-bold mb-0 text-dark"><i class="bi bi-book-half text-danger me-2"></i> Hikayemiz, Görsel & SEO Alanı</h4>
                        <div class="form-check form-switch fs-5">
                            <input class="form-check-input" type="checkbox" role="switch" id="HikayemizAktifMi" name="HikayemizAktifMi" value="true" @(Model.HikayemizAktifMi ? "checked" : "")>
                            <input type="hidden" name="HikayemizAktifMi" value="false" />
                            <label class="form-check-label fs-6 fw-semibold text-muted" for="HikayemizAktifMi">Aktif Et</label>
                        </div>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Bölüm Başlığı</label>
                            <input type="text" class="form-control rounded-3" name="HikayemizBaslik" value="@Model.HikayemizBaslik" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">SEO Title</label>
                            <input type="text" class="form-control rounded-3" name="SeoTitle" value="@Model.SeoTitle" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">SEO Description</label>
                            <textarea class="form-control rounded-3" name="SeoDescription" rows="2">@Model.SeoDescription</textarea>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Kurumsal Hakkımızda Görseli</label>
                            <input type="file" class="form-control rounded-3" name="gorselDosyasi" accept="image/*" />
                            <input type="hidden" name="GorselUrl" value="@Model.GorselUrl" />
                            @if (!string.IsNullOrEmpty(Model.GorselUrl))
                            {
                                <div class="mt-2">
                                    <img src="@Model.GorselUrl" alt="Mevcut Görsel" style="max-height: 90px;" class="rounded border shadow-sm" />
                                </div>
                            }
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">Hikayemiz / Ana Metin</label>
                            <textarea class="form-control rounded-3" name="HikayemizMetni" rows="5">@Model.HikayemizMetni</textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- 2. NEDEN BİZ KUTULARI (Tamamen Dinamik) -->
            <div class="col-lg-12">
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div>
                            <h4 class="fw-bold mb-1 text-dark"><i class="bi bi-shield-check text-danger me-2"></i> Neden Bizi Seçmelisiniz? (Dinamik Kutular)</h4>
                            <p class="text-muted small mb-0">İstediğiniz kadar avantaj kutusu ekleyip başlık, açıklama ve ikon belirleyebilirsiniz.</p>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold" id="nedenBiziEkleBtn">
                                <i class="bi bi-plus-lg me-1"></i> Yeni Kutu Ekle
                            </button>
                            <div class="form-check form-switch fs-5 mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="NedenBiziAktifMi" name="NedenBiziAktifMi" value="true" @(Model.NedenBiziAktifMi ? "checked" : "")>
                                <input type="hidden" name="NedenBiziAktifMi" value="false" />
                                <label class="form-check-label fs-6 fw-semibold text-muted" for="NedenBiziAktifMi">Aktif Et</label>
                            </div>
                        </div>
                    </div>

                    <div id="nedenBiziListesi" class="row g-3">
                        @if (Model.NedenBiziItems != null)
                        {
                            for (int i = 0; i < Model.NedenBiziItems.Count; i++)
                            {
                                <div class="col-md-4 neden-bizi-item">
                                    <div class="p-3 border rounded-4 bg-light position-relative">
                                        <button type="button" class="btn-close position-absolute top-0 end-0 m-3 remove-neden-bizi" aria-label="Sil"></button>
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold">Başlık</label>
                                            <input type="text" class="form-control form-control-sm rounded-3" name="NedenBiziItems[@i].Baslik" value="@Model.NedenBiziItems[i].Baslik" />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold">Açıklama</label>
                                            <textarea class="form-control form-control-sm rounded-3" name="NedenBiziItems[@i].Aciklama" rows="2">@Model.NedenBiziItems[i].Aciklama</textarea>
                                        </div>
                                        <div>
                                            <label class="form-label small fw-semibold">Bootstrap İkon (Örn: bi-shield-check)</label>
                                            <input type="text" class="form-control form-control-sm rounded-3" name="NedenBiziItems[@i].Ikon" value="@Model.NedenBiziItems[i].Ikon" />
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- 3. DEĞERLERİMİZ -->
            <div class="col-lg-12">
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div>
                            <h4 class="fw-bold mb-1 text-dark"><i class="bi bi-gem text-danger me-2"></i> Değerlerimiz</h4>
                            <p class="text-muted small mb-0">Misyon, vizyon veya kurumsal değerler maddeleri.</p>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold" id="degerEkleBtn">
                                <i class="bi bi-plus-lg me-1"></i> Yeni Değer Ekle
                            </button>
                            <div class="form-check form-switch fs-5 mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="DegerlerimizAktifMi" name="DegerlerimizAktifMi" value="true" @(Model.DegerlerimizAktifMi ? "checked" : "")>
                                <input type="hidden" name="DegerlerimizAktifMi" value="false" />
                                <label class="form-check-label fs-6 fw-semibold text-muted" for="DegerlerimizAktifMi">Aktif Et</label>
                            </div>
                        </div>
                    </div>

                    <div id="degerlerListesi" class="row g-3">
                        @if (Model.Degerlerimiz != null)
                        {
                            for (int i = 0; i < Model.Degerlerimiz.Count; i++)
                            {
                                <div class="col-md-4 deger-item">
                                    <div class="p-3 border rounded-4 bg-light position-relative">
                                        <button type="button" class="btn-close position-absolute top-0 end-0 m-3 remove-deger" aria-label="Sil"></button>
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold">Başlık</label>
                                            <input type="text" class="form-control form-control-sm rounded-3" name="Degerlerimiz[@i].Baslik" value="@Model.Degerlerimiz[i].Baslik" />
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold">Açıklama</label>
                                            <textarea class="form-control form-control-sm rounded-3" name="Degerlerimiz[@i].Aciklama" rows="2">@Model.Degerlerimiz[i].Aciklama</textarea>
                                        </div>
                                        <div>
                                            <label class="form-label small fw-semibold">Bootstrap İkon</label>
                                            <input type="text" class="form-control form-control-sm rounded-3" name="Degerlerimiz[@i].Ikon" value="@Model.Degerlerimiz[i].Ikon" />
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- 4. HİZMET BÖLGELERİ -->
            <div class="col-lg-12">
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <div>
                            <h4 class="fw-bold mb-1 text-dark"><i class="bi bi-geo-alt-fill text-danger me-2"></i> Hizmet Bölgeleri</h4>
                            <p class="text-muted small mb-0">Hizmet verdiğiniz ilçe veya semtleri ekleyin.</p>
                        </div>
                        <div class="form-check form-switch fs-5">
                            <input class="form-check-input" type="checkbox" role="switch" id="HizmetBolgeleriAktifMi" name="HizmetBolgeleriAktifMi" value="true" @(Model.HizmetBolgeleriAktifMi ? "checked" : "")>
                            <input type="hidden" name="HizmetBolgeleriAktifMi" value="false" />
                            <label class="form-check-label fs-6 fw-semibold text-muted" for="HizmetBolgeleriAktifMi">Aktif Et</label>
                        </div>
                    </div>

                    <div class="input-group mb-3" style="max-width: 400px;">
                        <input type="text" id="yeniBolgeInput" class="form-control rounded-start-3" placeholder="Yeni Bölge Yazın (Örn: Merkez)">
                        <button class="btn btn-outline-danger rounded-end-3 px-3 fw-bold" type="button" id="bolgeEkleBtn">Ekle</button>
                    </div>

                    <div id="bolgelerContainer" class="d-flex flex-wrap gap-2">
                        @if (Model.HizmetBolgeleri != null)
                        {
                            for (int i = 0; i < Model.HizmetBolgeleri.Count; i++)
                            {
                                <div class="badge bg-danger bg-opacity-10 text-danger p-2 px-3 rounded-pill d-flex align-items-center gap-2 bolge-badge">
                                    <span>@Model.HizmetBolgeleri[i]</span>
                                    <input type="hidden" name="HizmetBolgeleri[@i]" value="@Model.HizmetBolgeleri[i]" />
                                    <i class="bi bi-x-circle-fill text-danger remove-bolge" style="cursor: pointer;"></i>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

            <!-- KAYDET -->
            <div class="col-lg-12 text-end mb-5">
                <button type="submit" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold shadow-sm">
                    <i class="bi bi-save2-fill me-2"></i> Değişiklikleri Kaydet
                </button>
            </div>

        </div>
    </form>
</div>

@section Scripts {
    <script>
        // 1. NEDEN BİZ DİNAMİK EKLEME
        document.getElementById('nedenBiziEkleBtn').addEventListener('click', function () {
            const container = document.getElementById('nedenBiziListesi');
            const index = container.querySelectorAll('.neden-bizi-item').length;
            const html = `
                        <div class="col-md-4 neden-bizi-item">
                            <div class="p-3 border rounded-4 bg-light position-relative">
                                <button type="button" class="btn-close position-absolute top-0 end-0 m-3 remove-neden-bizi" aria-label="Sil"></button>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Başlık</label>
                                    <input type="text" class="form-control form-control-sm rounded-3" name="NedenBiziItems[${index}].Baslik" value="" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Açıklama</label>
                                    <textarea class="form-control form-control-sm rounded-3" name="NedenBiziItems[${index}].Aciklama" rows="2"></textarea>
                                </div>
                                <div>
                                    <label class="form-label small fw-semibold">Bootstrap İkon</label>
                                    <input type="text" class="form-control form-control-sm rounded-3" name="NedenBiziItems[${index}].Ikon" value="bi-shield-check" />
                                </div>
                            </div>
                        </div>
                    `;
            container.insertAdjacentHTML('beforeend', html);
        });

        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('remove-neden-bizi')) {
                e.target.closest('.neden-bizi-item').remove();
                reindexNedenBizi();
            }
        });

        function reindexNedenBizi() {
            document.querySelectorAll('.neden-bizi-item').forEach((item, index) => {
                item.querySelector('input[name*=".Baslik"]').name = `NedenBiziItems[${index}].Baslik`;
                item.querySelector('textarea[name*=".Aciklama"]').name = `NedenBiziItems[${index}].Aciklama`;
                item.querySelector('input[name*=".Ikon"]').name = `NedenBiziItems[${index}].Ikon`;
            });
        }

        // 2. DEĞERLERİMİZ DİNAMİK EKLEME
        document.getElementById('degerEkleBtn').addEventListener('click', function () {
            const container = document.getElementById('degerlerListesi');
            const index = container.querySelectorAll('.deger-item').length;
            const html = `
                        <div class="col-md-4 deger-item">
                            <div class="p-3 border rounded-4 bg-light position-relative">
                                <button type="button" class="btn-close position-absolute top-0 end-0 m-3 remove-deger" aria-label="Sil"></button>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Başlık</label>
                                    <input type="text" class="form-control form-control-sm rounded-3" name="Degerlerimiz[${index}].Baslik" value="" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-semibold">Açıklama</label>
                                    <textarea class="form-control form-control-sm rounded-3" name="Degerlerimiz[${index}].Aciklama" rows="2"></textarea>
                                </div>
                                <div>
                                    <label class="form-label small fw-semibold">Bootstrap İkon</label>
                                    <input type="text" class="form-control form-control-sm rounded-3" name="Degerlerimiz[${index}].Ikon" value="bi-flower1" />
                                </div>
                            </div>
                        </div>
                    `;
            container.insertAdjacentHTML('beforeend', html);
        });

        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('remove-deger')) {
                e.target.closest('.deger-item').remove();
                reindexDegerler();
            }
        });

        function reindexDegerler() {
            document.querySelectorAll('.deger-item').forEach((item, index) => {
                item.querySelector('input[name*=".Baslik"]').name = `Degerlerimiz[${index}].Baslik`;
                item.querySelector('textarea[name*=".Aciklama"]').name = `Degerlerimiz[${index}].Aciklama`;
                item.querySelector('input[name*=".Ikon"]').name = `Degerlerimiz[${index}].Ikon`;
            });
        }

        // 3. HİZMET BÖLGELERİ
        document.getElementById('bolgeEkleBtn').addEventListener('click', function () {
            const input = document.getElementById('yeniBolgeInput');
            const val = input.value.trim();
            if (!val) return;
            const container = document.getElementById('bolgelerContainer');
            const index = container.querySelectorAll('.bolge-badge').length;
            const badgeHtml = `
                        <div class="badge bg-danger bg-opacity-10 text-danger p-2 px-3 rounded-pill d-flex align-items-center gap-2 bolge-badge">
                            <span>${val}</span>
                            <input type="hidden" name="HizmetBolgeleri[${index}]" value="${val}" />
                            <i class="bi bi-x-circle-fill text-danger remove-bolge" style="cursor: pointer;"></i>
                        </div>
                    `;
            container.insertAdjacentHTML('beforeend', badgeHtml);
            input.value = '';
        });

        document.addEventListener('click', function (e) {
            if (e.target.classList.contains('remove-bolge')) {
                e.target.closest('.bolge-badge').remove();
                reindexBolgeler();
            }
        });

        function reindexBolgeler() {
            document.querySelectorAll('.bolge-badge').forEach((badge, index) => {
                badge.querySelector('input').name = `HizmetBolgeleri[${index}]`;
            });
        }
    </script>
}