@model ECommerce.Application.DTOs.Hakkimizda.HakkimizdaAyariDto
@{
    ViewData["Title"] = "Hakkımızda Sayfa Yönetimi";
}

<div class="container-fluid py-4">
    @if (TempData["BasariliMesaj"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["BasariliMesaj"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-12">
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                <div class="mb-3">
                    <div class="icon-circle mx-auto bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center" style="width: 80px; height: 80px; font-size: 2rem;">
                        <i class="bi bi-building-fill"></i>
                    </div>
                </div>
                <h2 class="fw-bold text-dark mb-2">Hakkımızda Sayfa Modülleri</h2>
                <p class="text-muted mx-auto mb-4" style="max-width: 600px;">
                    Hikayemiz, dinamik neden biz kutuları, değerlerimiz ve hizmet bölgeleri ayarlarını bu panel üzerinden güvenle yönetebilirsiniz.
                </p>
                <div>
                    <a href="/Admin/HakkimizdaAyari/Duzenle" class="btn btn-danger btn-lg rounded-pill px-5 fw-bold shadow-sm">
                        <i class="bi bi-pencil-square me-2"></i> İçeriği Düzenle
                    </a>
                </div>
            </div>
        </div>

        <!-- ÖZET KARTLARI -->
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h6 class="text-muted fw-semibold small mb-2">HİKAYEMİZ BÖLÜMÜ</h6>
                <h4 class="fw-bold mb-0 @(Model.HikayemizAktifMi ? "text-success" : "text-danger")">
                    @(Model.HikayemizAktifMi ? "Aktif" : "Pasif")
                </h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h6 class="text-muted fw-semibold small mb-2">NEDEN BİZ KUTULARI</h6>
                <h4 class="fw-bold mb-0 text-dark">@(Model.NedenBiziItems?.Count ?? 0) Kutu</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h6 class="text-muted fw-semibold small mb-2">DEĞERLERİMİZ</h6>
                <h4 class="fw-bold mb-0 text-dark">@(Model.Degerlerimiz?.Count ?? 0) Madde</h4>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
                <h6 class="text-muted fw-semibold small mb-2">HİZMET BÖLGELERİ</h6>
                <h4 class="fw-bold mb-0 text-dark">@(Model.HizmetBolgeleri?.Count ?? 0) Bölge</h4>
            </div>
        </div>
    </div>
</div>