@{
    ViewData["Title"] = "XML ile Toplu Ürün Yükleme";
}

<style>
    .xml-page {
        max-width: 900px;
        margin: 0 auto;
    }

    .xml-header {
        margin-bottom: 28px;
    }

    .xml-eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #9a1640;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .xml-title {
        font-size: 2rem;
        font-weight: 700;
        color: #24213d;
        margin: 0 0 6px;
        letter-spacing: -.5px;
    }

    .xml-subtitle {
        font-size: .92rem;
        color: #85818c;
        margin: 0;
    }

    .xml-card {
        background: #fff;
        border: 1px solid #eee9ed;
        border-radius: 20px;
        box-shadow: 0 8px 28px rgba(35,28,40,.055);
        padding: 32px;
        margin-bottom: 22px;
    }

    .xml-card-title {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 25px;
    }

    .xml-card-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: #fff2f5;
        color: #8b0028;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }

    .xml-card-title h2 {
        font-size: 1.1rem;
        font-weight: 700;
        color: #24213d;
        margin: 0;
    }

    .xml-card-title p {
        font-size: .78rem;
        color: #99949d;
        margin: 3px 0 0;
    }

    .xml-upload-box {
        border: 2px dashed #d9cbd1;
        border-radius: 18px;
        background: #fcfafb;
        padding: 35px 20px;
        text-align: center;
        transition: all .2s ease;
        cursor: pointer;
        margin-bottom: 20px;
    }

    .xml-upload-box:hover {
        border-color: #8b0028;
        background: #fff4f7;
    }

    .xml-upload-icon {
        width: 64px;
        height: 64px;
        border-radius: 18px;
        background: #fff2f5;
        color: #8b0028;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.8rem;
        margin: 0 auto 15px;
    }

    .xml-upload-text {
        font-size: .9rem;
        font-weight: 600;
        color: #403b46;
        margin-bottom: 5px;
    }

    .xml-upload-subtext {
        font-size: .78rem;
        color: #9d98a0;
    }

    .xml-file-input {
        display: none;
    }

    .xml-selected-file {
        display: none;
        align-items: center;
        justify-content: space-between;
        background: #fff;
        border: 1px solid #e4dfe4;
        border-radius: 12px;
        padding: 12px 16px;
        margin-bottom: 20px;
        font-size: .85rem;
        color: #24213d;
        font-weight: 600;
    }

    .xml-info-box {
        background: #f8f6f9;
        border-radius: 14px;
        padding: 18px 20px;
        margin-bottom: 25px;
    }

    .xml-info-title {
        font-size: .82rem;
        font-weight: 700;
        color: #24213d;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .xml-info-title i {
        color: #8b0028;
    }

    .xml-info-list {
        margin: 0;
        padding-left: 18px;
        font-size: .78rem;
        color: #77717b;
        line-height: 1.6;
    }

    .xml-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .xml-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 46px;
        padding: 0 18px;
        border: 1px solid #e5e0e5;
        border-radius: 12px;
        background: #fff;
        color: #716c75;
        text-decoration: none;
        font-size: .82rem;
        font-weight: 600;
    }

    .xml-submit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 46px;
        padding: 0 22px;
        border: 0;
        border-radius: 12px;
        background: linear-gradient(135deg,#8b0028,#a70b3b);
        color: #fff;
        font-size: .82rem;
        font-weight: 600;
        box-shadow: 0 7px 20px rgba(139,0,40,.2);
        cursor: pointer;
    }

    .xml-submit-btn:hover {
        color: #fff;
        transform: translateY(-1px);
    }

    .urun-alert {
        border: 0;
        border-radius: 13px;
        padding: 13px 16px;
        font-size: .84rem;
        margin-bottom: 18px;
    }

    .urun-alert-success {
        background: #edf9f4;
        color: #287c5d;
    }

    .urun-alert-danger {
        background: #fff0f2;
        color: #a4364b;
    }
</style>

<div class="xml-page">
    <div class="xml-header">
        <div class="xml-eyebrow"><i class="bi bi-flower1"></i> Mağaza Yönetimi</div>
        <h1 class="xml-title">XML ile Ürün Yçe Aktar</h1>
        <p class="xml-subtitle">Tedarikçi veya başka bir platformdan aldığınız XML dosyasıyla toplu ürün yükleyin.</p>
    </div>

    @if (TempData["BasariliMesaj"] != null)
    {
        <div class="alert urun-alert urun-alert-success alert-dismissible fade show" role="alert"><i class="bi bi-check-circle me-2"></i>@TempData["BasariliMesaj"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    @if (TempData["HataMesaji"] != null)
    {
        <div class="alert urun-alert urun-alert-danger alert-dismissible fade show" role="alert"><i class="bi bi-exclamation-circle me-2"></i>@TempData["HataMesaji"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <form asp-action="XmlImport" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="xml-card">
            <div class="xml-card-title">
                <div class="xml-card-icon"><i class="bi bi-filetype-xml"></i></div>
                <div><h2>XML Dosya Yükleme Paneli</h2><p>Sistem standartlarına uygun XML dosyanızı seçin.</p></div>
            </div>

            <div class="xml-info-box">
                <div class="xml-info-title"><i class="bi bi-info-circle-fill"></i> Bilgilendirme</div>
                <ul class="xml-info-list">
                    <li>Yüklenecek dosya formatı <strong>.xml</strong> uzantılı olmalıdır.</li>
                    <li>Ürün kodları (SKU) sistemde zaten kayıtlı olan ürünlerle çakışırsa güncellenir, yeni olanlar sisteme eklenir.</li>
                    <li>Görsel URL adreslerinin doğrudan erişilebilir olduğundan emin olun.</li>
                </ul>
            </div>

            <label for="xmlDosyasi" class="xml-upload-box" id="dropZone">
                <div class="xml-upload-icon"><i class="bi bi-cloud-arrow-up"></i></div>
                <div class="xml-upload-text">XML Dosyasını Seçmek İçin Tıklayın</div>
                <div class="xml-upload-subtext">veya dosyanızı bu alana sürükleyip bırakın</div>
                <input type="file" name="xmlDosyasi" id="xmlDosyasi" class="xml-file-input" accept=".xml" />
            </label>

            <div class="xml-selected-file" id="selectedFileInfo">
                <span id="fileNameDisplay"><i class="bi bi-file-earmark-text me-2"></i> dosya.xml</span>
                <button type="button" class="btn btn-sm text-danger" id="removeFileBtn"><i class="bi bi-x-lg"></i></button>
            </div>

            <div class="xml-actions">
                <a asp-action="Index" class="xml-cancel-btn">Vazgeç</a>
                <button type="submit" class="xml-submit-btn"><i class="bi bi-upload"></i> Ürünleri İçeri Aktar</button>
            </div>
        </div>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const fileInput = document.getElementById("xmlDosyasi");
        const selectedFileInfo = document.getElementById("selectedFileInfo");
        const fileNameDisplay = document.getElementById("fileNameDisplay");
        const removeFileBtn = document.getElementById("removeFileBtn");

        fileInput?.addEventListener("change", function () {
            if (this.files && this.files[0]) {
                fileNameDisplay.innerHTML = `<i class="bi bi-file-earmark-text me-2 text-danger"></i> ${this.files[0].name}`;
                selectedFileInfo.style.display = "flex";
            }
        });

        removeFileBtn?.addEventListener("click", function () {
            fileInput.value = "";
            selectedFileInfo.style.display = "none";
        });
    });
</script>