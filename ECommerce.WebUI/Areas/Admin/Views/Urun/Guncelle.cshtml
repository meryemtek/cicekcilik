@model ECommerce.Application.DTOs.Urun.UrunGuncelleDto
@{
    ViewData["Title"] = "Ürün Düzenle";
}

<!-- Quill.js Zengin Metin Editörü CSS -->
<link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet">
<!-- Select2 CSS (Arama ve Özelleştirilmiş Dropdown için) -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    .urun-form-page {
        max-width: 1180px;
        margin: 0 auto;
    }

    .urun-form-header {
        margin-bottom: 28px;
    }

    .urun-form-eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #9a1640;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .urun-form-title {
        font-size: 2rem;
        font-weight: 700;
        color: #24213d;
        margin: 0 0 6px;
        letter-spacing: -.5px;
    }

    .urun-form-subtitle {
        font-size: .92rem;
        color: #85818c;
        margin: 0;
    }

    .urun-form-layout {
        display: grid;
        grid-template-columns: minmax(0,1.25fr) minmax(300px,.75fr);
        gap: 22px;
        align-items: start;
    }

    .urun-form-card {
        background: #fff;
        border: 1px solid #eee9ed;
        border-radius: 20px;
        box-shadow: 0 8px 28px rgba(35,28,40,.055);
        padding: 28px;
        margin-bottom: 22px;
    }

    .urun-form-card-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 25px;
    }

    .urun-form-card-title-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .urun-form-card-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #fff2f5;
        color: #8b0028;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .urun-form-card-title h2 {
        font-size: 1rem;
        font-weight: 700;
        color: #24213d;
        margin: 0;
    }

    .urun-form-card-title p {
        font-size: .75rem;
        color: #99949d;
        margin: 3px 0 0;
    }

    .ai-generate-btn {
        background: linear-gradient(135deg, #8b0028, #ff1493);
        border: 0;
        border-radius: 11px;
        color: #fff;
        padding: 9px 15px;
        font-size: .78rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(139,0,40,.2);
        transition: all .2s ease;
    }

        .ai-generate-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(139,0,40,.3);
            color: #fff;
        }

    .urun-field {
        margin-bottom: 20px;
    }

        .urun-field label {
            display: block;
            color: #403b46;
            font-size: .8rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

            .urun-field label span {
                color: #b24a60;
            }

    .urun-input {
        width: 100%;
        height: 48px;
        border: 1px solid #e4dfe4;
        border-radius: 12px;
        background: #fff;
        padding: 0 15px;
        color: #24213d;
        font-size: .88rem;
        outline: 0;
        transition: all .2s ease;
    }

        .urun-input:focus {
            border-color: #c98ca0;
            box-shadow: 0 0 0 4px rgba(139,0,40,.06);
        }

    .urun-switch {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border: 1px solid #eee9ed;
        background: #faf9fa;
        border-radius: 13px;
        padding: 15px 16px;
    }

    .urun-switch-text strong {
        display: block;
        font-size: .82rem;
        color: #3e3943;
        margin-bottom: 3px;
    }

    .urun-switch-text span {
        font-size: .7rem;
        color: #99949d;
    }

    .urun-switch input {
        width: 42px;
        height: 23px;
        cursor: pointer;
        accent-color: #8b0028;
    }

    .select2-container--default .select2-selection--single {
        height: 48px;
        border: 1px solid #e4dfe4;
        border-radius: 12px;
        background: #fff;
        display: flex;
        align-items: center;
        outline: 0;
        transition: all .2s ease;
    }

        .select2-container--default.select2-container--open .select2-selection--single,
        .select2-container--default .select2-selection--single:focus {
            border-color: #c98ca0;
            box-shadow: 0 0 0 4px rgba(139,0,40,.06);
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #24213d;
            font-size: .88rem;
            padding-left: 15px;
            line-height: normal;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 46px;
            right: 10px;
        }

    .select2-dropdown {
        border: 1px solid #c98ca0;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(35,28,40,.08);
        overflow: hidden;
    }

    .select2-search--dropdown .select2-search__field {
        border: 1px solid #e4dfe4;
        border-radius: 8px;
        padding: 8px 12px;
        outline: none;
        font-family: inherit;
        font-size: .88rem;
    }

        .select2-search--dropdown .select2-search__field:focus {
            border-color: #c98ca0;
        }

    .select2-container--default .select2-results__option--highlighted.select2-results__option--selectable {
        background-color: #fff2f5;
        color: #8b0028;
    }

    .select2-results__option {
        font-size: .88rem;
        padding: 10px 15px;
    }

    .editor-container {
        height: 180px;
        border-radius: 0 0 12px 12px;
        background: #fff;
    }

    .ql-toolbar.ql-snow {
        border-radius: 12px 12px 0 0;
        border-color: #e4dfe4;
        background: #faf9fa;
    }

    .ql-container.ql-snow {
        border-radius: 0 0 12px 12px;
        border-color: #e4dfe4;
        font-size: .88rem;
        font-family: inherit;
    }

    .urun-help {
        display: block;
        color: #9d98a0;
        font-size: .7rem;
        margin-top: 7px;
    }

    .urun-validation {
        color: #b53d53;
        font-size: .72rem;
        margin-top: 6px;
        display: block;
    }

    .urun-image-upload {
        border: 1px dashed #d9cbd1;
        border-radius: 15px;
        background: #fcfafb;
        padding: 15px;
    }

    .urun-image-preview {
        position: relative;
        width: 100%;
        height: 190px;
        border-radius: 12px;
        overflow: hidden;
        background: #f7f3f5;
        margin-bottom: 12px;
    }

        .urun-image-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .urun-image-remove {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 32px;
        height: 32px;
        border: 0;
        border-radius: 9px;
        background: rgba(255,255,255,.92);
        color: #9a1640;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(0,0,0,.12);
    }

    .urun-file-label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 72px;
        border-radius: 11px;
        background: #fff;
        color: #77717b;
        font-size: .78rem;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
        transition: all .2s ease;
    }

        .urun-file-label:hover {
            background: #fff4f7;
            color: #8b0028;
        }

        .urun-file-label i {
            font-size: 1.3rem;
            color: #9a1640;
        }

    .urun-file-input {
        display: none;
    }

    .urun-preview {
        position: sticky;
        top: 20px;
    }

    .urun-preview-label {
        font-size: .72rem;
        font-weight: 700;
        color: #908b95;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .urun-preview-card {
        background: #fff;
        border: 1px solid #eee9ed;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 12px 35px rgba(35,28,40,.08);
    }

    .urun-preview-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
    }

    .urun-preview-icon {
        width: 52px;
        height: 52px;
        border-radius: 15px;
        background: linear-gradient(145deg,#fff2f5,#fbe3e9);
        color: #8b0028;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        overflow: hidden;
    }

        .urun-preview-icon img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .urun-preview-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border-radius: 20px;
        padding: 7px 10px;
        font-size: .7rem;
        font-weight: 600;
        margin-bottom: 12px;
    }

        .urun-preview-status.active {
            background: #edf9f4;
            color: #287c5d;
        }

        .urun-preview-status.passive {
            background: #f2f1f3;
            color: #85808a;
        }

        .urun-preview-status i {
            font-size: .45rem;
        }

    .urun-preview-name {
        font-size: 1.15rem;
        font-weight: 700;
        color: #24213d;
        margin: 0 0 6px;
    }

    .urun-preview-price {
        font-size: 1.25rem;
        font-weight: 700;
        color: #8b0028;
        margin-bottom: 4px;
    }

    .urun-preview-stock {
        font-size: .78rem;
        color: #99949d;
    }

    .urun-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 22px;
    }

    .urun-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 46px;
        padding: 0 18px;
        border: 1px solid #e5e0e5;
        border-radius: 12px;
        background: #fff;
        color: #716c75;
        text-decoration: none;
        font-size: .82rem;
        font-weight: 600;
    }

        .urun-cancel-btn:hover {
            background: #f8f6f8;
            color: #403b46;
        }

    .urun-save-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 46px;
        padding: 0 20px;
        border: 0;
        border-radius: 12px;
        background: linear-gradient(135deg,#8b0028,#a70b3b);
        color: #fff;
        font-size: .82rem;
        font-weight: 600;
        box-shadow: 0 7px 20px rgba(139,0,40,.2);
    }

        .urun-save-btn:hover {
            color: #fff;
            transform: translateY(-1px);
        }
</style>

<div class="urun-form-page">
    <div class="urun-form-header">
        <div class="urun-form-eyebrow"><i class="bi bi-flower1"></i> Mağaza Yönetimi</div>
        <h1 class="urun-form-title">Ürün Düzenle</h1>
        <p class="urun-form-subtitle">Mevcut ürünün bilgilerini, fiyatını ve içeriklerini güncelleyin.</p>
    </div>

    <form asp-action="Guncelle" method="post" enctype="multipart/form-data" id="urunForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="GorselUrl" /> <!-- MEVCUT RESMİ KORUMAK İÇİN BU ŞART -->

        <div class="urun-form-layout">
            <div>
                <div class="urun-form-card">
                    <div class="urun-form-card-title">
                        <div class="urun-form-card-title-left">
                            <div class="urun-form-card-icon"><i class="bi bi-box-seam"></i></div>
                            <div><h2>Temel Ürün Bilgileri</h2><p>Ürün adı, SKU kodu ve fiyat bilgilerini güncelleyin.</p></div>
                        </div>
                    </div>

                    <div class="urun-field">
                        <label asp-for="KategoriId">Kategori Seçimi <span>*</span></label>
                        <select asp-for="KategoriId" style="width: 100%;" asp-items="ViewBag.Kategoriler" id="kategoriSelect">
                            <option value="">-- Kategori Ara veya Seç --</option>
                        </select>
                        <span asp-validation-for="KategoriId" class="urun-validation"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="urun-field">
                                <label asp-for="Ad">Ürün Adı <span>*</span></label>
                                <input asp-for="Ad" class="urun-input" id="urunAd" autocomplete="off" />
                                <span asp-validation-for="Ad" class="urun-validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="urun-field">
                                <label asp-for="UrunKodu">Ürün Kodu (SKU)</label>
                                <input asp-for="UrunKodu" class="urun-input" autocomplete="off" />
                                <span asp-validation-for="UrunKodu" class="urun-validation"></span>
                            </div>
                        </div>
                    </div>

                    <div class="urun-field">
                        <label asp-for="SeoUrl">SEO URL <span>*</span></label>
                        <input asp-for="SeoUrl" class="urun-input" id="urunSeo" autocomplete="off" />
                        <span class="urun-help">Arama motorları için temiz URL adresi.</span>
                        <span asp-validation-for="SeoUrl" class="urun-validation"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="urun-field">
                                <label asp-for="Fiyat">Satış Fiyatı (₺) <span>*</span></label>
                                <input asp-for="Fiyat" type="number" step="0.01" class="urun-input" id="urunFiyat" />
                                <span asp-validation-for="Fiyat" class="urun-validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="urun-field">
                                <label asp-for="StokMiktari">Stok Miktarı <span>*</span></label>
                                <input asp-for="StokMiktari" type="number" class="urun-input" id="urunStok" />
                                <span asp-validation-for="StokMiktari" class="urun-validation"></span>
                            </div>
                        </div>
                    </div>

                    <div class="urun-field">
                        <label asp-for="Etiket">Ürün Etiketi (Rozet)</label>
                        <input asp-for="Etiket" class="urun-input" id="urunEtiket" placeholder="Örn: Fırsat Ürünü, En Çok Satan" autocomplete="off" />
                        <span class="urun-help">Ön yüzde ürün kartının köşesinde görünecek rozet metni.</span>
                        <span asp-validation-for="Etiket" class="urun-validation"></span>
                    </div>

                    <div class="urun-field">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <label asp-for="Aciklama" style="margin-bottom: 0;">Ürün Açıklaması</label>
                            <button type="button" id="btnAiUret" class="ai-generate-btn">
                                <i class="bi bi-robot"></i> Yapay Zeka ile Açıklama Üret
                            </button>
                        </div>
                        <input type="hidden" asp-for="Aciklama" id="gizliAciklama" />
                        <div id="editor" class="editor-container"></div>
                        <span class="urun-help">Zengin biçimlendirme araçlarını kullanarak detaylı açıklama ekleyin.</span>
                    </div>

                    <div class="urun-field">
                        <div class="urun-switch">
                            <div class="urun-switch-text">
                                <strong>Ürünü aktif et</strong>
                                <span>Aktif ürünler mağazanızda gösterilir ve satın alınabilir.</span>
                            </div>
                            <input asp-for="AktifMi" type="checkbox" id="urunAktif" />
                        </div>
                    </div>

                    <div class="urun-field">
                        <label>Ürün Görseli</label>
                        <div class="urun-image-upload">
                            <div class="urun-image-preview" id="imagePreview" style="@(string.IsNullOrWhiteSpace(Model.GorselUrl) ? "display:none;" : "")">
                                <img id="previewImage" src="@Model.GorselUrl" alt="@Model.Ad" />
                                <button type="button" class="urun-image-remove" id="removeImage"><i class="bi bi-x-lg"></i></button>
                            </div>
                            <label class="urun-file-label" for="gorselDosyasi">
                                <i class="bi bi-cloud-arrow-up"></i>
                                <span>Yeni görsel seçmek için tıklayın<br><small>JPG, JPEG, PNG veya WEBP (Yeni görsel seçilmezse mevcut görsel korunur)</small></span>
                            </label>
                            <input type="file" name="gorselDosyasi" id="gorselDosyasi" class="urun-file-input" accept="image/jpeg,image/png,image/webp" />
                        </div>
                    </div>
                </div>

                <div class="urun-actions">
                    <a asp-action="Index" class="urun-cancel-btn">Vazgeç</a>
                    <button type="submit" class="urun-save-btn"><i class="bi bi-check2"></i> Değişiklikleri Kaydet</button>
                </div>
            </div>

            <div class="urun-preview">
                <div class="urun-preview-label">Canlı Önizleme</div>
                <div class="urun-preview-card">
                    <div class="urun-preview-status @(Model.AktifMi ? "active" : "passive")" id="previewStatus">
                        <i class="bi bi-circle-fill"></i>
                        <span id="previewStatusText">@(Model.AktifMi ? "Aktif" : "Pasif")</span>
                    </div>

                    <div class="urun-preview-top">
                        <div class="urun-preview-icon">
                            @if (!string.IsNullOrWhiteSpace(Model.GorselUrl))
                            {
                                <img id="cardPreviewImage" src="@Model.GorselUrl" alt="@Model.Ad" style="display:block;" />
                                <i class="bi bi-flower1" id="previewIcon" style="display:none;"></i>
                            }
                            else
                            {
                                <img id="cardPreviewImage" src="" alt="" style="display:none;" />
                                <i class="bi bi-flower1" id="previewIcon"></i>
                            }
                        </div>
                    </div>
                    <h3 class="urun-preview-name" id="previewName">@Model.Ad</h3>
                    <div class="urun-preview-price" id="previewPrice">₺@(Model.Fiyat.ToString("N2"))</div>
                    <div class="urun-preview-stock">Stok: <span id="previewStock">@Model.StokMiktari</span> adet</div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            function formatCategory(state) {
                if (!state.id) return state.text;
                var text = state.text;
                if (text.startsWith("- ")) {
                    var cleanText = text.substring(2);
                    return $('<span style="padding-left: 18px; font-weight: normal; color: #555;"><i class="bi bi-arrow-return-right me-1" style="font-size: 0.8rem; color:#aaa;"></i> ' + cleanText + '</span>');
                }
                return $('<strong style="color: #24213d; font-size: 0.92rem;">' + text + '</strong>');
            };

            $('#kategoriSelect').select2({
                placeholder: "-- Kategori Ara veya Seç --",
                allowClear: true,
                templateResult: formatCategory,
                templateSelection: function (state) {
                    if (!state.id) return state.text;
                    return state.text.replace("- ", "");
                },
                language: {
                    noResults: function () { return "Aradığınız kategori bulunamadı"; }
                }
            });

            var quill = new Quill('#editor', {
                theme: 'snow',
                placeholder: 'Ürünün detaylarını, bakım koşullarını ve boyutunu buraya yazın...'
            });

            const form = document.getElementById("urunForm");
            const gizliAciklama = document.getElementById("gizliAciklama");

            if (gizliAciklama && gizliAciklama.value) {
                quill.clipboard.dangerouslyPasteHTML(gizliAciklama.value);
            }

            form?.addEventListener("submit", function () {
                if (gizliAciklama) {
                    gizliAciklama.value = quill.root.innerHTML;
                }
            });

            const btnAiUret = document.getElementById("btnAiUret");
            const urunAdInput = document.getElementById("urunAd");
            const kategoriSelect = document.getElementById("kategoriSelect");

            btnAiUret?.addEventListener("click", async function () {
                const urunAdi = urunAdInput.value.trim();
                if (!urunAdi) {
                    alert("Lütfen önce bir Ürün Adı giriniz.");
                    urunAdInput.focus();
                    return;
                }

                const kategoriAdi = kategoriSelect.options[kategoriSelect.selectedIndex]?.text.replace("- ", "") || "";
                btnAiUret.disabled = true;
                btnAiUret.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Yapay zeka yazıyor...`;

                try {
                    const response = await fetch('/api/admin/urunler/ai-aciklama-uret', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ UrunAdi: urunAdi, KategoriAdi: kategoriAdi })
                    });

                    if (response.ok) {
                        const data = await response.json();
                        quill.root.innerHTML = data.aciklama;
                    } else {
                        alert("Yapay zeka açıklaması üretilirken bir hata oluştu.");
                    }
                } catch (err) {
                    console.error(err);
                    alert("Bağlantı hatası oluştu.");
                } finally {
                    btnAiUret.disabled = false;
                    btnAiUret.innerHTML = `<i class="bi bi-robot"></i> Yapay Zeka ile Açıklama Üret`;
                }
            });

            const name = document.getElementById("urunAd");
            const seo = document.getElementById("urunSeo");
            const price = document.getElementById("urunFiyat");
            const stock = document.getElementById("urunStok");
            const file = document.getElementById("gorselDosyasi");
            const imagePreview = document.getElementById("imagePreview");
            const previewImage = document.getElementById("previewImage");
            const cardPreviewImage = document.getElementById("cardPreviewImage");
            const previewIcon = document.getElementById("previewIcon");
            const removeImage = document.getElementById("removeImage");
            const previewName = document.getElementById("previewName");
            const previewPrice = document.getElementById("previewPrice");
            const previewStock = document.getElementById("previewStock");

            function updatePreview() {
                if (previewName) previewName.textContent = name?.value.trim() || "Ürün Adı";
                const val = parseFloat(price?.value) || 0;
                if (previewPrice) previewPrice.textContent = "₺" + val.toFixed(2);
                if (previewStock) previewStock.textContent = stock?.value.trim() || "0";
            }

            name?.addEventListener("input", updatePreview);
            price?.addEventListener("input", updatePreview);
            stock?.addEventListener("input", updatePreview);

            name?.addEventListener("blur", function () {
                if (seo && !seo.value.trim() && name.value.trim()) {
                    seo.value = name.value.trim().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/ı/g, "i").replace(/ğ/g, "g").replace(/ü/g, "u").replace(/ş/g, "s").replace(/ö/g, "o").replace(/ç/g, "c").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
                }
            });

            file?.addEventListener("change", function () {
                const selected = this.files[0];
                if (!selected) return;
                const reader = new FileReader();
                reader.onload = function (e) {
                    if (previewImage) previewImage.src = e.target.result;
                    if (imagePreview) {
                        imagePreview.style.display = "block";
                        imagePreview.classList.add("show");
                    }
                    if (cardPreviewImage) {
                        cardPreviewImage.src = e.target.result;
                        cardPreviewImage.style.display = "block";
                    }
                    if (previewIcon) previewIcon.style.display = "none";
                };
                reader.readAsDataURL(selected);
            });

            removeImage?.addEventListener("click", function () {
                if (file) file.value = "";
                if (previewImage) previewImage.src = "";
                if (imagePreview) {
                    imagePreview.style.display = "none";
                    imagePreview.classList.remove("show");
                }
                if (cardPreviewImage) {
                    cardPreviewImage.src = "";
                    cardPreviewImage.style.display = "none";
                }
                if (previewIcon) previewIcon.style.display = "block";
            });
        });
    </script>
}