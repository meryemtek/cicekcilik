@model ECommerce.Application.DTOs.Urun.UrunEkleDto
@{
    ViewData["Title"] = "Yeni Ürün Ekle";
}

<!-- Quill.js Zengin Metin Editörü CSS -->
<link href="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.snow.css" rel="stylesheet">
<!-- Select2 CSS (Arama ve Özelleştirilmiş Dropdown için) -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    .urun-form-page {
        max-width: 1180px;
        margin: 0 auto;
    }

    .urun-form-header {
        margin-bottom: 28px;
    }

    .urun-form-eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #9a1640;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .urun-form-title {
        font-size: 2rem;
        font-weight: 700;
        color: #24213d;
        margin: 0 0 6px;
        letter-spacing: -.5px;
    }

    .urun-form-subtitle {
        font-size: .92rem;
        color: #85818c;
        margin: 0;
    }

    .urun-form-layout {
        display: grid;
        grid-template-columns: minmax(0,1.25fr) minmax(300px,.75fr);
        gap: 22px;
        align-items: start;
    }

    .urun-form-card {
        background: #fff;
        border: 1px solid #eee9ed;
        border-radius: 20px;
        box-shadow: 0 8px 28px rgba(35,28,40,.055);
        padding: 28px;
        margin-bottom: 22px;
    }

    .urun-form-card-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 25px;
    }

    .urun-form-card-title-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .urun-form-card-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #fff2f5;
        color: #8b0028;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .urun-form-card-title h2 {
        font-size: 1rem;
        font-weight: 700;
        color: #24213d;
        margin: 0;
    }

    .urun-form-card-title p {
        font-size: .75rem;
        color: #99949d;
        margin: 3px 0 0;
    }

    .ai-generate-btn {
        background: linear-gradient(135deg, #8b0028, #ff1493);
        border: 0;
        border-radius: 11px;
        color: #fff;
        padding: 9px 15px;
        font-size: .78rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(139,0,40,.2);
        transition: all .2s ease;
    }

        .ai-generate-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 20px rgba(139,0,40,.3);
            color: #fff;
        }

    .urun-field {
        margin-bottom: 20px;
    }

        .urun-field label {
            display: block;
            color: #403b46;
            font-size: .8rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

            .urun-field label span {
                color: #b24a60;
            }

    .urun-input {
        width: 100%;
        height: 48px;
        border: 1px solid #e4dfe4;
        border-radius: 12px;
        background: #fff;
        padding: 0 15px;
        color: #24213d;
        font-size: .88rem;
        outline: 0;
        transition: all .2s ease;
    }

        .urun-input:focus {
            border-color: #c98ca0;
            box-shadow: 0 0 0 4px rgba(139,0,40,.06);
        }

    .select2-container {
        width: 100% !important;
    }

    .select2-container--default .select2-selection--single {
        height: 48px;
        border: 1px solid #e4dfe4;
        border-radius: 12px;
        background: #fff;
        display: flex;
        align-items: center;
        outline: 0;
        transition: all .2s ease;
    }

        .select2-container--default.select2-container--open .select2-selection--single,
        .select2-container--default .select2-selection--single:focus {
            border-color: #c98ca0;
            box-shadow: 0 0 0 4px rgba(139,0,40,.06);
        }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            color: #24213d;
            font-size: .88rem;
            padding-left: 15px;
            line-height: normal;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 46px;
            right: 10px;
        }

    .select2-container--default .select2-selection--multiple {
        min-height: 48px;
        border: 1px solid #e4dfe4;
        border-radius: 12px;
        background: #fff;
        padding: 5px 10px;
        outline: 0;
        transition: all .2s ease;
    }

        .select2-container--default.select2-container--focus .select2-selection--multiple,
        .select2-container--default.select2-container--open .select2-selection--multiple {
            border-color: #c98ca0;
            box-shadow: 0 0 0 4px rgba(139,0,40,.06);
        }

        .select2-container--default .select2-selection--multiple .select2-selection__rendered {
            margin: 0;
            padding: 0;
            line-height: normal;
        }

        .select2-container--default .select2-selection--multiple .select2-selection__choice {
            background-color: #fff2f5;
            border: 1px solid #f8c9d4;
            color: #8b0028;
            font-weight: 600;
            border-radius: 8px;
            padding: 4px 10px;
            font-size: .8rem;
            margin-top: 4px;
            margin-right: 6px;
        }

        .select2-container--default .select2-selection--multiple .select2-selection__choice__remove {
            color: #8b0028;
            margin-right: 6px;
            font-weight: bold;
        }

        .select2-container--default .select2-selection--multiple .select2-selection__choice__remove:hover {
            color: #a70b3b;
        }

    .select2-container--default .select2-search--inline .select2-search__field {
        margin-top: 6px;
        font-size: .88rem;
        font-family: inherit;
    }

    .select2-dropdown {
        border: 1px solid #c98ca0;
        border-radius: 12px;
        box-shadow: 0 10px 30px rgba(35,28,40,.08);
        overflow: hidden;
    }

    .select2-search--dropdown .select2-search__field {
        border: 1px solid #e4dfe4;
        border-radius: 8px;
        padding: 8px 12px;
        outline: none;
        font-family: inherit;
        font-size: .88rem;
    }

        .select2-search--dropdown .select2-search__field:focus {
            border-color: #c98ca0;
        }

    .select2-container--default .select2-results__option--highlighted.select2-results__option--selectable {
        background-color: #fff2f5;
        color: #8b0028;
    }

    .select2-results__option {
        font-size: .88rem;
        padding: 10px 15px;
    }

    .editor-container {
        height: 180px;
        border-radius: 0 0 12px 12px;
        background: #fff;
    }

    .ql-toolbar.ql-snow {
        border-radius: 12px 12px 0 0;
        border-color: #e4dfe4;
        background: #faf9fa;
    }

    .ql-container.ql-snow {
        border-radius: 0 0 12px 12px;
        border-color: #e4dfe4;
        font-size: .88rem;
        font-family: inherit;
    }

    .urun-help {
        display: block;
        color: #9d98a0;
        font-size: .7rem;
        margin-top: 7px;
    }

    .urun-validation {
        color: #b53d53;
        font-size: .72rem;
        margin-top: 6px;
        display: block;
    }

    .urun-image-upload {
        border: 1px dashed #d9cbd1;
        border-radius: 15px;
        background: #fcfafb;
        padding: 15px;
    }

    .multi-images-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
        gap: 12px;
        margin-top: 14px;
    }

    .multi-image-slot {
        position: relative;
        width: 100%;
        height: 110px;
        border-radius: 12px;
        overflow: hidden;
        border: 2px solid #eee7eb;
        background: #fdfbfc;
        transition: transform .15s ease, border-color .15s ease;
    }

    .multi-image-slot.is-cover {
        border-color: #8b0028;
        box-shadow: 0 4px 12px rgba(139,0,40,.15);
    }

    .multi-image-slot img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .cover-tag {
        position: absolute;
        bottom: 5px;
        left: 5px;
        background: #8b0028;
        color: #fff;
        font-size: 0.65rem;
        font-weight: 700;
        padding: 2px 6px;
        border-radius: 6px;
    }

    .slot-remove-btn {
        position: absolute;
        top: 5px;
        right: 5px;
        width: 22px;
        height: 22px;
        background: rgba(0,0,0,0.65);
        color: #fff;
        border: 0;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.7rem;
        cursor: pointer;
        transition: background .15s;
    }

    .slot-remove-btn:hover {
        background: #dc3545;
    }

    .urun-image-preview {
        position: relative;
        display: none;
        width: 100%;
        height: 190px;
        border-radius: 12px;
        overflow: hidden;
        background: #f7f3f5;
        margin-bottom: 12px;
    }

        .urun-image-preview.show {
            display: block;
        }

        .urun-image-preview img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .urun-image-remove {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 32px;
        height: 32px;
        border: 0;
        border-radius: 9px;
        background: rgba(255,255,255,.92);
        color: #9a1640;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(0,0,0,.12);
    }

    .urun-file-label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 72px;
        border-radius: 11px;
        background: #fff;
        color: #77717b;
        font-size: .78rem;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
        transition: all .2s ease;
    }

        .urun-file-label:hover {
            background: #fff4f7;
            color: #8b0028;
        }

        .urun-file-label i {
            font-size: 1.3rem;
            color: #9a1640;
        }

    .urun-file-input {
        display: none;
    }

    .urun-preview {
        position: sticky;
        top: 20px;
    }

    .urun-preview-label {
        font-size: .72rem;
        font-weight: 700;
        color: #908b95;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .urun-preview-card {
        background: #fff;
        border: 1px solid #eee9ed;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 12px 35px rgba(35,28,40,.08);
    }

    .urun-preview-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 20px;
    }

    .urun-preview-icon {
        width: 52px;
        height: 52px;
        border-radius: 15px;
        background: linear-gradient(145deg,#fff2f5,#fbe3e9);
        color: #8b0028;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.55rem;
        overflow: hidden;
    }

        .urun-preview-icon img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: none;
        }

    .urun-preview-name {
        font-size: 1.15rem;
        font-weight: 700;
        color: #24213d;
        margin: 0 0 6px;
    }

    .urun-preview-price {
        font-size: 1.25rem;
        font-weight: 700;
        color: #8b0028;
        margin-bottom: 4px;
    }

    .urun-preview-stock {
        font-size: .78rem;
        color: #99949d;
    }

    .urun-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 22px;
    }

    .urun-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 46px;
        padding: 0 18px;
        border: 1px solid #e5e0e5;
        border-radius: 12px;
        background: #fff;
        color: #716c75;
        text-decoration: none;
        font-size: .82rem;
        font-weight: 600;
    }

        .urun-cancel-btn:hover {
            background: #f8f6f8;
            color: #403b46;
        }

    .urun-save-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 46px;
        padding: 0 20px;
        border: 0;
        border-radius: 12px;
        background: linear-gradient(135deg,#8b0028,#a70b3b);
        color: #fff;
        font-size: .82rem;
        font-weight: 600;
        box-shadow: 0 7px 20px rgba(139,0,40,.2);
    }

        .urun-save-btn:hover {
            color: #fff;
            transform: translateY(-1px);
        }
</style>

<div class="urun-form-page">
    <div class="urun-form-header">
        <div class="urun-form-eyebrow"><i class="bi bi-flower1"></i> Mağaza Yönetimi</div>
        <h1 class="urun-form-title">Yeni Ürün Ekle</h1>
        <p class="urun-form-subtitle">Yapay zeka asistanı ve zengin içerik desteğiyle profesyonel bir ürün oluşturun.</p>
    </div>

    <form asp-action="Ekle" method="post" enctype="multipart/form-data" id="urunForm">
        @Html.AntiForgeryToken()
        <div class="urun-form-layout">
            <div>
                <div class="urun-form-card">
                    <div class="urun-form-card-title">
                        <div class="urun-form-card-title-left">
                            <div class="urun-form-card-icon"><i class="bi bi-box-seam"></i></div>
                            <div><h2>Temel Ürün Bilgileri</h2><p>Ürün adı, SKU kodu ve fiyat bilgilerini girin.</p></div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="urun-field">
                                <label asp-for="KategoriId">Ana Kategori (Zorunlu) <span>*</span></label>
                                <select asp-for="KategoriId" id="anaKategoriSelect" style="width: 100%;" required>
                                    <option value="">-- Ana Kategori Seçin --</option>
                                    @if (ViewBag.AnaKategoriler != null)
                                    {
                                        foreach (var ana in (IEnumerable<SelectListItem>)ViewBag.AnaKategoriler)
                                        {
                                            <option value="@ana.Value">@ana.Text</option>
                                        }
                                    }
                                </select>
                                <span class="urun-help">Header menüsündeki ana kategorilerden birini seçin.</span>
                                <span asp-validation-for="KategoriId" class="urun-validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="urun-field">
                                <label for="altKategoriSelect">Alt Menüler / Kategoriler (Çoklu Seçilebilir)</label>
                                <select name="AltKategoriIdleri" id="altKategoriSelect" multiple="multiple" style="width: 100%;">
                                </select>
                                <span class="urun-help" id="altKategoriHelp">Ürünün ait olacağı alt kategorileri seçin (isteğe bağlı).</span>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="urun-field">
                                <label asp-for="Ad">Ürün Adı <span>*</span></label>
                                <input asp-for="Ad" class="urun-input" id="urunAd" placeholder="Örn. Premium Gül Buketi" autocomplete="off" />
                                <span asp-validation-for="Ad" class="urun-validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="urun-field">
                                <label asp-for="UrunKodu">Ürün Kodu (SKU)</label>
                                <input asp-for="UrunKodu" class="urun-input" placeholder="Örn. GL-001" autocomplete="off" />
                                <span asp-validation-for="UrunKodu" class="urun-validation"></span>
                            </div>
                        </div>
                    </div>

                    <div class="urun-field">
                        <label asp-for="SeoUrl">SEO URL <span>*</span></label>
                        <input asp-for="SeoUrl" class="urun-input" id="urunSeo" placeholder="premium-gul-buketi" autocomplete="off" />
                        <span class="urun-help">Arama motorları için temiz URL adresi.</span>
                        <span asp-validation-for="SeoUrl" class="urun-validation"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="urun-field">
                                <label asp-for="Fiyat">Satış Fiyatı (₺) <span>*</span></label>
                                <input asp-for="Fiyat" type="number" step="0.01" class="urun-input" id="urunFiyat" placeholder="0.00" />
                                <span asp-validation-for="Fiyat" class="urun-validation"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="urun-field">
                                <label asp-for="StokMiktari">Stok Miktarı <span>*</span></label>
                                <input asp-for="StokMiktari" type="number" class="urun-input" id="urunStok" placeholder="10" />
                                <span asp-validation-for="StokMiktari" class="urun-validation"></span>
                            </div>
                        </div>
                    </div>

                    <div class="urun-field">
                        <label asp-for="Etiket">Ürün Etiketi (Rozet)</label>
                        <input asp-for="Etiket" class="urun-input" id="urunEtiket" placeholder="Örn: Fırsat Ürünü, En Çok Satan" autocomplete="off" />
                        <span class="urun-help">Ön yüzde ürün kartının köşesinde görünecek rozet metni.</span>
                        <span asp-validation-for="Etiket" class="urun-validation"></span>
                    </div>

                    <div class="urun-field">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <label asp-for="Aciklama" style="margin-bottom: 0;">Ürün Açıklaması</label>
                            <button type="button" id="btnAiUret" class="ai-generate-btn">
                                <i class="bi bi-robot"></i> Yapay Zeka ile Açıklama Üret
                            </button>
                        </div>
                        <input type="hidden" asp-for="Aciklama" id="gizliAciklama" />
                        <div id="editor" class="editor-container"></div>
                        <span class="urun-help">Zengin biçimlendirme araçlarını kullanarak detaylı açıklama ekleyin.</span>
                    </div>

                    <div class="urun-field">
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <label class="m-0">Ürün Fotoğrafları <span>* (En az 1, en fazla 5 fotoğraf)</span></label>
                            <span id="gorselSayacBadge" class="badge bg-light text-muted border" style="font-size:0.75rem;">0 / 5 Seçildi</span>
                        </div>
                        <div class="urun-image-upload">
                            <label class="urun-file-label" for="gorselDosyalari" id="uploadDropZone">
                                <i class="bi bi-images" style="font-size: 1.8rem; color:#8b0028;"></i>
                                <span class="fw-semibold">Fotoğrafları seçmek için tıklayın<br><small>En az 1, en fazla 5 fotoğraf (JPG, PNG, WEBP)</small></span>
                            </label>
                            <input type="file" name="gorselDosyalari" id="gorselDosyalari" class="urun-file-input" accept="image/jpeg,image/png,image/webp" multiple />

                            <!-- Çoklu Önizleme Alanı -->
                            <div class="multi-images-grid" id="multiImagesGrid" style="display:none;"></div>
                        </div>
                        <span class="urun-help">İlk sıradaki fotoğraf ürünün ana vitrin kapağı olacaktır. En fazla 5 adet seçebilirsiniz.</span>
                    </div>
                </div>

                <div class="urun-actions">
                    <a asp-action="Index" class="urun-cancel-btn">Vazgeç</a>
                    <button type="submit" class="urun-save-btn"><i class="bi bi-check2"></i> Ürünü Kaydet</button>
                </div>
            </div>

            <div class="urun-preview">
                <div class="urun-preview-label">Canlı Önizleme</div>
                <div class="urun-preview-card">
                    <div class="urun-preview-top">
                        <div class="urun-preview-icon">
                            <i class="bi bi-flower1" id="previewIcon"></i>
                            <img id="cardPreviewImage" alt="" />
                        </div>
                    </div>
                    <h3 class="urun-preview-name" id="previewName">Ürün Adı</h3>
                    <div class="urun-preview-price" id="previewPrice">₺0.00</div>
                    <div class="urun-preview-stock">Stok: <span id="previewStock">0</span> adet</div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/quill@1.3.7/dist/quill.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            let tumKategoriler = @Html.Raw(ViewBag.TumKategorilerJson ?? "[]");

            function kategoriModeliniNormalizeEt(kategori) {
                const id = kategori.id ?? kategori.Id ?? "";
                const ustKategoriId = kategori.ustKategoriId ?? kategori.UstKategoriId ?? "";

                return {
                    id: String(id).trim(),
                    ad: String(kategori.ad ?? kategori.Ad ?? "").trim(),
                    ustKategoriId: String(ustKategoriId).trim() || null
                };
            }

            $('#anaKategoriSelect').select2({
                width: '100%',
                placeholder: "-- Ana Kategori Seçin --",
                allowClear: true,
                language: {
                    noResults: function () { return "Ana kategori bulunamadı"; }
                }
            });

            $('#altKategoriSelect').select2({
                width: '100%',
                placeholder: "Birden fazla alt kategori seçebilirsiniz...",
                allowClear: true,
                closeOnSelect: false,
                language: {
                    noResults: function () { return "Alt kategori bulunamadı"; }
                }
            });

            const kategoriYukleme = (async function () {
                if (!tumKategoriler || tumKategoriler.length === 0) {
                    try {
                        const res = await fetch('/admin/kategoriler-json');
                        if (res.ok) {
                            tumKategoriler = await res.json();
                        }
                    } catch (err) {
                        console.error("Kategoriler yüklenirken hata:", err);
                    }
                }

                tumKategoriler = Array.isArray(tumKategoriler)
                    ? tumKategoriler.map(kategoriModeliniNormalizeEt)
                    : [];

                // Ana kategori select'i doldur (eğer henüz boşsa)
                const $anaSelect = $('#anaKategoriSelect');
                if ($anaSelect.find('option').length <= 1 && tumKategoriler && tumKategoriler.length > 0) {
                    const anaList = tumKategoriler.filter(k => !k.ustKategoriId);
                    anaList.sort((a, b) => a.ad.localeCompare(b.ad, 'tr'));
                    anaList.forEach(function (ana) {
                        $anaSelect.append(new Option(ana.ad, ana.id, false, false));
                    });
                    $anaSelect.trigger('change.select2');
                }
            })();

            $('#anaKategoriSelect').on('change', async function () {
                await kategoriYukleme;

                const selectedAnaId = String($(this).val() ?? "").trim().toLowerCase();
                const $altSelect = $('#altKategoriSelect');
                $altSelect.empty();

                if (!selectedAnaId) {
                    $altSelect.trigger('change');
                    $('#altKategoriHelp').text("Ürünün ait olacağı alt kategorileri seçin (isteğe bağlı).").css('color', '#85818c');
                    return;
                }

                // ustKategoriId eşleşen alt kategoriler
                const altlar = tumKategoriler.filter(k =>
                    k.ustKategoriId && k.ustKategoriId.toLowerCase() === selectedAnaId);

                if (altlar.length > 0) {
                    altlar.forEach(function (alt) {
                        $altSelect.append(new Option(alt.ad, alt.id, false, false));
                    });
                    $('#altKategoriHelp').text(altlar.length + " adet alt kategori bulundu. İstediklerinizi seçebilirsiniz.").css('color', '#2d6a4f');
                } else {
                    $('#altKategoriHelp').html('Bu ana kategorinin altında henüz alt menü yok. <a href="/Admin/HeaderMenu" target="_blank" style="color:#8b0028; font-weight:600;"><i class="bi bi-plus-circle"></i> Yeni alt menü ekle</a>');
                }

                $altSelect.trigger('change');
            });

            var quill = new Quill('#editor', {
                theme: 'snow',
                placeholder: 'Ürünün detaylarını, bakım koşullarını ve boyutunu buraya yazın...'
            });

            const form = document.getElementById("urunForm");
            const gizliAciklama = document.getElementById("gizliAciklama");

            if (gizliAciklama && gizliAciklama.value) {
                quill.clipboard.dangerouslyPasteHTML(gizliAciklama.value);
            }

            form?.addEventListener("submit", function () {
                if (gizliAciklama) {
                    gizliAciklama.value = quill.root.innerHTML;
                }
            });

            const btnAiUret = document.getElementById("btnAiUret");
            const urunAdInput = document.getElementById("urunAd");
            const kategoriSelect = document.getElementById("kategoriSelect");

            btnAiUret?.addEventListener("click", async function () {
                const urunAdi = urunAdInput.value.trim();
                if (!urunAdi) {
                    alert("Lütfen önce bir Ürün Adı giriniz.");
                    urunAdInput.focus();
                    return;
                }

                const altText = $('#altKategoriSelect option:selected').text();
                const anaText = $('#anaKategoriSelect option:selected').text();
                const kategoriAdi = (altText && !altText.startsWith("--")) ? altText : (anaText && !anaText.startsWith("--") ? anaText : "");
                btnAiUret.disabled = true;
                btnAiUret.innerHTML = `<span class="spinner-border spinner-border-sm me-2"></span> Yapay zeka yazıyor...`;

                try {
                    const response = await fetch('/api/admin/urunler/ai-aciklama-uret', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ UrunAdi: urunAdi, KategoriAdi: kategoriAdi })
                    });

                    if (response.ok) {
                        const data = await response.json();
                        quill.root.innerHTML = data.aciklama;
                    } else {
                        alert("Yapay zeka açıklaması üretilirken bir hata oluştu.");
                    }
                } catch (err) {
                    console.error(err);
                    alert("Bağlantı hatası oluştu.");
                } finally {
                    btnAiUret.disabled = false;
                    btnAiUret.innerHTML = `<i class="bi bi-robot"></i> Yapay Zeka ile Açıklama Üret`;
                }
            });

            const name = document.getElementById("urunAd");
            const seo = document.getElementById("urunSeo");
            const price = document.getElementById("urunFiyat");
            const stock = document.getElementById("urunStok");
            const fileInput = document.getElementById("gorselDosyalari");
            const multiGrid = document.getElementById("multiImagesGrid");
            const sayacBadge = document.getElementById("gorselSayacBadge");
            const cardPreviewImage = document.getElementById("cardPreviewImage");
            const previewIcon = document.getElementById("previewIcon");
            const previewName = document.getElementById("previewName");
            const previewPrice = document.getElementById("previewPrice");
            const previewStock = document.getElementById("previewStock");

            function updatePreview() {
                if (previewName) previewName.textContent = name?.value.trim() || "Ürün Adı";
                const val = parseFloat(price?.value) || 0;
                if (previewPrice) previewPrice.textContent = "₺" + val.toFixed(2);
                if (previewStock) previewStock.textContent = stock?.value.trim() || "0";
            }

            name?.addEventListener("input", updatePreview);
            price?.addEventListener("input", updatePreview);
            stock?.addEventListener("input", updatePreview);

            name?.addEventListener("blur", function () {
                if (seo && !seo.value.trim() && name.value.trim()) {
                    seo.value = name.value.trim().toLowerCase()
                        .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
                        .replace(/ı/g, "i").replace(/ğ/g, "g").replace(/ü/g, "u")
                        .replace(/ş/g, "s").replace(/ö/g, "o").replace(/ç/g, "c")
                        .replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
                }
            });

            let dt = new DataTransfer();

            function renderGallery() {
                multiGrid.innerHTML = "";
                const files = dt.files;
                const count = files.length;

                sayacBadge.textContent = `${count} / 5 Seçildi`;
                if (count > 0) {
                    sayacBadge.className = "badge bg-success-subtle text-success border border-success-subtle";
                    multiGrid.style.display = "grid";
                } else {
                    sayacBadge.textContent = "0 / 5 Seçildi";
                    sayacBadge.className = "badge bg-light text-muted border";
                    multiGrid.style.display = "none";
                    if (cardPreviewImage) {
                        cardPreviewImage.src = "";
                        cardPreviewImage.style.display = "none";
                    }
                    if (previewIcon) previewIcon.style.display = "block";
                }

                Array.from(files).forEach((f, idx) => {
                    const slot = document.createElement("div");
                    slot.className = `multi-image-slot ${idx === 0 ? "is-cover" : ""}`;

                    const img = document.createElement("img");
                    img.src = URL.createObjectURL(f);
                    slot.appendChild(img);

                    if (idx === 0) {
                        const tag = document.createElement("span");
                        tag.className = "cover-tag";
                        tag.innerHTML = '<i class="bi bi-star-fill me-1"></i>Kapak';
                        slot.appendChild(tag);

                        // Canlı kart önizlemesini ilk fotoğrafla güncelle
                        if (cardPreviewImage) {
                            cardPreviewImage.src = img.src;
                            cardPreviewImage.style.display = "block";
                        }
                        if (previewIcon) previewIcon.style.display = "none";
                    }

                    const removeBtn = document.createElement("button");
                    removeBtn.type = "button";
                    removeBtn.className = "slot-remove-btn";
                    removeBtn.innerHTML = '<i class="bi bi-x"></i>';
                    removeBtn.title = "Kaldır";
                    removeBtn.addEventListener("click", function (e) {
                        e.stopPropagation();
                        e.preventDefault();
                        removeFile(idx);
                    });
                    slot.appendChild(removeBtn);

                    multiGrid.appendChild(slot);
                });
            }

            function removeFile(index) {
                const newDt = new DataTransfer();
                Array.from(dt.files).forEach((f, i) => {
                    if (i !== index) newDt.items.add(f);
                });
                dt = newDt;
                fileInput.files = dt.files;
                renderGallery();
            }

            fileInput?.addEventListener("change", function () {
                const incoming = Array.from(this.files);
                const currentCount = dt.files.length;
                const available = 5 - currentCount;

                if (available <= 0) {
                    alert("En fazla 5 adet fotoğraf yükleyebilirsiniz.");
                    this.files = dt.files;
                    return;
                }

                if (incoming.length > available) {
                    alert(`Sadece ${available} adet daha fotoğraf ekleyebilirsiniz. Fazla seçilenler atlandı.`);
                }

                const toAdd = incoming.slice(0, available);
                toAdd.forEach(f => {
                    // Aynı dosya adı ve boyuttaki kopyaları ekleme
                    const exists = Array.from(dt.files).some(ef => ef.name === f.name && ef.size === f.size);
                    if (!exists) {
                        dt.items.add(f);
                    }
                });

                fileInput.files = dt.files;
                renderGallery();
            });

            // Form Submit Kontrolü (En az 1 fotoğraf zorunlu)
            form?.addEventListener("submit", function (e) {
                if (dt.files.length === 0) {
                    e.preventDefault();
                    alert("Lütfen ürün için en az 1 adet fotoğraf seçin.");
                    fileInput.focus();
                    return false;
                }
                if (dt.files.length > 5) {
                    e.preventDefault();
                    alert("Bir ürün için en fazla 5 adet fotoğraf yükleyebilirsiniz.");
                    return false;
                }
            });
        });
    </script>
}
