@section Scripts {
    <script>
        $(document).ready(function () {
            $('.select2-multiple').select2({
                placeholder: "ÃœrÃ¼n seÃ§mek iÃ§in tÄ±klayÄ±n veya arayÄ±n...",
                allowClear: true
            });

            // BaÅŸlangÄ±Ã§ tarihini ÅŸu anki tarih/saate ayarla
            var now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            if (!$('#baslangicTarihInput').val()) {
                $('#baslangicTarihInput').val(now.toISOString().slice(0, 16));
            }

            function kontrolEt(val) {
                if (val === 'KategoriCapraz') {
                    $('#urunSecimAlani').hide();
                    $('#tetikleyiciKategoriAlani').show();
                    $('#hedefKapsamAlani').show();
                } else if (val === 'IkinciUrunIndirimli') {
                    $('#urunSecimAlani').show();
                    $('#anaUrunLabel').html('KampanyayÄ± Tetikleyecek 1. ÃœrÃ¼n(ler) <span class="text-danger">*</span>');
                    $('#urunSecimAciklama').html('<i class="bi bi-info-circle"></i> MÃ¼ÅŸterinin sepete eklemesi gereken <b>ana Ã¼rÃ¼nÃ¼</b> seÃ§in.');
                    $('#tetikleyiciKategoriAlani').hide();
                    $('#hedefKapsamAlani').show();
                } else {
                    $('#urunSecimAlani').show();
                    $('#anaUrunLabel').html('Kampanyaya Dahil ÃœrÃ¼n(ler) <span class="text-danger">*</span>');
                    $('#urunSecimAciklama').html('<i class="bi bi-info-circle"></i> DoÄŸrudan indirimin uygulanacaÄŸÄ± Ã¼rÃ¼n veya Ã¼rÃ¼nleri seÃ§in.');
                    $('#tetikleyiciKategoriAlani').hide();
                    $('#hedefKapsamAlani').hide();
                }
            }

            var initialVal = $('#varyasyonSelect').val();
            kontrolEt(initialVal);

            $('#varyasyonSelect').change(function () {
                kontrolEt($(this).val());
            });

            // CANLI Ä°NDÄ°RÄ°M HESAPLAYICI DÄ°NLEYÄ°CÄ°LERÄ°
            $('#indirimTipiSelect, #indirimDegeriInput').on('input change', guncelleOnizleme);
            guncelleOnizleme();
        });

        function guncelleOnizleme() {
            var tip = $('#indirimTipiSelect').val();
            var deger = parseFloat($('#indirimDegeriInput').val()) || 0;
            var ornekFiyat = 500;

            var indirimliFiyat = ornekFiyat;
            var indirimTutar = 0;

            if (tip === 'Yuzde') {
                indirimTutar = (ornekFiyat * deger) / 100;
                indirimliFiyat = Math.max(0, ornekFiyat - indirimTutar);
                $('#onizlemeRozet').text('%' + deger + ' Ä°ndirim');
                $('#onizlemeMetin').html('Ã–rnek <b>' + ornekFiyat + ' â‚º</b> tutarÄ±ndaki Ã¼rÃ¼n <b>' + indirimliFiyat.toFixed(2) + ' â‚º</b> fiyatÄ±na dÃ¼ÅŸecek (KazanÃ§: <b>' + indirimTutar.toFixed(2) + ' â‚º</b>).');
            } else {
                indirimTutar = deger;
                indirimliFiyat = Math.max(0, ornekFiyat - deger);
                $('#onizlemeRozet').text(deger + ' â‚º Net Ä°ndirim');
                $('#onizlemeMetin').html('Ã–rnek <b>' + ornekFiyat + ' â‚º</b> tutarÄ±ndaki sepetten net <b>' + deger + ' â‚º</b> dÃ¼ÅŸÃ¼lecek (Ã–denecek: <b>' + indirimliFiyat.toFixed(2) + ' â‚º</b>).');
            }
        }

        function sablonUygula(ad, varyasyon, tip, deger) {
            $('#kampanyaAdiInput').val(ad);
            $('#varyasyonSelect').val(varyasyon).trigger('change');
            $('#indirimTipiSelect').val(tip);
            $('#indirimDegeriInput').val(deger);
            guncelleOnizleme();
        }

        function tumUrunleriSec() {
            $('#urunIdsSelect option').prop('selected', true);
            $('#urunIdsSelect').trigger('change');
        }

        function secimiTemizle() {
            $('#urunIdsSelect option').prop('selected', false);
            $('#urunIdsSelect').trigger('change');
        }

        function bitisEkle(gun) {
            var d = new Date();
            d.setDate(d.getDate() + gun);
            d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
            $('#bitisTarihInput').val(d.toISOString().slice(0, 16));
        }
    </script>
}
