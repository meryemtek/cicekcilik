@model IEnumerable<ECommerce.Application.DTOs.Blog.BlogListeDto>
@{
    ViewData["Title"] = "Blog Yönetimi";
    var yazilar = Model?.ToList() ?? new List<ECommerce.Application.DTOs.Blog.BlogListeDto>();
}

<style>
    .blog-page {
        max-width: 1400px;
        margin: 0 auto;
    }

    .blog-hero {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 28px;
    }

    .blog-eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #9a1640;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .blog-title {
        font-size: 2rem;
        font-weight: 700;
        color: #24213d;
        margin: 0 0 6px;
        letter-spacing: -.5px;
    }

    .blog-subtitle {
        margin: 0;
        color: #85818c;
        font-size: .95rem;
    }

    .blog-add-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        background: linear-gradient(135deg,#8b0028,#a70b3b);
        border: 0;
        border-radius: 13px;
        color: #fff;
        padding: 13px 20px;
        font-size: .9rem;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 8px 22px rgba(139,0,40,.2);
        transition: all .2s ease;
    }

        .blog-add-btn:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(139,0,40,.28);
        }

    .blog-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 22px;
    }

    .blog-card {
        background: #fff;
        border: 1px solid #eee9ed;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 8px 28px rgba(35,28,40,.055);
        transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
        display: flex;
        flex-direction: column;
    }

        .blog-card:hover {
            transform: translateY(-4px);
            border-color: #e5d5db;
            box-shadow: 0 15px 35px rgba(35,28,40,.09);
        }

    .blog-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 15px;
    }

    .blog-icon {
        width: 50px;
        height: 50px;
        border-radius: 14px;
        background: linear-gradient(145deg,#fff2f5,#fbe3e9);
        color: #8b0028;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
    }

    /* Yeni Eklenen Kapak Görseli Stili */
    .blog-thumb {
        width: 100%;
        height: 140px;
        object-fit: cover;
        border-radius: 12px;
        margin-bottom: 15px;
        border: 1px solid #eee9ed;
    }

    .blog-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 8px;
        font-size: .75rem;
        font-weight: 700;
    }

    .status-active {
        background: #edf9f4;
        color: #287c5d;
    }

    .status-passive {
        background: #f2f0f3;
        color: #716c75;
    }

    .blog-title-text {
        font-size: 1.15rem;
        font-weight: 700;
        color: #24213d;
        margin: 0 0 6px;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .blog-seo {
        font-size: .8rem;
        color: #9a959e;
        margin-bottom: 12px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .blog-stats {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-top: auto;
        padding-bottom: 15px;
    }

    .blog-stat-item {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: .8rem;
        color: #716c75;
        font-weight: 600;
    }

        .blog-stat-item i {
            color: #c98ca0;
            font-size: .95rem;
        }

    .blog-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-top: 15px;
        border-top: 1px solid #f0edef;
    }

    .blog-actions-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .btn-edit {
        color: #8b0028;
        text-decoration: none;
        font-size: .85rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .btn-edit:hover {
            color: #65001f;
        }

    .btn-preview {
        color: #55515c;
        text-decoration: none;
        font-size: .85rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .btn-preview:hover {
            color: #24213d;
        }

    .btn-delete {
        width: 34px;
        height: 34px;
        border: 0;
        border-radius: 9px;
        background: #fff3f4;
        color: #b64a5d;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background .2s;
    }

        .btn-delete:hover {
            background: #fbe1e5;
            color: #9e253c;
        }

    .blog-empty {
        background: #fff;
        border: 1px dashed #d9cbd1;
        border-radius: 20px;
        padding: 60px 20px;
        text-align: center;
        grid-column: 1/-1;
    }

        .blog-empty > i {
            font-size: 2.5rem;
            color: #9a1640;
            margin-bottom: 15px;
            display: inline-block;
            padding: 20px;
            background: #fff2f5;
            border-radius: 20px;
        }

        .blog-empty h3 {
            font-size: 1.2rem;
            font-weight: 700;
            color: #24213d;
            margin-bottom: 8px;
        }

        .blog-empty p {
            color: #85818c;
            font-size: .9rem;
            margin-bottom: 20px;
        }

    .urun-alert {
        border: 0;
        border-radius: 13px;
        padding: 13px 16px;
        font-size: .84rem;
        margin-bottom: 18px;
    }

    .urun-alert-success {
        background: #edf9f4;
        color: #287c5d;
    }

    .urun-alert-danger {
        background: #fff0f2;
        color: #a4364b;
    }

    @@media(max-width:1100px) {
        .blog-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media(max-width:768px) {
        .blog-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .blog-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="blog-page">
    <div class="blog-hero">
        <div>
            <div class="blog-eyebrow"><i class="bi bi-newspaper"></i> İçerik Yönetimi</div>
            <h1 class="blog-title">Blog Yazıları</h1>
            <p class="blog-subtitle">Müşterilerinizi bilgilendirecek ve SEO skorunuzu artıracak içerikler üretin.</p>
        </div>
        <a asp-action="Ekle" class="blog-add-btn"><i class="bi bi-plus-lg"></i> Yeni Yazı Ekle</a>
    </div>

    @if (TempData["BasariliMesaj"] != null)
    {
        <div class="alert urun-alert urun-alert-success alert-dismissible fade show"><i class="bi bi-check-circle me-2"></i>@TempData["BasariliMesaj"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    @if (TempData["HataMesaji"] != null)
    {
        <div class="alert urun-alert urun-alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-circle me-2"></i>@TempData["HataMesaji"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="blog-grid">
        @if (yazilar.Any())
        {
            foreach (var item in yazilar)
            {
                <div class="blog-card">
                    <div class="blog-card-top">
                        <div class="blog-icon"><i class="bi bi-file-earmark-text"></i></div>
                        @if (item.AktifMi)
                        {
                            <span class="blog-status status-active"><i class="bi bi-check-circle-fill"></i> Yayında</span>
                        }
                        else
                        {
                            <span class="blog-status status-passive"><i class="bi bi-eye-slash-fill"></i> Taslak</span>
                        }
                    </div>

                    @* Kapak Görseli Varsa Kart İçinde Gösteriliyor *@
                    @if (!string.IsNullOrEmpty(item.GorselUrl))
                    {
                        <img src="@item.GorselUrl" alt="@item.Baslik" class="blog-thumb" />
                    }

                    <h3 class="blog-title-text" title="@item.Baslik">@item.Baslik</h3>
                    <div class="blog-seo">/blog/@item.SeoUrl</div>

                    <div class="blog-stats">
                        <div class="blog-stat-item" title="Yayınlanma Tarihi">
                            <i class="bi bi-calendar3"></i> @item.YayinlanmaTarihi.ToString("dd MMM yyyy, HH:mm")
                        </div>
                        <div class="blog-stat-item" title="Okunma Sayısı">
                            <i class="bi bi-eye"></i> @item.OkunmaSayisi Görüntülenme
                        </div>
                    </div>

                    <div class="blog-card-footer">
                        <div class="blog-actions-left">
                            <a asp-action="Detay" asp-route-id="@item.Id" class="btn-preview" title="Önizle"><i class="bi bi-search"></i> Önizle</a>
                            <a asp-action="Guncelle" asp-route-id="@item.Id" class="btn-edit" title="Düzenle"><i class="bi bi-pencil"></i> Düzenle</a>
                        </div>
                        <form asp-action="Sil" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu blog yazısını silmek istediğinize emin misiniz?');">
                            <button type="submit" class="btn-delete" title="Sil"><i class="bi bi-trash3"></i></button>
                        </form>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="blog-empty">
                <i class="bi bi-journal-richtext"></i>
                <h3>Henüz İçerik Bulunmuyor</h3>
                <p>Müşterilerinize çiçek bakımı, hediye önerileri gibi konularda bilgiler vererek sitenizi canlandırın.</p>
                <a asp-action="Ekle" class="blog-add-btn"><i class="bi bi-plus-lg"></i> İlk Yazıyı Oluştur</a>
            </div>
        }
    </div>
</div>