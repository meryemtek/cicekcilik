@model ECommerce.Application.DTOs.Blog.BlogGuncelleDto
@{
    ViewData["Title"] = "Blog Düzenle";
}

<style>
    .form-page {
        max-width: 1000px;
        margin: 0 auto;
    }

    .form-header {
        margin-bottom: 28px;
    }

    .form-eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #9a1640;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .form-title {
        font-size: 2rem;
        font-weight: 700;
        color: #24213d;
        margin: 0 0 6px;
        letter-spacing: -.5px;
    }

    .form-subtitle {
        font-size: .92rem;
        color: #85818c;
        margin: 0;
    }

    .form-card {
        background: #fff;
        border: 1px solid #eee9ed;
        border-radius: 20px;
        box-shadow: 0 8px 28px rgba(35,28,40,.055);
        padding: 32px;
        margin-bottom: 22px;
    }

    .form-card-title {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 25px;
        padding-bottom: 15px;
        border-bottom: 1px solid #f0edf0;
    }

    .form-card-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: #fff2f5;
        color: #8b0028;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }

    .form-card-title h2 {
        font-size: 1.1rem;
        font-weight: 700;
        color: #24213d;
        margin: 0;
    }

    .form-card-title p {
        font-size: .78rem;
        color: #99949d;
        margin: 3px 0 0;
    }

    .form-field {
        margin-bottom: 20px;
    }

        .form-field label {
            display: block;
            color: #403b46;
            font-size: .8rem;
            font-weight: 600;
            margin-bottom: 8px;
        }

    .form-input, .form-textarea {
        width: 100%;
        border: 1px solid #e4dfe4;
        border-radius: 12px;
        background: #fff;
        padding: 12px 15px;
        color: #24213d;
        font-size: .88rem;
        outline: 0;
        transition: all .2s ease;
    }

    .form-input {
        height: 48px;
    }

    .form-textarea {
        resize: vertical;
        min-height: 100px;
    }

        .form-input:focus, .form-textarea:focus {
            border-color: #c98ca0;
            box-shadow: 0 0 0 4px rgba(139,0,40,.06);
        }

    .form-validation {
        color: #b53d53;
        font-size: .72rem;
        margin-top: 6px;
        display: block;
    }

    .form-help {
        font-size: .75rem;
        color: #9d98a0;
        margin-top: 6px;
        display: block;
    }

    .form-switch {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border: 1px solid #eee9ed;
        background: #faf9fa;
        border-radius: 13px;
        padding: 15px 16px;
        margin-top: 10px;
    }

    .form-switch-text strong {
        display: block;
        font-size: .85rem;
        color: #3e3943;
        margin-bottom: 3px;
    }

    .form-switch-text span {
        font-size: .75rem;
        color: #99949d;
    }

    .form-switch input {
        width: 42px;
        height: 23px;
        cursor: pointer;
        accent-color: #8b0028;
    }

    .image-upload-box {
        border: 2px dashed #d9cbd1;
        border-radius: 15px;
        background: #fcfafb;
        padding: 25px;
        text-align: center;
        position: relative;
    }

    .image-preview-area {
        display: none;
        width: 100%;
        height: 250px;
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 15px;
        position: relative;
    }

        .image-preview-area.show {
            display: block;
        }

        .image-preview-area img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .remove-image-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 34px;
        height: 34px;
        border: 0;
        border-radius: 9px;
        background: rgba(255,255,255,.9);
        color: #9a1640;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(0,0,0,.15);
    }

    .file-label {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        color: #77717b;
        font-size: .85rem;
        font-weight: 600;
    }

        .file-label i {
            font-size: 2rem;
            color: #9a1640;
        }

    .file-input {
        display: none;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 22px;
    }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 46px;
        padding: 0 20px;
        border: 1px solid #e5e0e5;
        border-radius: 12px;
        background: #fff;
        color: #716c75;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
    }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 46px;
        padding: 0 24px;
        border: 0;
        border-radius: 12px;
        background: linear-gradient(135deg,#8b0028,#a70b3b);
        color: #fff;
        font-size: .85rem;
        font-weight: 600;
        box-shadow: 0 7px 20px rgba(139,0,40,.2);
        cursor: pointer;
    }

        .btn-submit:hover {
            transform: translateY(-1px);
        }
</style>

<div class="form-page">
    <div class="form-header">
        <div class="form-eyebrow"><i class="bi bi-newspaper"></i> İçerik Yönetimi</div>
        <h1 class="form-title">İçeriği Düzenle</h1>
        <p class="form-subtitle">Mevcut blog yazınızı güncelleyin.</p>
    </div>

    <form asp-action="Guncelle" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="GorselUrl" />

        <div class="form-card">
            <div class="form-card-title">
                <div class="form-card-icon"><i class="bi bi-pencil-square"></i></div>
                <div><h2>Temel Bilgiler</h2><p>Yazınızın başlığını, özetini ve kapak görselini belirleyin.</p></div>
            </div>

            <div class="form-field">
                <label asp-for="Baslik">Yazı Başlığı</label>
                <input asp-for="Baslik" class="form-input" autocomplete="off" />
                <span asp-validation-for="Baslik" class="form-validation"></span>
            </div>

            <div class="form-field">
                <label asp-for="SeoUrl">SEO Bağlantısı (URL)</label>
                <input asp-for="SeoUrl" class="form-input" autocomplete="off" />
                <span asp-validation-for="SeoUrl" class="form-validation"></span>
            </div>

            <div class="form-field">
                <label asp-for="Ozet">Kısa Özet (Listeleme Görünümü)</label>
                <textarea asp-for="Ozet" class="form-textarea" rows="3"></textarea>
                <span asp-validation-for="Ozet" class="form-validation"></span>
            </div>

            <div class="form-field">
                <label>Kapak Görseli</label>
                <div class="image-upload-box">
                    <div class="image-preview-area @(!string.IsNullOrEmpty(Model.GorselUrl) ? "show" : "")" id="imagePreview">
                        <img id="previewImg" src="@Model.GorselUrl" alt="Önizleme" />
                        <button type="button" class="remove-image-btn" id="removeImgBtn"><i class="bi bi-x-lg"></i></button>
                    </div>
                    <label class="file-label" for="gorselDosyasi" id="uploadLabel" style="display: @(!string.IsNullOrEmpty(Model.GorselUrl) ? "none" : "flex");">
                        <i class="bi bi-cloud-arrow-up"></i>
                        <span>Yeni kapak görseli yüklemek için tıklayın</span>
                    </label>
                    <input type="file" name="gorselDosyasi" id="gorselDosyasi" class="file-input" accept="image/*" />
                </div>
                <span class="form-help">Yeni bir görsel yüklemezseniz mevcut görsel korunacaktır.</span>
            </div>
        </div>

        <div class="form-card">
            <div class="form-card-title">
                <div class="form-card-icon"><i class="bi bi-text-paragraph"></i></div>
                <div><h2>Detaylı İçerik</h2><p>Zengin metin editörü ile yazılarınızı güncelleyin.</p></div>
            </div>

            <div class="form-field">
                <!-- DİKKAT: "rich-editor" class'ı eklendi -->
                <textarea asp-for="Icerik" class="form-textarea rich-editor" rows="12"></textarea>
                <span class="form-help">Buton eklemek için metin içine şu formatı yazabilirsiniz: <code class="text-danger">[ Buton Yazısı → /kategori-veya-link ]</code></span>
                <span asp-validation-for="Icerik" class="form-validation"></span>
            </div>

            <div class="form-field">
                <div class="form-switch">
                    <div class="form-switch-text">
                        <strong>Hemen Yayınla (Aktif)</strong>
                        <span>Kapatırsanız yazı taslak olarak kaydedilir, sitede görünmez.</span>
                    </div>
                    <input asp-for="AktifMi" type="checkbox" />
                </div>
            </div>
        </div>

        <div class="form-actions">
            <a asp-action="Index" class="btn-cancel">Vazgeç</a>
            <button type="submit" class="btn-submit"><i class="bi bi-check2"></i> Değişiklikleri Kaydet</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const fileInput = document.getElementById("gorselDosyasi");
            const imagePreview = document.getElementById("imagePreview");
            const previewImg = document.getElementById("previewImg");
            const uploadLabel = document.getElementById("uploadLabel");
            const removeImgBtn = document.getElementById("removeImgBtn");
            const gorselUrlInput = document.querySelector('input[name="GorselUrl"]');

            fileInput?.addEventListener("change", function () {
                const file = this.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        previewImg.src = e.target.result;
                        imagePreview.classList.add("show");
                        uploadLabel.style.display = "none";
                    }
                    reader.readAsDataURL(file);
                }
            });

            removeImgBtn?.addEventListener("click", function () {
                fileInput.value = "";
                previewImg.src = "";
                if (gorselUrlInput) gorselUrlInput.value = "";
                imagePreview.classList.remove("show");
                uploadLabel.style.display = "flex";
            });
        });
    </script>
}