@model ECommerce.Application.DTOs.Blog.BlogGuncelleDto
@{
    ViewData["Title"] = "Blog Önizleme";
}

<style>
    .s-page {
        max-width: 1000px;
        margin: 0 auto;
    }

    .s-hero {
        margin-bottom: 28px;
    }

    .s-eyebrow {
        color: #9a1640;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .preview-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #eee9ed;
        box-shadow: 0 8px 25px rgba(35,28,40,.04);
        overflow: hidden;
    }

    .preview-img {
        width: 100%;
        height: 400px;
        object-fit: cover;
    }

    .preview-body {
        padding: 50px;
    }

    .preview-title {
        font-size: 2.5rem;
        font-weight: 800;
        color: #24213d;
        margin-bottom: 15px;
        letter-spacing: -1px;
    }

    .preview-meta {
        display: flex;
        gap: 20px;
        color: #85818c;
        font-size: 0.9rem;
        margin-bottom: 30px;
        padding-bottom: 30px;
        border-bottom: 1px solid #eee9ed;
    }

    .preview-content {
        color: #444;
        font-size: 1.1rem;
        line-height: 1.8;
    }

        .preview-content img {
            max-width: 100%;
            border-radius: 8px;
            margin: 20px 0;
        }

    .seo-card {
        background: #faf9fa;
        border: 1px solid #ddd5da;
        border-radius: 12px;
        padding: 20px;
        margin-top: 40px;
    }

    .seo-card-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: #8b0028;
        text-transform: uppercase;
        margin-bottom: 15px;
    }

    .btn-edit {
        background: #24213d;
        color: #fff;
        text-decoration: none;
        padding: 10px 24px;
        border-radius: 8px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.2s;
    }

        .btn-edit:hover {
            background: #1a1829;
            color: #fff;
        }
</style>

<div class="s-page mt-4 pb-5">
    <div class="s-hero d-flex justify-content-between align-items-center">
        <div>
            <div class="s-eyebrow"><i class="bi bi-arrow-left"></i> <a asp-action="Index" style="color: inherit; text-decoration: none;">Listeye Dön</a></div>
        </div>
        <a asp-action="Guncelle" asp-route-id="@Model.Id" class="btn-edit"><i class="bi bi-pencil"></i> Düzenle</a>
    </div>

    <div class="preview-card">
        @if (!string.IsNullOrEmpty(Model.GorselUrl))
        {
            <img src="@Model.GorselUrl" class="preview-img" alt="Kapak Görseli" />
        }
        else
        {
            <div class="preview-img bg-light d-flex align-items-center justify-content-center text-muted">
                <i class="bi bi-image" style="font-size: 4rem;"></i>
            </div>
        }

        <div class="preview-body">
            <h1 class="preview-title">@Model.Baslik</h1>
            <div class="preview-meta">
                <span><i class="bi bi-calendar3"></i> @Model.YayinlanmaTarihi.ToString("dd MMMM yyyy, HH:mm")</span>
                <span>
                    <i class="bi bi-circle-fill" style="font-size: 0.5rem; color: @(Model.AktifMi ? "#198754" : "#dc3545"); vertical-align: middle; margin-right: 4px;"></i>
                    @(Model.AktifMi ? "Yayında" : "Taslak")
                </span>
            </div>

            <div class="preview-content">
                @Html.Raw(Model.Icerik)
            </div>

            <div class="seo-card">
                <div class="seo-card-title"><i class="bi bi-google"></i> Google SEO Önizlemesi</div>
                <div style="font-family: Arial, sans-serif;">
                    <div style="color: #1a0dab; font-size: 20px; cursor: pointer; text-decoration: none; margin-bottom: 2px;">@(string.IsNullOrEmpty(Model.MetaBaslik) ? Model.Baslik : Model.MetaBaslik)</div>
                    <div style="color: #006621; font-size: 14px; margin-bottom: 4px;">siteadiniz.com/blog/@Model.SeoUrl</div>
                    <div style="color: #545454; font-size: 14px; line-height: 1.57;">@(string.IsNullOrEmpty(Model.MetaAciklama) ? Model.Ozet : Model.MetaAciklama)</div>
                </div>
            </div>
        </div>
    </div>
</div>