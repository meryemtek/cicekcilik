@model ECommerce.Application.DTOs.Kategori.KategoriGuncelleDto
@{
    ViewData["Title"] = "Kategori Düzenle";
    var ustKategoriler = ViewBag.UstKategoriler as SelectList;
    bool hasImage = !string.IsNullOrWhiteSpace(Model.GorselUrl);
}

<!-- Cropper.js CSS -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />

<style>
    .kategori-form-page {
        max-width: 1180px;
        margin: 0 auto;
    }

    .kategori-form-header {
        margin-bottom: 28px;
    }

    .kategori-form-eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #2d6a4f;
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .kategori-form-title {
        font-size: 2rem;
        font-weight: 700;
        color: #1b4332;
        margin: 0 0 6px;
        letter-spacing: -.5px;
    }

    .kategori-form-subtitle {
        font-size: .92rem;
        color: #6c757d;
        margin: 0;
    }

    .kategori-form-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(300px, .75fr);
        gap: 22px;
        align-items: start;
    }

    .kategori-form-card {
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 20px;
        box-shadow: 0 4px 20px rgba(0,0,0,.04);
        padding: 28px;
    }

    .kategori-form-card-title {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 25px;
    }

    .kategori-form-card-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: #e8f5e9;
        color: #2d6a4f;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.15rem;
    }

    .kategori-form-card-title h2 {
        font-size: 1rem;
        font-weight: 700;
        color: #212529;
        margin: 0;
    }

    .kategori-form-card-title p {
        font-size: .75rem;
        color: #6c757d;
        margin: 3px 0 0;
    }

    .kategori-field {
        margin-bottom: 20px;
    }

    .kategori-field label {
        display: block;
        color: #495057;
        font-size: .8rem;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .kategori-field label span {
        color: #dc3545;
    }

    .kategori-input, .kategori-select {
        width: 100%;
        height: 48px;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        background: #fff;
        padding: 0 15px;
        color: #212529;
        font-size: .88rem;
        outline: 0;
        transition: all .2s ease;
    }

    .kategori-input:focus, .kategori-select:focus {
        border-color: #52b788;
        box-shadow: 0 0 0 4px rgba(82, 183, 136, 0.15);
    }

    .kategori-help {
        display: block;
        color: #868e96;
        font-size: .72rem;
        margin-top: 6px;
    }

    .kategori-validation {
        color: #dc3545;
        font-size: .72rem;
        margin-top: 6px;
        display: block;
    }

    .kategori-switch {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border: 1px solid #e9ecef;
        background: #f8f9fa;
        border-radius: 13px;
        padding: 15px 16px;
    }

    .kategori-switch-text strong {
        display: block;
        font-size: .82rem;
        color: #212529;
        margin-bottom: 3px;
    }

    .kategori-switch-text span {
        font-size: .7rem;
        color: #6c757d;
    }

    .kategori-switch input {
        width: 42px;
        height: 23px;
        cursor: pointer;
        accent-color: #2d6a4f;
    }

    /* Görsel Yükleme & Önizleme */
    .kategori-image-upload {
        border: 2px dashed #b7e4c7;
        border-radius: 15px;
        background: #f9fdfa;
        padding: 16px;
    }

    .kategori-image-preview {
        position: relative;
        display: none;
        width: 100%;
        height: 190px;
        border-radius: 14px;
        overflow: hidden;
        background: #e5f6eb;
        margin-bottom: 12px;
    }

    .kategori-image-preview.show {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .kategori-image-preview img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
    }

    .kategori-image-remove {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 32px;
        height: 32px;
        border: 0;
        border-radius: 9px;
        background: rgba(255, 255, 255, .95);
        color: #dc3545;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(0,0,0,.12);
    }

    .kategori-file-label {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 72px;
        border-radius: 12px;
        background: #fff;
        color: #495057;
        font-size: .8rem;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
        transition: all .2s ease;
        border: 1px solid #dee2e6;
    }

    .kategori-file-label:hover {
        background: #e8f5e9;
        color: #2d6a4f;
        border-color: #52b788;
    }

    .kategori-file-label i {
        font-size: 1.4rem;
        color: #2d6a4f;
    }

    .kategori-file-input {
        display: none;
    }

    .btn-recrop {
        margin-top: 8px;
        width: 100%;
        border: 1px solid #52b788;
        background: #fff;
        color: #2d6a4f;
        font-weight: 600;
        font-size: .8rem;
        padding: 8px;
        border-radius: 10px;
        cursor: pointer;
        transition: all .2s;
    }

    .btn-recrop:hover {
        background: #e8f5e9;
    }

    /* Modal Stacking Context & Z-Index Düzeltmesi */
    .modal {
        z-index: 10055 !important;
    }

    .modal-backdrop {
        z-index: 10050 !important;
    }

    .modal-dialog {
        z-index: 10056 !important;
    }

    /* Sağ Vitrin Canlı Önizleme Kartı */
    .kategori-preview {
        position: sticky;
        top: 20px;
    }

    .kategori-preview-label {
        font-size: .72rem;
        font-weight: 700;
        color: #6c757d;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        margin-bottom: 12px;
    }

    .kategori-preview-card {
        position: relative;
        overflow: hidden;
        background: #fff;
        border: 1px solid #e9ecef;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 8px 24px rgba(0,0,0,.04);
        text-align: center;
    }

    .vitrin-preview-box {
        width: 88px;
        height: 88px;
        background: #e5f6eb;
        border-radius: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        margin-bottom: 12px;
        border: 1px solid rgba(46, 125, 50, 0.12);
        box-shadow: 0 4px 12px rgba(46, 125, 50, 0.08);
    }

    .vitrin-preview-box img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .vitrin-preview-box i {
        font-size: 2.2rem;
        color: #2d6a4f;
    }

    .kategori-preview-name {
        font-size: .95rem;
        font-weight: 700;
        color: #1f2937;
        margin: 0 0 4px;
    }

    .kategori-preview-seo {
        font-size: .75rem;
        color: #6c757d;
        margin-bottom: 14px;
    }

    .kategori-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 22px;
    }

    .kategori-cancel-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 46px;
        padding: 0 20px;
        border: 1px solid #dee2e6;
        border-radius: 12px;
        background: #fff;
        color: #495057;
        text-decoration: none;
        font-size: .85rem;
        font-weight: 600;
    }

    .kategori-save-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        height: 46px;
        padding: 0 24px;
        border: 0;
        border-radius: 12px;
        background: linear-gradient(135deg, #2d6a4f, #1b4332);
        color: #fff;
        font-size: .85rem;
        font-weight: 600;
        box-shadow: 0 6px 18px rgba(45, 106, 79, 0.25);
    }

    .kategori-save-btn:hover {
        color: #fff;
        transform: translateY(-1px);
    }
</style>

<div class="kategori-form-page">
    <div class="kategori-form-header">
        <div class="kategori-form-eyebrow"><i class="bi bi-flower1"></i> Mağaza Yönetimi</div>
        <h1 class="kategori-form-title">Kategoriyi Düzenle</h1>
        <p class="kategori-form-subtitle">Kategori görselini kırparak yenileyin veya bilgileri güncelleyin.</p>
    </div>

    <form asp-action="Guncelle" method="post" enctype="multipart/form-data" id="kategoriForm">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="GorselUrl" type="hidden" id="hiddenGorselUrl" />

        <div class="kategori-form-layout">
            <div>
                <div class="kategori-form-card">
                    <div class="kategori-form-card-title">
                        <div class="kategori-form-card-icon"><i class="bi bi-pencil-square"></i></div>
                        <div><h2>Kategori Bilgileri</h2><p>Mevcut bilgileri gözden geçirin ve düzenleyin.</p></div>
                    </div>

                    <div class="kategori-field">
                        <label asp-for="UstKategoriId">Ana Kategori (Opsiyonel)</label>
                        <select asp-for="UstKategoriId" asp-items="ustKategoriler" class="kategori-select">
                            <option value="">-- Ana Kategori (En Üst Seviye) --</option>
                        </select>
                        <span class="kategori-help">Üst kategori seçilirse bu kategori header menüsünde alt başlık olur. Ana menü başlığı yapmak için boş bırakın. Görselli anasayfa alanı ayrı yönetilir.</span>
                    </div>

                    <div class="kategori-field">
                        <label asp-for="Ad">Kategori Adı <span>*</span></label>
                        <input asp-for="Ad" class="kategori-input" id="kategoriAd" autocomplete="off" />
                        <span asp-validation-for="Ad" class="kategori-validation"></span>
                    </div>

                    <div class="kategori-field">
                        <label asp-for="SeoUrl">SEO URL (Slug) <span>*</span></label>
                        <input asp-for="SeoUrl" class="kategori-input" id="kategoriSeo" autocomplete="off" />
                        <span class="kategori-help">Arama motorları ve web bağlantısı için kullanılır.</span>
                        <span asp-validation-for="SeoUrl" class="kategori-validation"></span>
                    </div>

                    <!-- GÖRSEL YÜKLEME VE KROPLAMA ALANI -->
                    <div class="kategori-field">
                        <label>Kategori Görseli (1:1 Kare Kırpma Destekli)</label>
                        <div class="kategori-image-upload">
                            <div class="kategori-image-preview @(hasImage ? "show" : "")" id="imagePreview">
                                <img id="previewImage" src="@Model.GorselUrl" alt="@Model.Ad" />
                                <button type="button" class="kategori-image-remove" id="removeImage" title="Görseli Kaldır"><i class="bi bi-x-lg"></i></button>
                            </div>

                            <label class="kategori-file-label" for="gorselDosyasi">
                                <i class="bi bi-crop"></i>
                                <span>@(hasImage ? "Yeni görsel seçin ve kırparak değiştirin" : "Görsel seçin ve kutucuğa göre kırpın")<br><small class="text-muted">JPG, PNG veya WEBP (Kare kırpıcı otomatik açılır)</small></span>
                            </label>
                            <input type="file" name="gorselDosyasi" id="gorselDosyasi" class="kategori-file-input" accept="image/jpeg,image/png,image/webp" />

                            <button type="button" class="btn-recrop" id="btnRecrop" style="@(hasImage ? "display:block;" : "display:none;")">
                                <i class="bi bi-crop me-1"></i> Yeni Görsel Seç ve Kırp
                            </button>

                            <div class="mt-3 pt-2 border-top">
                                <label asp-for="GorselUrl" class="small text-muted fw-bold mb-1 d-block"><i class="bi bi-link-45deg"></i> VEYA Doğrudan Görsel Web Linki (URL)</label>
                                <input asp-for="GorselUrl" class="kategori-input" id="gorselUrlInput" placeholder="https://images.unsplash.com/photo-..." autocomplete="off" />
                                <span class="kategori-help">Harici bir web görsel bağlantısı yapıştırarak da güncelleyebilirsiniz.</span>
                            </div>
                        </div>
                        <span class="kategori-help">Yeni bir görsel seçmediğiniz veya URL değiştirmediğiniz sürece mevcut görsel korunur.</span>
                    </div>

                    <div class="kategori-field">
                        <div class="kategori-switch">
                            <div class="kategori-switch-text">
                                <strong>Kategoriyi yayına al (Aktif)</strong>
                                <span>Aktif kategoriler mağaza vitrininde ve menülerde gösterilir. Pasife alırsanız arşivlenir.</span>
                            </div>
                            <input asp-for="AktifMi" type="checkbox" id="kategoriAktif" />
                        </div>
                    </div>
                </div>

                <div class="kategori-actions">
                    <a asp-action="Index" class="kategori-cancel-btn">Vazgeç</a>
                    <button type="submit" class="kategori-save-btn"><i class="bi bi-check2"></i> Değişiklikleri Kaydet</button>
                </div>
            </div>

            <!-- SAĞ TARAF: CANLI VİTRİN KUTUCUĞU ÖNİZLEMESİ -->
            <div class="kategori-preview">
                <div class="kategori-preview-label">Vitrin Canlı Önizlemesi</div>
                <div class="kategori-preview-card">
                    <span class="badge bg-light text-success border mb-3">Anasayfa Görünümü</span>
                    <div>
                        <div class="vitrin-preview-box">
                            <i class="bi bi-flower1" id="previewIcon" style="@(hasImage ? "display:none;" : "")"></i>
                            <img id="cardPreviewImage" src="@Model.GorselUrl" alt="Vitrin Önizleme" style="@(hasImage ? "display:block;" : "display:none;")" />
                        </div>
                    </div>
                    <div class="kategori-preview-name" id="previewName">@Model.Ad</div>
                    <div class="kategori-preview-seo" id="previewSeo">/@Model.SeoUrl</div>
                    <small class="text-muted d-block">Müşteriler anasayfada bu kutucuğu tıklayarak ürünlere ulaşır.</small>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- =========================================================
     CROPPER MODAL (KIRPMA PENCERESİ)
========================================================= -->
<div class="modal fade" id="cropModal" tabindex="-1" aria-labelledby="cropModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header border-bottom py-3">
                <h5 class="modal-title fw-bold" id="cropModalLabel">
                    <i class="bi bi-crop text-success me-2"></i>Kategori Görselini Kırp ve Hizala
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body p-4">
                <p class="text-muted small mb-3">
                    Kutucukta çiçeğin tam görünmesini istediğiniz alanını seçin, yakınlaştırın veya kaydırın.
                </p>
                <div class="row g-4 align-items-center">
                    <div class="col-md-8">
                        <div style="max-height: 400px; overflow: hidden; background: #f8f9fa; border-radius: 14px; border: 1px solid #e9ecef;">
                            <img id="cropperImage" style="max-width: 100%; display: block;" />
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <span class="text-muted small fw-bold d-block mb-2">VİTRİN ÖNİZLEMESİ</span>
                        <div class="d-inline-flex align-items-center justify-content-center p-2 rounded-4" style="width: 110px; height: 110px; background: #e5f6eb; border: 1px solid rgba(46, 125, 50, 0.15);">
                            <div id="cropPreviewContainer" style="width: 90px; height: 90px; border-radius: 20px; overflow: hidden;">
                            </div>
                        </div>
                        <div class="mt-3 d-flex justify-content-center gap-2">
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnZoomIn" title="Yakınlaştır"><i class="bi bi-zoom-in"></i></button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnZoomOut" title="Uzaklaştır"><i class="bi bi-zoom-out"></i></button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" id="btnRotate" title="Döndür"><i class="bi bi-arrow-clockwise"></i></button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-top py-3">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">İptal</button>
                <button type="button" class="btn btn-success rounded-pill px-4 fw-bold" id="btnApplyCrop" style="background:#2d6a4f; border-color:#2d6a4f;">
                    <i class="bi bi-check2 me-1"></i> Kırp ve Uygula
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const name = document.getElementById("kategoriAd");
            const seo = document.getElementById("kategoriSeo");
            const fileInput = document.getElementById("gorselDosyasi");
            const hiddenGorselUrl = document.getElementById("hiddenGorselUrl");
            const imagePreview = document.getElementById("imagePreview");
            const previewImage = document.getElementById("previewImage");
            const cardPreviewImage = document.getElementById("cardPreviewImage");
            const previewIcon = document.getElementById("previewIcon");
            const removeImage = document.getElementById("removeImage");
            const btnRecrop = document.getElementById("btnRecrop");
            const previewName = document.getElementById("previewName");
            const previewSeo = document.getElementById("previewSeo");

            // Cropper Değişkenleri
            let cropper = null;
            let rawImageSource = null;
            const cropModalEl = document.getElementById('cropModal');

            // #content-wrapper z-index:1 stacking context sorununu çözmek için modalı doğrudan body'ye taşıyoruz
            if (cropModalEl && cropModalEl.parentElement !== document.body) {
                document.body.appendChild(cropModalEl);
            }

            const cropModal = new bootstrap.Modal(cropModalEl);
            const cropperImage = document.getElementById('cropperImage');

            function updatePreview() {
                previewName.textContent = name.value.trim() || "Kategori Adı";
                previewSeo.textContent = "/" + (seo.value.trim() || "kategori-url");
            }

            name?.addEventListener("input", updatePreview);
            seo?.addEventListener("input", updatePreview);

            // Dosya Seçildiğinde Cropper Modalını Aç
            fileInput?.addEventListener("change", function () {
                const selected = this.files[0];
                if (!selected) return;

                const reader = new FileReader();
                reader.onload = function (e) {
                    rawImageSource = e.target.result;
                    cropperImage.src = rawImageSource;
                    cropModal.show();
                };
                reader.readAsDataURL(selected);
            });

            // Modal Açılınca Cropper'ı Başlat
            cropModalEl?.addEventListener('shown.bs.modal', function () {
                if (cropper) cropper.destroy();
                cropper = new Cropper(cropperImage, {
                    aspectRatio: 1, // 1:1 Kare
                    viewMode: 1,
                    dragMode: 'move',
                    autoCropArea: 0.9,
                    preview: '#cropPreviewContainer',
                    responsive: true,
                    background: false
                });
            });

            cropModalEl?.addEventListener('hidden.bs.modal', function () {
                if (cropper) {
                    cropper.destroy();
                    cropper = null;
                }
            });

            document.getElementById('btnZoomIn')?.addEventListener('click', () => cropper && cropper.zoom(0.1));
            document.getElementById('btnZoomOut')?.addEventListener('click', () => cropper && cropper.zoom(-0.1));
            document.getElementById('btnRotate')?.addEventListener('click', () => cropper && cropper.rotate(90));

            // Kırp ve Uygula Butonu
            document.getElementById('btnApplyCrop')?.addEventListener('click', function () {
                if (!cropper) return;

                const canvas = cropper.getCroppedCanvas({
                    width: 500,
                    height: 500,
                    imageSmoothingEnabled: true,
                    imageSmoothingQuality: 'high'
                });

                canvas.toBlob(function (blob) {
                    const croppedFile = new File([blob], "kategori_crop.webp", { type: "image/webp" });
                    const dt = new DataTransfer();
                    dt.items.add(croppedFile);
                    fileInput.files = dt.files;

                    const dataUrl = canvas.toDataURL('image/webp');
                    previewImage.src = dataUrl;
                    cardPreviewImage.src = dataUrl;
                    imagePreview.classList.add("show");
                    previewIcon.style.display = "none";
                    cardPreviewImage.style.display = "block";
                    btnRecrop.style.display = "block";

                    cropModal.hide();
                }, 'image/webp', 0.92);
            });

            // Yeni Görsel Seç ve Kırp Butonu
            btnRecrop?.addEventListener('click', function () {
                fileInput.click();
            });

            // Görseli Kaldır
            removeImage?.addEventListener("click", function () {
                fileInput.value = "";
                rawImageSource = null;
                hiddenGorselUrl.value = ""; // Form post edildiğinde boş gidecek
                previewImage.src = "";
                cardPreviewImage.src = "";
                imagePreview.classList.remove("show");
                previewIcon.style.display = "block";
                cardPreviewImage.style.display = "none";
                btnRecrop.style.display = "none";
                const urlInput = document.getElementById("gorselUrlInput");
                if (urlInput) urlInput.value = "";
            });

            const gorselUrlInput = document.getElementById("gorselUrlInput");
            gorselUrlInput?.addEventListener("input", function () {
                const url = this.value.trim();
                if (url) {
                    cardPreviewImage.src = url;
                    cardPreviewImage.style.display = "block";
                    previewIcon.style.display = "none";
                    hiddenGorselUrl.value = url;
                } else if (!fileInput.files.length) {
                    cardPreviewImage.src = "";
                    cardPreviewImage.style.display = "none";
                    previewIcon.style.display = "block";
                    hiddenGorselUrl.value = "";
                }
            });
        });
    </script>
}
