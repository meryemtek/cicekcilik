@using ECommerce.Application.DTOs.Urun
@model ECommerce.Application.DTOs.Kategori.KategoriGuncelleDto
@{
    ViewData["Title"] = "Kategori Detayları";
    var urunler = ViewBag.KategoriUrunleri as List<UrunListeDto> ?? new List<UrunListeDto>();
}

<style>
    .kategori-detay-page {
        max-width: 1400px;
        margin: 0 auto;
    }

    .kategori-detay-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .btn-back-kategoriler {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #fff;
        border: 1px solid #e5e0e5;
        border-radius: 12px;
        color: #403b46;
        padding: 10px 18px;
        font-size: .85rem;
        font-weight: 600;
        text-decoration: none;
        transition: all .2s ease;
    }

        .btn-back-kategoriler:hover {
            background: #fcfafb;
            color: #24213d;
            border-color: #d9cbd1;
        }

    .kategori-banner {
        background: #fff;
        border: 1px solid #eee9ed;
        border-radius: 20px;
        box-shadow: 0 8px 28px rgba(35,28,40,.055);
        padding: 30px;
        display: flex;
        align-items: center;
        gap: 25px;
        margin-bottom: 35px;
        position: relative;
        overflow: hidden;
    }

    .kategori-banner-img {
        width: 120px;
        height: 120px;
        border-radius: 16px;
        background: #fbf9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #f0edf0;
        flex-shrink: 0;
        overflow: hidden;
    }

        .kategori-banner-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .kategori-banner-img i {
            font-size: 3rem;
            color: #d9cbd1;
        }

    .kategori-banner-info {
        flex: 1;
    }

    .kategori-banner-title {
        font-size: 2rem;
        font-weight: 700;
        color: #24213d;
        margin: 0 0 5px;
        letter-spacing: -.5px;
    }

    .kategori-banner-seo {
        color: #8b0028;
        font-size: .9rem;
        font-weight: 600;
        margin-bottom: 12px;
    }

        .kategori-banner-seo i {
            margin-right: 5px;
        }

    .kategori-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: .8rem;
        font-weight: 700;
    }

    .status-active {
        background: #edf9f4;
        color: #287c5d;
    }

    .status-passive {
        background: #f2f0f3;
        color: #716c75;
    }

    .kategori-section-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #24213d;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .kategori-section-title i {
            color: #9a1640;
        }

    /* Ürün Kartı Stilleri (Ürünler sayfasındakiyle tamamen aynı) */
    .urun-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
    }

    .urun-card {
        position: relative;
        overflow: hidden;
        background: #fff;
        border: 1px solid #eee9ed;
        border-radius: 19px;
        padding: 22px;
        box-shadow: 0 8px 28px rgba(35,28,40,.055);
        transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease;
    }

        .urun-card:hover {
            transform: translateY(-4px);
            border-color: #e5d5db;
            box-shadow: 0 15px 35px rgba(35,28,40,.09);
        }

    .urun-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        margin-bottom: 18px;
    }

    .urun-flower-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: linear-gradient(145deg,#fff2f5,#fbe3e9);
        color: #8b0028;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
    }

    .urun-card-name {
        font-size: 1.08rem;
        font-weight: 700;
        color: #24213d;
        margin: 0 0 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .urun-card-price {
        font-size: 1.15rem;
        font-weight: 700;
        color: #8b0028;
        margin-bottom: 4px;
    }

    .urun-card-stock {
        font-size: .78rem;
        color: #9a959e;
    }

    .urun-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        display: inline-block;
        margin-right: 5px;
    }

    .urun-card-status {
        font-size: .76rem;
        font-weight: 600;
        margin-top: 10px;
    }

    .urun-status-active {
        color: #288661;
    }

        .urun-status-active .urun-status-dot {
            background: #36a978;
            box-shadow: 0 0 0 4px rgba(54,169,120,.1);
        }

    .urun-status-passive {
        color: #8d8790;
    }

        .urun-status-passive .urun-status-dot {
            background: #aaa5ad;
        }

    .urun-empty {
        background: #fff;
        border: 1px dashed #ddd5da;
        border-radius: 20px;
        padding: 65px 25px;
        text-align: center;
        grid-column: 1/-1;
    }

    .urun-empty-icon {
        width: 70px;
        height: 70px;
        border-radius: 22px;
        background: #fff2f5;
        color: #9a1640;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        margin: 0 auto 18px;
    }

    .urun-empty h3 {
        font-size: 1.15rem;
        font-weight: 700;
        color: #24213d;
        margin-bottom: 7px;
    }

    .urun-empty p {
        color: #99949d;
        font-size: .85rem;
        margin-bottom: 20px;
    }

    @@media(max-width: 1200px) {
        .urun-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media(max-width: 992px) {
        .urun-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media(max-width: 768px) {
        .kategori-banner {
            flex-direction: column;
            text-align: center;
        }

        .urun-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="kategori-detay-page">
    <div class="kategori-detay-header">
        <a asp-action="Index" class="btn-back-kategoriler"><i class="bi bi-arrow-left"></i> Kategorilere Dön</a>
        <a asp-action="Guncelle" asp-route-id="@Model.Id" class="btn-back-kategoriler" style="background: #fff4f7; color: #8b0028; border-color: #fbe3e9;"><i class="bi bi-pencil"></i> Kategoriyi Düzenle</a>
    </div>

    <!-- Kategori Banner -->
    <div class="kategori-banner">
        <div class="kategori-banner-img">
            @if (!string.IsNullOrWhiteSpace(Model.GorselUrl))
            {
                <img src="@Model.GorselUrl" alt="@Model.Ad" />
            }
            else
            {
                <i class="bi bi-image"></i>
            }
        </div>
        <div class="kategori-banner-info">
            <h1 class="kategori-banner-title">@Model.Ad</h1>
            <div class="kategori-banner-seo"><i class="bi bi-link-45deg"></i> /kategori/@Model.SeoUrl</div>
            @if (Model.AktifMi)
            {
                <div class="kategori-status status-active"><i class="bi bi-check-circle-fill"></i> Kategori Yayında</div>
            }
            else
            {
                <div class="kategori-status status-passive"><i class="bi bi-eye-slash-fill"></i> Kategori Gizli</div>
            }
        </div>
    </div>

    <!-- Kategoriye Ait Ürünler Vitrini -->
    <div class="kategori-section-title"><i class="bi bi-box-seam"></i> Bu Kategoriye Ait Ürünler (@urunler.Count)</div>

    <div class="urun-grid">
        @if (urunler.Any())
        {
            foreach (var urun in urunler)
            {
                <div class="urun-card">
                    <div class="urun-card-top">
                        <div class="urun-flower-icon"><i class="bi bi-flower1"></i></div>
                        @if (urun.AktifMi)
                        {
                            <div class="urun-card-status urun-status-active"><span class="urun-status-dot"></span>Yayında</div>
                        }
                        else
                        {
                            <div class="urun-card-status urun-status-passive"><span class="urun-status-dot"></span>Gizli</div>
                        }
                    </div>
                    <h3 class="urun-card-name">@urun.Ad</h3>
                    <div class="urun-card-price">@urun.Fiyat.ToString("C2")</div>
                    <div class="urun-card-stock">Stok Miktarı: <strong>@urun.StokMiktari</strong> adet</div>
                    <div style="margin-top: 15px; padding-top: 15px; border-top: 1px solid #f0edef; font-size: .8rem; text-align: right;">
                        <a asp-controller="Urun" asp-action="Detay" asp-route-id="@urun.Id" style="color: #287c5d; text-decoration: none; font-weight: 600;"><i class="bi bi-eye"></i> Ürünü İncele</a>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="urun-empty">
                <div class="urun-empty-icon"><i class="bi bi-basket3"></i></div>
                <h3>Bu kategoride henüz ürün yok</h3>
                <p>Bu kategoriye ait herhangi bir ürün bulunamadı. Yeni bir ürün ekleyerek başlayabilirsiniz.</p>
                <a asp-controller="Urun" asp-action="Ekle" class="btn-back-kategoriler" style="background: linear-gradient(135deg,#8b0028,#a70b3b); color: #fff; border: 0;"><i class="bi bi-plus-lg"></i> Yeni Ürün Ekle</a>
            </div>
        }
    </div>
</div>