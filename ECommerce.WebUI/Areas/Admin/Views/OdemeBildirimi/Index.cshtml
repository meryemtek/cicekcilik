@model List<ECommerce.Application.DTOs.OdemeBildirimi.OdemeBildirimiListeDto>
@{
    ViewData["Title"] = "Ödeme Bildirimleri";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="card border-0 shadow-sm" style="border-radius: 16px;">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h4 class="fw-bold text-dark mb-1">Ödeme Bildirimleri</h4>
                <p class="text-muted small mb-0">Müşteriler tarafından gönderilen havale/EFT bildirimlerini buradan takip edebilirsiniz.</p>
            </div>
        </div>

        @if (TempData["BasariliMesaj"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius: 12px;">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["BasariliMesaj"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["HataMesaji"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 12px;">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["HataMesaji"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="table-responsive">
            <table id="bildirimTable" class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase fs-7">
                    <tr>
                        <th>Gönderen</th>
                        <th>Banka</th>
                        <th>Tutar</th>
                        <th>Tarih</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="fw-bold text-dark">@item.AdSoyad</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.BankaAdi</span>
                                </td>
                                <td>
                                    <span class="fw-bold text-success">@item.Tutar.ToString("N2") TL</span>
                                </td>
                                <td>
                                    <small class="text-muted">@item.OlusturulmaTarihi.ToString("dd.MM.yyyy HH:mm")</small>
                                </td>
                                <td>
                                    @if (item.OkunduMu)
                                    {
                                        <span class="badge bg-success bg-opacity-10 text-success px-2 py-1">İncelendi</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger bg-opacity-10 text-danger px-2 py-1">Yeni Bildirim</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a href="/Admin/OdemeBildirimi/Detay/@item.Id" class="btn btn-sm btn-light text-primary" title="İncele">
                                            <i class="bi bi-eye-fill"></i>
                                        </a>
                                        <form asp-action="Sil" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Bu bildirimi silmek istediğinize emin misiniz?');" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-light text-danger" title="Sil">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#bildirimTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json"
                },
                "order": [[3, "desc"]]
            });
        });
    </script>
}