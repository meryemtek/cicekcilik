@model ECommerce.Application.DTOs.AnasayfaKategori.AnasayfaKategoriGuncelleDto
@{
    ViewData["Title"] = "Anasayfa Kategorisi Güncelle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .t-page {
        max-width: 900px;
        margin: 0 auto;
    }

    .t-hero {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 28px;
    }

    .t-eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #9a1640;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .t-title {
        font-size: 2rem;
        font-weight: 700;
        color: #24213d;
        margin: 0 0 6px;
        letter-spacing: -.5px;
    }

    .t-subtitle {
        margin: 0;
        color: #85818c;
        font-size: .95rem;
    }

    .t-card {
        background: #fff;
        border-radius: 0;
        border: 1px solid #eee9ed;
        box-shadow: 0 8px 25px rgba(35,28,40,.04);
        padding: 30px;
    }

    .t-btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        background: linear-gradient(135deg,#8b0028,#a70b3b);
        border: 0;
        border-radius: 0;
        color: #fff;
        padding: 12px 24px;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        box-shadow: 0 8px 22px rgba(139,0,40,.2);
    }

        .t-btn-primary:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .t-btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        background: #fff;
        border: 1px solid #e5e0e5;
        color: #403b46;
        border-radius: 0;
        padding: 12px 24px;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
    }

        .t-btn-secondary:hover {
            background: #faf9fa;
            color: #24213d;
        }

    .form-label {
        font-weight: 600;
        color: #403b46;
        font-size: .9rem;
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        border-radius: 0;
        border: 1px solid #e5e0e5;
        padding: 11px 15px;
        font-size: .95rem;
    }

        .form-control:focus, .form-select:focus {
            border-color: #8b0028;
            box-shadow: 0 0 0 3px rgba(139,0,40,.1);
        }
</style>

<div class="t-page">
    <div class="t-hero">
        <div class="t-hero-content">
            <div class="t-eyebrow"><i class="bi bi-grid-3x3-gap"></i> Vitrin Yönetimi</div>
            <h1 class="t-title">Anasayfa Kategorisi Güncelle</h1>
            <p class="t-subtitle">Anasayfa kategori ayarlarını ve görüntülenme sırasını düzenleyin.</p>
        </div>
        <a asp-action="Index" class="t-btn-secondary"><i class="bi bi-arrow-left"></i> Listeye Dön</a>
    </div>

    <div class="t-card">
        <form asp-action="Guncelle" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Id" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="KategoriId" class="form-label">Kategori</label>
                <select asp-for="KategoriId" asp-items="ViewBag.Kategoriler" class="form-select">
                    <option value="">Kategori seçiniz</option>
                </select>
                <span asp-validation-for="KategoriId" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="SiraNo" class="form-label">Sıra No</label>
                <input asp-for="SiraNo" class="form-control" type="number" min="1" />
            </div>

            <div class="form-check mb-4 pt-2">
                <input asp-for="AktifMi" class="form-check-input rounded-0" style="width: 20px; height: 20px; cursor: pointer;" />
                <label asp-for="AktifMi" class="form-check-label fw-bold ms-2 mt-1" style="cursor: pointer;">
                    Anasayfada aktif olarak göster
                </label>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="t-btn-secondary">Vazgeç</a>
                <button type="submit" class="t-btn-primary">
                    <i class="bi bi-check-lg me-1"></i> Güncelle
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}