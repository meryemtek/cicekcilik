@model List<ECommerce.Application.DTOs.AnasayfaKategori.AnasayfaKategoriDto>
@{
    ViewData["Title"] = "Anasayfa Görselli Kategoriler";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<style>
    .t-page {
        max-width: 1400px;
        margin: 0 auto;
    }

    .t-hero {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 28px;
    }

    .t-eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #9a1640;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .t-title {
        font-size: 2rem;
        font-weight: 700;
        color: #24213d;
        margin: 0 0 6px;
        letter-spacing: -.5px;
    }

    .t-subtitle {
        margin: 0;
        color: #85818c;
        font-size: .95rem;
    }

    .t-table-card {
        background: #fff;
        border-radius: 0;
        border: 1px solid #eee9ed;
        box-shadow: 0 8px 25px rgba(35,28,40,.04);
        overflow: hidden;
        padding: 20px;
    }

    .t-table {
        width: 100%;
        margin: 0;
        border-collapse: collapse;
    }

        .t-table th {
            background: #fdf8f9;
            padding: 18px 20px;
            font-size: .85rem;
            font-weight: 600;
            color: #9a1640;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 1px solid #f0edef;
            text-align: left;
        }

        .t-table td {
            padding: 16px 20px;
            border-bottom: 1px solid #f0edef;
            color: #403b46;
            font-size: .95rem;
            vertical-align: middle;
        }

        .t-table tr:hover td {
            background: #faf9fa;
        }

    .t-btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        background: linear-gradient(135deg,#8b0028,#a70b3b);
        border: 0;
        border-radius: 0;
        color: #fff;
        padding: 12px 20px;
        font-size: .9rem;
        font-weight: 600;
        text-decoration: none;
        box-shadow: 0 8px 22px rgba(139,0,40,.2);
        transition: all .2s ease;
        cursor: pointer;
    }

        .t-btn-primary:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(139,0,40,.28);
        }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        border-radius: 0;
        font-size: .8rem;
        font-weight: 700;
    }

    .status-active {
        background: #edf9f4;
        color: #287c5d;
        border: 1px solid #d4f0e5;
    }

    .status-passive {
        background: #fff0f2;
        color: #a4364b;
        border: 1px solid #fce8ed;
    }

    .action-links {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
    }

    .t-btn-action {
        width: 36px;
        height: 36px;
        border-radius: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: all .2s ease;
        border: 0;
        cursor: pointer;
    }

    .btn-edit {
        background: #f4f5f7;
        color: #24213d;
    }

        .btn-edit:hover {
            background: #e5e7eb;
            color: #111827;
        }

    .btn-delete {
        background: #fff0f2;
        color: #a4364b;
    }

        .btn-delete:hover {
            background: #fce8ed;
            color: #8b0028;
        }

    .drag-handle {
        cursor: grab;
        color: #85818c;
        padding: 4px;
    }

        .drag-handle:active {
            cursor: grabbing;
        }
</style>

<div class="t-page">
    <div class="t-hero">
        <div class="t-hero-content">
            <div class="t-eyebrow"><i class="bi bi-grid-3x3-gap"></i> Vitrin Yönetimi</div>
            <h1 class="t-title">Anasayfa Görselli Kategoriler</h1>
            <p class="t-subtitle">İkinci görseldeki kategori bandını yönetin. Burada seçtiğiniz kategoriler ana kategori ağacıyla aynı ürün, bağlantı ve görsel bilgisini kullanır.</p>
        </div>
        <a asp-area="Admin"
           asp-controller="AnasayfaKategori"
           asp-action="Ekle"
           class="t-btn-primary">
            <i class="bi bi-plus-lg"></i> Kategori Ekle
        </a>
    </div>

    @Html.AntiForgeryToken()

    @if (TempData["BasariliMesaj"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert" style="border-radius:0; background: #edf9f4; color: #287c5d; border: 1px solid #d4f0e5;">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["BasariliMesaj"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["HataMesaji"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius:0;">
            <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["HataMesaji"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="t-table-card">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="t-table w-100">
                    <thead>
                        <tr>
                            <th style="width: 80px;">Sıra</th>
                            <th>Kategori</th>
                            <th>SEO URL</th>
                            <th>Durum</th>
                            <th style="text-align: right;">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody id="kategoriSiralamasi">
                        @foreach (var item in Model.OrderBy(x => x.SiraNo))
                        {
                            <tr data-id="@item.Id">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="drag-handle" title="Sürükleyip sıralayın">
                                            <i class="bi bi-grip-vertical fs-5"></i>
                                        </span>
                                        <span class="badge bg-light text-dark border rounded-0 px-2 py-1">
                                            @item.SiraNo
                                        </span>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(item.GorselUrl))
                                        {
                                            <img src="@item.GorselUrl"
                                                 alt="@item.KategoriAdi"
                                                 style="width: 50px; height: 50px; object-fit: cover; border-radius: 0;" />
                                        }
                                        else
                                        {
                                            <div class="bg-light d-flex align-items-center justify-content-center text-muted" style="width: 50px; height: 50px; border-radius: 0;">
                                                <i class="bi bi-image"></i>
                                            </div>
                                        }
                                        <strong>@item.KategoriAdi</strong>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted font-monospace small">@item.SeoUrl</span>
                                </td>
                                <td>
                                    @if (item.AktifMi)
                                    {
                                        <span class="status-badge status-active"><i class="bi bi-check-circle-fill"></i> Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-passive"><i class="bi bi-x-circle-fill"></i> Pasif</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-links">
                                        <a asp-action="Guncelle"
                                           asp-route-id="@item.Id"
                                           class="t-btn-action btn-edit"
                                           title="Düzenle">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <form asp-action="Sil"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              onsubmit="return confirm('Bu kategoriyi anasayfadan kaldırmak istediğinize emin misiniz?');"
                                              style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit"
                                                    class="t-btn-action btn-delete"
                                                    title="Sil">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3 border-top text-end bg-light mt-3" style="border-radius: 0;">
                <button type="button" id="siralaKaydetBtn" class="t-btn-primary">
                    <i class="bi bi-check-lg me-1"></i> Sıralamayı Kaydet
                </button>
            </div>
        }
        else
        {
            <div class="text-center py-5">fetch
                <i class="bi bi-grid-3x3 fs-1 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold text-dark mb-2">Henüz anasayfa kategorisi bulunmuyor.</h5>
                <p class="text-muted mb-4">Anasayfada göstermek istediğiniz kategorileri hemen ekleyin.</p>
                <a asp-action="Ekle" class="t-btn-primary">
                    <i class="bi bi-plus-lg me-1"></i> Kategori Ekle
                </a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const liste = document.getElementById("kategoriSiralamasi");
            const kaydetBtn = document.getElementById("siralaKaydetBtn");

            if (liste) {
                new Sortable(liste, {
                    animation: 150,
                    handle: ".drag-handle"
                });
            }

            if (kaydetBtn) {
                kaydetBtn.addEventListener("click", function () {
                    const idler = [];
                    document.querySelectorAll("#kategoriSiralamasi tr").forEach(row => {
                        const id = row.getAttribute("data-id");
                        if (id) idler.push(id);
                    });

                    const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                    const token = tokenElement ? tokenElement.value : '';

                    fetch('@Url.Action("Sirala", "AnasayfaKategori", new { area = "Admin" })', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(idler)
                    })
                        .then(async response => {
                            if (response.ok) {
                                window.location.reload();
                            } else {
                                alert("Sıralama güncellenirken bir hata oluştu.");
                            }
                        })
                        .catch(error => {
                            console.error('Hata:', error);
                            alert("Bağlantı hatası oluştu.");
                        });
                });
            }
        });
    </script>
}
