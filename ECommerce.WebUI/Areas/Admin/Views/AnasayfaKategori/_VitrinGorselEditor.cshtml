@{
    var previewUrl = ViewBag.GorselOnizlemeUrl as string;
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" />
<style>
    .vitrin-image-editor { padding: 18px; border: 1px solid #eee9ed; border-radius: 14px; background: #fffafb; }
    .vitrin-image-preview { width: 92px; height: 92px; border-radius: 22px; overflow: hidden; background: #edf5ef; border: 1px solid #e4eee6; }
    .vitrin-image-preview img { width: 100%; height: 100%; object-fit: cover; }
    .vitrin-crop-stage { max-height: min(58vh, 520px); overflow: hidden; background: #f7f3f3; border-radius: 12px; }
    .vitrin-crop-stage img { display: block; max-width: 100%; }
    @@media (max-width: 575px) { .vitrin-image-editor { padding: 14px; } .vitrin-crop-stage { max-height: 42vh; } }
</style>
<div class="vitrin-image-editor mb-4">
    <div class="d-flex flex-wrap align-items-center gap-3">
        <div class="vitrin-image-preview" id="vitrinImagePreview" data-fallback="@previewUrl">
            @if (!string.IsNullOrWhiteSpace(previewUrl))
            {
                <img src="@previewUrl" alt="Vitrin kategori görseli" />
            }
            else
            {
                <div class="w-100 h-100 d-flex align-items-center justify-content-center text-success"><i class="bi bi-flower1 fs-2"></i></div>
            }
        </div>
        <div class="flex-grow-1">
            <label class="form-label mb-1">Anasayfa kutucuğu görseli</label>
            <div class="small text-muted mb-2">İsteğe bağlı. Fotoğrafı seçip kutucukta görünmesini istediğiniz alanı kırpabilirsiniz.</div>
            <div class="d-flex flex-wrap gap-2">
                <label for="vitrinGorselDosyasi" class="btn btn-outline-secondary btn-sm mb-0"><i class="bi bi-image me-1"></i> Görsel seç ve kırp</label>
                <button type="button" class="btn btn-link btn-sm text-danger p-1" id="vitrinGorselKaldir">Kategori görselini kullan</button>
            </div>
            <input type="file" id="vitrinGorselDosyasi" name="gorselDosyasi" accept="image/*" class="visually-hidden" />
            <input type="hidden" id="GorselUrl" name="GorselUrl" value="@(ViewBag.VitrinGorselOverrideUrl as string)" />
        </div>
    </div>
</div>

<div class="modal fade" id="vitrinCropModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 rounded-4 shadow">
            <div class="modal-header"><h5 class="modal-title fw-bold"><i class="bi bi-crop me-2 text-danger"></i>Vitrin görselini ayarla</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button></div>
            <div class="modal-body">
                <p class="small text-muted">Fotoğrafı sürükleyerek konumlandırın, yakınlaştırın ve kare kutucukta görünecek alanı seçin.</p>
                <div class="row g-3 align-items-center">
                    <div class="col-md-8"><div class="vitrin-crop-stage"><img id="vitrinCropImage" alt="Kırpılacak görsel" /></div></div>
                    <div class="col-md-4 text-center"><div class="small text-muted fw-semibold mb-2">KUTUCUK ÖNİZLEMESİ</div><div id="vitrinCropPreview" class="mx-auto" style="width:110px;height:110px;border-radius:24px;overflow:hidden;background:#edf5ef"></div><div class="mt-3 d-flex justify-content-center gap-2"><button type="button" class="btn btn-outline-secondary btn-sm" id="vitrinZoomIn" aria-label="Yakınlaştır"><i class="bi bi-zoom-in"></i></button><button type="button" class="btn btn-outline-secondary btn-sm" id="vitrinZoomOut" aria-label="Uzaklaştır"><i class="bi bi-zoom-out"></i></button><button type="button" class="btn btn-outline-secondary btn-sm" id="vitrinRotate" aria-label="Döndür"><i class="bi bi-arrow-clockwise"></i></button></div></div>
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-light" data-bs-dismiss="modal">Vazgeç</button><button type="button" class="btn btn-danger" id="vitrinCropApply">Kırp ve kullan</button></div>
        </div>
    </div>
</div>
