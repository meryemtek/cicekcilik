@model ECommerce.Application.DTOs.Menu.MenuItemGuncelleDto
@{
    ViewData["Title"] = "Menü Öğesini Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var grupId = ViewBag.GrupId;
}

<style>
    .t-page {
        max-width: 800px;
        margin: 0 auto;
    }

    .t-hero {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 28px;
    }

    .t-eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #9a1640;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .t-title {
        font-size: 2rem;
        font-weight: 700;
        color: #24213d;
        margin: 0 0 6px;
        letter-spacing: -.5px;
    }

    .t-subtitle {
        margin: 0;
        color: #85818c;
        font-size: .95rem;
    }

    .t-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #eee9ed;
        box-shadow: 0 8px 25px rgba(35,28,40,.04);
        padding: 30px;
    }

    .t-btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        background: linear-gradient(135deg,#8b0028,#a70b3b);
        border: 0;
        border-radius: 12px;
        color: #fff;
        padding: 12px 24px;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        box-shadow: 0 8px 22px rgba(139,0,40,.2);
    }

    .t-btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        background: #fff;
        border: 1px solid #e5e0e5;
        color: #403b46;
        border-radius: 12px;
        padding: 12px 24px;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
    }

    .form-label {
        font-weight: 600;
        color: #403b46;
        font-size: .9rem;
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        border-radius: 10px;
        border: 1px solid #e5e0e5;
        padding: 11px 15px;
        font-size: .95rem;
    }

        .form-control:focus, .form-select:focus {
            border-color: #8b0028;
            box-shadow: 0 0 0 3px rgba(139,0,40,.1);
        }

    .icon-preset-btn {
        padding: 6px 12px;
        border-radius: 8px;
        background: #f8f6f8;
        border: 1px solid #e5dfec;
        font-size: 0.82rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 5px;
        transition: all 0.15s ease;
    }
    .icon-preset-btn:hover {
        background: #8b0028;
        color: #fff;
        border-color: #8b0028;
    }
</style>

<div class="t-page">
    <div class="t-hero">
        <div class="t-hero-content">
            <div class="t-eyebrow"><i class="bi bi-pencil-square"></i> Menü Öğesi</div>
            <h1 class="t-title">Öğeyi Düzenle</h1>
            <p class="t-subtitle">Menü başlığını, linkini, sırasını ve ikonunu güncelleyin.</p>
        </div>
        <a asp-action="Detay" asp-route-grupId="@Model.MenuGrupId" class="t-btn-secondary"><i class="bi bi-arrow-left"></i> Geri Dön</a>
    </div>

    <div class="t-card">
        <form asp-action="OgeGuncelle" method="post">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="MenuGrupId" />
            <input type="hidden" asp-for="ParentId" />

            <div class="row g-3">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Menü Başlığı</label>
                    <input type="text" asp-for="Baslik" class="form-control" required />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Gidilecek URL</label>
                    <input type="text" asp-for="Url" class="form-control" required />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">İkon Sınıfı</label>
                    <input type="text" asp-for="IconClass" id="iconClassInput" class="form-control" placeholder="Örn: bi-heart" />
                    <div class="d-flex flex-wrap gap-1 mt-2">
                        <span class="text-muted small me-1">Hızlı İkon:</span>
                        <button type="button" class="icon-preset-btn" onclick="setIcon('bi-flower2')"><i class="bi bi-flower2"></i> Çiçek</button>
                        <button type="button" class="icon-preset-btn" onclick="setIcon('bi-heart')"><i class="bi bi-heart"></i> Kalp</button>
                        <button type="button" class="icon-preset-btn" onclick="setIcon('bi-gift')"><i class="bi bi-gift"></i> Hediye</button>
                        <button type="button" class="icon-preset-btn" onclick="setIcon('bi-truck')"><i class="bi bi-truck"></i> Kargo</button>
                        <button type="button" class="icon-preset-btn" onclick="setIcon('bi-info-circle')"><i class="bi bi-info-circle"></i> Bilgi</button>
                        <button type="button" class="icon-preset-btn" onclick="setIcon('bi-telephone')"><i class="bi bi-telephone"></i> Telefon</button>
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Görüntüleme Sıra No</label>
                    <input type="number" asp-for="SiraNo" class="form-control" />
                </div>

                <div class="col-12 mt-2 mb-4">
                    <div class="form-check form-switch p-3 rounded-3" style="background: #faf9fa; border: 1px solid #eee9ed;">
                        <input class="form-check-input ms-0 mt-1" type="checkbox" asp-for="AktifMi" id="aktifSwitch" style="width: 45px; height: 22px; cursor: pointer;">
                        <label class="form-check-label fw-bold ms-5" for="aktifSwitch" style="position:relative; top:2px;">Menüde Aktif Olarak Göster</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Detay" asp-route-grupId="@Model.MenuGrupId" class="t-btn-secondary">İptal</a>
                <button type="submit" class="t-btn-primary">
                    <i class="bi bi-check-lg"></i> Değişiklikleri Kaydet
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function setIcon(icon) {
        document.getElementById('iconClassInput').value = icon;
    }
</script>
