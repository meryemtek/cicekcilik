@model List<ECommerce.Application.DTOs.Menu.MenuGrupListeDto>
@{
    ViewData["Title"] = "Footer Bölümleri";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var bolumler = Model?.Where(x => x.Konum.StartsWith("Footer", StringComparison.OrdinalIgnoreCase)).ToList() ?? new();
}

<style>
    .footer-admin { max-width: 1100px; margin: 0 auto; }
    .footer-admin-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 24px; }
    .footer-admin h1 { color: #24213d; font-size: 1.8rem; font-weight: 700; margin: 0 0 6px; }
    .footer-admin p { color: #77717c; margin: 0; }
    .footer-admin-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    .footer-admin-card { background: #fff; border: 1px solid #eee8ec; border-radius: 14px; padding: 22px; }
    .footer-admin-card h2 { font-size: 1.1rem; font-weight: 700; color: #24213d; margin: 0 0 8px; }
    .footer-admin-card .description { min-height: 48px; white-space: pre-line; }
    .footer-admin-card-footer { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f0ebef; padding-top: 14px; margin-top: 12px; }
    .footer-admin .btn-main { background: #990035; border: 0; color: #fff; border-radius: 10px; padding: 10px 16px; text-decoration: none; font-weight: 600; }
    .footer-admin .btn-edit { border: 1px solid #ead6dc; background: #fff8fa; color: #8b0028; border-radius: 9px; padding: 8px 13px; text-decoration: none; font-weight: 600; }
    @@media (max-width: 700px) { .footer-admin-list { grid-template-columns: 1fr; } .footer-admin-header { align-items: flex-start; flex-direction: column; } }
</style>

<div class="footer-admin">
    <div class="footer-admin-header">
        <div>
            <h1>Alt Bölümler</h1>
            <p>Her bölüm için sitede görünecek başlığı ve kısa açıklamayı yazın.</p>
        </div>
        <a asp-action="GrupEkle" class="btn-main"><i class="bi bi-plus-lg me-1"></i> Bölüm Ekle</a>
    </div>

    @if (TempData["BasariliMesaj"] != null)
    {
        <div class="alert alert-success">@TempData["BasariliMesaj"]</div>
    }
    @if (TempData["HataMesaji"] != null)
    {
        <div class="alert alert-danger">@TempData["HataMesaji"]</div>
    }

    <div class="footer-admin-list">
        @foreach (var bolum in bolumler)
        {
            <section class="footer-admin-card">
                <h2>@bolum.Baslik</h2>
                <p class="description">@(string.IsNullOrWhiteSpace(bolum.Aciklama) ? "Henüz açıklama eklenmedi." : bolum.Aciklama)</p>
                <div class="footer-admin-card-footer">
                    <span class="badge @(bolum.AktifMi ? "bg-success" : "bg-secondary")">@(bolum.AktifMi ? "Sitede görünüyor" : "Gizli")</span>
                    <a asp-action="GrupGuncelle" asp-route-id="@bolum.Id" class="btn-edit"><i class="bi bi-pencil me-1"></i>Düzenle</a>
                </div>
            </section>
        }
        @if (!bolumler.Any())
        {
            <div class="alert alert-light border">Henüz bölüm yok. “Bölüm Ekle” düğmesiyle başlayabilirsiniz.</div>
        }
    </div>
</div>
