@model ECommerce.Application.DTOs.Slider.SliderGuncelleDto
@inject System.Net.Http.IHttpClientFactory ApiFactory
@{
    ViewData["Title"] = "Slider Düzenle";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    var kategoriApiUrl = new System.Uri(ApiFactory.CreateClient("ApiClient").BaseAddress!, "kategoriler").AbsoluteUri;
}

<style>
    .t-page {
        max-width: 900px;
        margin: 0 auto;
    }

    .t-hero {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 28px;
    }

    .t-eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #9a1640;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .t-title {
        font-size: 2rem;
        font-weight: 700;
        color: #24213d;
        margin: 0 0 6px;
        letter-spacing: -.5px;
    }

    .t-subtitle {
        margin: 0;
        color: #85818c;
        font-size: .95rem;
    }

    .t-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #eee9ed;
        box-shadow: 0 8px 25px rgba(35,28,40,.04);
        padding: 30px;
    }

    .t-btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        background: linear-gradient(135deg,#8b0028,#a70b3b);
        border: 0;
        border-radius: 12px;
        color: #fff;
        padding: 12px 24px;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        box-shadow: 0 8px 22px rgba(139,0,40,.2);
    }

        .t-btn-primary:hover {
            color: #fff;
            transform: translateY(-1px);
        }

    .t-btn-secondary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        background: #fff;
        border: 1px solid #e5e0e5;
        color: #403b46;
        border-radius: 12px;
        padding: 12px 24px;
        font-size: 1rem;
        font-weight: 600;
        text-decoration: none;
    }

        .t-btn-secondary:hover {
            background: #faf9fa;
            color: #24213d;
        }

    .form-label {
        font-weight: 600;
        color: #403b46;
        font-size: .9rem;
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        border-radius: 10px;
        border: 1px solid #e5e0e5;
        padding: 11px 15px;
        font-size: .95rem;
    }

        .form-control:focus {
            border-color: #8b0028;
            box-shadow: 0 0 0 3px rgba(139,0,40,.1);
        }
</style>

<div class="t-page">
    <div class="t-hero">
        <div class="t-hero-content">
            <div class="t-eyebrow"><i class="bi bi-images"></i> Vitrin Yönetimi</div>
            <h1 class="t-title">Slider Düzenle</h1>
            <p class="t-subtitle">Seçili manşet görselini ve ayarlarını güncelleyin.</p>
        </div>
        <a asp-action="Index" class="t-btn-secondary"><i class="bi bi-arrow-left"></i> Listeye Dön</a>
    </div>

    <div class="t-card">
        <form asp-action="Guncelle" method="post" enctype="multipart/form-data">
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ResimUrl" /> <!-- Mevcut görsel yolunu saklamak için -->

            <div class="mb-3">
                <label class="form-label">Slider Başlığı</label>
                <input type="text" asp-for="Baslik" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Alt Metin</label>
                <textarea asp-for="AltMetin" class="form-control" rows="3"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Buton Metni</label>
                <input type="text" asp-for="ButonMetni" class="form-control" />
            </div>

            <div class="mb-3">
                <label class="form-label">Mevcut Görsel</label>
                @if (!string.IsNullOrEmpty(Model.ResimUrl))
                {
                    <div class="mb-2 p-2 border rounded bg-light" style="max-width: 250px;">
                        <img src="@Model.ResimUrl" class="img-fluid rounded shadow-sm" alt="Slider Görseli" />
                    </div>
                }
                <label class="form-label mt-2">Yeni Görsel Yükle (İsteğe Bağlı)</label>
                <input type="file" id="sliderImageFile" name="gorselDosyasi" class="form-control" accept="image/jpeg,image/png,image/webp" />
                <small class="text-muted">Yeni dosya seçmezseniz mevcut görsel korunur. JPG, PNG veya WEBP (en fazla 15 MB); seçince serbest kırpma penceresi açılır.</small>
                <div class="text-danger">@Html.ValidationMessage("gorselDosyasi")</div>
                <img id="sliderSelectedPreview" class="img-fluid rounded mt-2" style="max-height: 180px;" alt="Düzenlenen slider görseli" hidden />
            </div>

            <div class="mb-3">
                <label asp-for="LinkUrl" class="form-label">Yönlendirilecek Kategori</label>
                <select asp-for="LinkUrl" asp-items="ViewBag.KategoriLinkleri" class="form-select" data-kategori-api="@kategoriApiUrl" data-current-link="@Model.LinkUrl">
                    <option value="">Kategori seçin</option>
                </select>
                <small id="kategoriLoadStatus" class="text-danger d-block" role="status" aria-live="polite"></small>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label">Görüntüleme Sırası</label>
                    <input type="number" asp-for="SiraNo" class="form-control" />
                </div>
                <div class="col-md-6 d-flex align-items-center pt-4">
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="AktifMi" id="aktifSwitch" style="width: 45px; height: 22px; cursor: pointer;">
                        <label class="form-check-label fw-bold ms-2 mt-1" for="aktifSwitch">Slider Aktif mi?</label>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="t-btn-secondary">İptal</a>
                <button type="submit" class="t-btn-primary">
                    <i class="bi bi-save2"></i> Değişiklikleri Kaydet
                </button>
            </div>
        </form>
    </div>
</div>
<partial name="_GorselDuzenleyici" />

@section Scripts {
    <script src="~/js/admin-slider-categories.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
    <script src="~/js/admin-slider-crop.js" asp-append-version="true"></script>
}
