@model ECommerce.Application.DTOs.Sayfa.SayfaGuncelleDto
@{
    ViewData["Title"] = Model.Baslik;
    bool isHakkimizda = Model.SayfaKodu?.Equals("hakkimizda", StringComparison.OrdinalIgnoreCase) == true;
}

<div class="container py-5">
    <div class="row">
        <!-- SOL SIDEBAR (Hızlı Linkler ve Destek) -->
        <div class="col-lg-3 d-none d-lg-block">
            <div class="sticky-top" style="top: 120px;">
                @await Component.InvokeAsync("SayfaNav")
            </div>
        </div>

        <!-- SAĞ İÇERİK ALANI -->
        <div class="col-lg-9">

            @if (isHakkimizda)
            {
                <!-- ================= ÖZEL HAKKIMIZDA SAYFASI ŞABLONU ================= -->
                <div class="about-page-wrapper">

                    <!-- 1. Bölüm: Üst Hero / Karşılama Alanı -->
                    <div class="card border-0 shadow-sm rounded-4 p-lg-5 p-4 mb-4 bg-white overflow-hidden position-relative">
                        <div class="row align-items-center g-5">
                            <div class="col-lg-7">
                                <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill fw-bold mb-3 small" style="letter-spacing: 0.5px;">HİKAYEMİZ</span>
                                <h1 class="fw-bold display-5 mb-4 text-dark" style="font-family: 'Outfit', sans-serif; line-height: 1.2;">
                                    Sevdiklerinize En Taze Mutluluğu Taşıyoruz
                                </h1>
                                <p class="text-secondary fs-6 mb-4" style="line-height: 1.8;">
                                    Kurulduğumuz günden bu yana en temel amacımız; sadece bir çiçek göndermek değil, aradaki mesafeleri unutturan en saf duyguları en taze şekilde sevdiklerinize ulaştırmaktır. Özenle seçilen çiçeklerimiz, usta ellerde tasarlanan buketlerimizle özel günlerinize değer katıyoruz.
                                </p>
                                <div class="d-flex align-items-center gap-4 pt-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                        <span class="fw-semibold text-dark small">Aynı Gün Teslimat</span>
                                    </div>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-check-circle-fill text-success fs-5"></i>
                                        <span class="fw-semibold text-dark small">%100 Tazelik Garantisi</span>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-5">
                                <div class="position-relative text-center">
                                    <div class="p-5 rounded-4 shadow-sm text-white text-center" style="background: linear-gradient(135deg, var(--site-primary), #4a1525);">
                                        <i class="bi bi-flower1 display-1 opacity-75 mb-3 d-block"></i>
                                        <h3 class="fw-bold h4 mb-2">Profesyonel Tasarım</h3>
                                        <p class="small text-white-50 mb-0">Her aranjman bir sanat eseridir.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 2. Bölüm: Misyon & Vizyon ve Değerlerimiz (3'lü Grid) -->
                    <div class="row g-4 mb-4">
                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 about-feature-card">
                                <div class="icon-box mb-3 text-danger bg-danger bg-opacity-10 rounded-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 1.25rem;">
                                    <i class="bi bi-bullseye"></i>
                                </div>
                                <h4 class="fw-bold h5 text-dark mb-2">Misyonumuz</h4>
                                <p class="text-muted small mb-0" style="line-height: 1.7;">
                                    Müşterilerimizin duygularına tercüman olan en kaliteli çiçek tasarımlarını, en hızlı ve güvenilir alt yapıyla buluşturmak.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 about-feature-card">
                                <div class="icon-box mb-3 text-danger bg-danger bg-opacity-10 rounded-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 1.25rem;">
                                    <i class="bi bi-eye"></i>
                                </div>
                                <h4 class="fw-bold h5 text-dark mb-2">Vizyonumuz</h4>
                                <p class="text-muted small mb-0" style="line-height: 1.7;">
                                    Sektördeki yenilikçi yaklaşımımızla güvenilirliğin simgesi olmak ve çiçekçilik deneyimini dijital dünyada zirveye taşımak.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card border-0 shadow-sm rounded-4 p-4 h-100 about-feature-card">
                                <div class="icon-box mb-3 text-danger bg-danger bg-opacity-10 rounded-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; font-size: 1.25rem;">
                                    <i class="bi bi-gem"></i>
                                </div>
                                <h4 class="fw-bold h5 text-dark mb-2">Değerlerimiz</h4>
                                <p class="text-muted small mb-0" style="line-height: 1.7;">
                                    Şeffaflık, müşteri memnuniyeti, tazecik ürünler ve söz verdiğimiz saatte kapıda olma prensibi vazgeçilmezimizdir.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Bölüm: Neden Bizi Seçmelisiniz? (Büyük Banner Alanı) -->
                    <div class="card border-0 shadow-sm rounded-4 p-lg-5 p-4 bg-white">
                        <div class="row align-items-center">
                            <div class="col-lg-12">
                                <h3 class="fw-bold h4 mb-4 text-dark text-center" style="font-family: 'Outfit', sans-serif;">Neden Bizi Tercih Etmelisiniz?</h3>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="d-flex gap-3 align-items-start p-3 rounded-3 bg-light">
                                    <i class="bi bi-shield-check text-danger fs-3 mt-1"><div></div></i>
                                    <div>
                                        <h5 class="fw-bold h6 text-dark mb-1">Güvenli Ödeme Altyapısı</h5>
                                        <p class="small text-muted mb-0">256-bit SSL güvenlik sertifikası ile tüm ödemeleriniz koruma altındadır.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <div class="d-flex gap-3 align-items-start p-3 rounded-3 bg-light">
                                    <i class="bi bi-headset text-danger fs-3 mt-1"></i>
                                    <div>
                                        <h5 class="fw-bold h6 text-dark mb-1">Canlı Destek & Müşteri Memnuniyeti</h5>
                                        <p class="small text-muted mb-0">Siparişinizin her aşamasında ekibimiz sorularınızı yanıtlamak için hazır.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            }
            else
            {
                <!-- ================= DİĞER SAYFALAR İÇİN STANDART ŞABLON (KVKK vb.) ================= -->
                <div class="card border-0 shadow-sm rounded-4 p-lg-5 p-4 content-card">
                    <div class="mb-4 pb-3 border-bottom border-2">
                        <h1 class="fw-bold display-6 mb-2" style="color: #24213d; font-family: 'Outfit', sans-serif;">@Model.Baslik</h1>
                    </div>
                    <div class="static-page-content">
                        @Html.Raw(Model.Icerik)
                    </div>
                </div>
            }

        </div>
    </div>
</div>

<style>
    /* Ortak Kart ve Tipografi Stilleri */
    .content-card, .about-page-wrapper .card {
        background-color: #ffffff;
        border: 1px solid #f0edf0 !important;
        font-family: 'Outfit', sans-serif;
    }

    /* Özellik Kartları Hover Efekti */
    .about-feature-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

        .about-feature-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.08) !important;
        }

    /* Diğer Sayfalar İçin Standart İçerik Tasarımı */
    .static-page-content {
        color: #4a4552;
        font-size: 1.05rem;
        line-height: 1.8;
    }

        .static-page-content p {
            margin-bottom: 1.25rem;
        }

        .static-page-content h2, .static-page-content h3 {
            color: #24213d;
            font-weight: 700;
            margin-top: 2rem;
            margin-bottom: 1rem;
            padding-left: 1rem;
            border-left: 5px solid var(--site-primary);
        }
</style>