@model ECommerce.WebUI.Models.IletisimViewModel
@{
    ViewData["Title"] = "İletişim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .t-page-container {
        max-width: 1300px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .t-hero-section {
        text-align: center;
        margin-bottom: 45px;
    }

    .t-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #9a1640;
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin-bottom: 10px;
    }

    .t-title {
        font-size: 2.3rem;
        font-weight: 700;
        color: #24213d;
        margin-bottom: 10px;
        letter-spacing: -.5px;
    }

    .t-subtitle {
        color: #85818c;
        font-size: 1rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .t-card {
        background: #fff;
        border-radius: 20px;
        border: 1px solid #eee9ed;
        box-shadow: 0 10px 30px rgba(35,28,40,.05);
        padding: 40px;
        height: 100%;
    }

    .contact-info-item {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 25px;
    }

    .contact-icon-box {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        background: #fff2f5;
        color: #8b0028;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .form-label {
        font-weight: 600;
        color: #403b46;
        font-size: .9rem;
        margin-bottom: 8px;
    }

    .form-control {
        border-radius: 12px;
        border: 1px solid #e5e0e5;
        padding: 12px 18px;
        font-size: .95rem;
        transition: all 0.2s;
    }

        .form-control:focus {
            border-color: #8b0028;
            box-shadow: 0 0 0 3px rgba(139,0,40,.1);
        }

    .t-btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        background: linear-gradient(135deg,#8b0028,#a70b3b);
        border: 0;
        border-radius: 12px;
        color: #fff;
        padding: 14px 28px;
        font-size: 1rem;
        font-weight: 600;
        width: 100%;
        cursor: pointer;
        box-shadow: 0 8px 22px rgba(139,0,40,.2);
        transition: all 0.2s ease;
    }

        .t-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(139,0,40,.28);
        }

    .social-links {
        display: flex;
        gap: 12px;
        margin-top: 30px;
    }

    .social-btn {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #fdf8f9;
        color: #8b0028;
        border: 1px solid #f2d6dc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        text-decoration: none;
        transition: all 0.2s;
    }

        .social-btn:hover {
            background: #8b0028;
            color: #fff;
        }
</style>

<div class="t-page-container">
    <div class="t-hero-section">
        <div class="t-eyebrow"><i class="bi bi-chat-heart"></i> Bizimle İletişime Geçin</div>
        <h1 class="t-title">Sorularınız İçin Buradayız</h1>
        <p class="t-subtitle">Çiçek siparişleriniz, özel tasarım talepleriniz veya her türlü görüşünüz için bizimle 7/24 iletişime geçebilirsiniz.</p>
    </div>

    @if (TempData["BasariliMesaj"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="border-radius:14px; background: #edf9f4; color: #287c5d; border: 1px solid #d4f0e5;">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["BasariliMesaj"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["HataMesaji"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="border-radius:14px;">
            <i class="bi bi-exclamation-circle-fill me-2"></i>@TempData["HataMesaji"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4 align-items-stretch">
        <!-- SOL TARAF: İletişim Bilgileri (Site Ayarlarından Dinamik) -->
        <div class="col-lg-5">
            <div class="t-card">
                <h3 class="fw-bold mb-4" style="color: #24213d;">İletişim Bilgileri</h3>

                @if (!string.IsNullOrEmpty(Model.Adres))
                {
                    <div class="contact-info-item">
                        <div class="contact-icon-box"><i class="bi bi-geo-alt-fill"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: #24213d;">Adresimiz</h6>
                            <p class="text-muted small mb-0">@Model.Adres</p>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Telefon1))
                {
                    <div class="contact-info-item">
                        <div class="contact-icon-box"><i class="bi bi-telephone-fill"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: #24213d;">Telefon Hattı</h6>
                            <a href="tel:@Model.Telefon1" class="text-muted text-decoration-none small">@Model.Telefon1</a>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <div class="contact-info-item">
                        <div class="contact-icon-box"><i class="bi bi-envelope-fill"></i></div>
                        <div>
                            <h6 class="fw-bold mb-1" style="color: #24213d;">E-Posta Adresi</h6>
                            <a href="mailto:@Model.Email" class="text-muted text-decoration-none small">@Model.Email</a>
                        </div>
                    </div>
                }

                <div class="contact-info-item">
                    <div class="contact-icon-box"><i class="bi bi-clock-fill"></i></div>
                    <div>
                        <h6 class="fw-bold mb-1" style="color: #24213d;">Çalışma Saatleri</h6>
                        <p class="text-muted small mb-0">Her gün: 09:00 - 20:00</p>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.InstagramUrl) || !string.IsNullOrEmpty(Model.FacebookUrl) || !string.IsNullOrEmpty(Model.TwitterUrl))
                {
                    <div class="social-links">
                        @if (!string.IsNullOrEmpty(Model.InstagramUrl))
                        {
                            <a href="@Model.InstagramUrl" target="_blank" class="social-btn"><i class="bi bi-instagram"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(Model.FacebookUrl))
                        {
                            <a href="@Model.FacebookUrl" target="_blank" class="social-btn"><i class="bi bi-facebook"></i></a>
                        }
                        @if (!string.IsNullOrEmpty(Model.TwitterUrl))
                        {
                            <a href="@Model.TwitterUrl" target="_blank" class="social-btn"><i class="bi bi-twitter-x"></i></a>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- SAĞ TARAF: İletişim Formu -->
        <div class="col-lg-7">
            <div class="t-card">
                <h3 class="fw-bold mb-4" style="color: #24213d;">Bize Mesaj Gönderin</h3>

                <form asp-controller="Iletisim" asp-action="Index" method="post">
                    <div class="row g-3">
                        <div class="col-md-6 mb-2">
                            <label class="form-label">Adınız Soyadınız</label>
                            <input type="text" asp-for="Dto.GonderenAdSoyad" class="form-control" placeholder="Örn: Ahmet Yılmaz" required />
                        </div>

                        <div class="col-md-6 mb-2">
                            <label class="form-label">E-Posta Adresiniz</label>
                            <input type="email" asp-for="Dto.GonderenEmail" class="form-control" placeholder="ornek@mail.com" required />
                        </div>

                        <div class="col-md-6 mb-2">
                            <label class="form-label">Telefon Numaranız</label>
                            <input type="text" asp-for="Dto.Telefon" class="form-control" placeholder="0532..." />
                        </div>

                        <div class="col-md-6 mb-2">
                            <label class="form-label">Konu Başlığı</label>
                            <input type="text" asp-for="Dto.Konu" class="form-control" placeholder="Örn: Sipariş Durumu" required />
                        </div>

                        <div class="col-12 mb-3">
                            <label class="form-label">Mesajınız</label>
                            <textarea asp-for="Dto.Mesaj" class="form-control" rows="5" placeholder="Mesajınızı buraya yazabilirsiniz..." required></textarea>
                        </div>
                    </div>

                    <button type="submit" class="t-btn-primary">
                        <i class="bi bi-send-fill"></i> Mesajı Gönder
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>