@model ECommerce.Application.Models.Sepet
@{
    ViewData["Title"] = "Alışveriş Sepetim";
    Layout = "~/Views/Shared/_Layout.cshtml";

    decimal araToplam = Model.Kalemler.Sum(k => k.BirimFiyat * k.Miktar);
    decimal teslimatToplam = Model.Kalemler.Sum(k => k.TeslimatUcreti);
    decimal vipToplam = Model.Kalemler.Sum(k => k.VipUcreti);

    decimal kampanyaIndirimi = Model.KampanyaIndirimTutari;
    decimal kuponIndirimi = Model.IndirimTutari;

    // Genel Toplam = Ara Toplam + Kargo + VIP - Kampanya İndirimi - Kupon İndirimi
    decimal genelToplam = araToplam + teslimatToplam + vipToplam - kampanyaIndirimi - kuponIndirimi;
    if (genelToplam < 0) genelToplam = 0;
}

<style>
    .cart-page {
        --cart-rose: #8b0028;
        --cart-rose-soft: #fbf1f3;
        --cart-green: #355b48;
        --cart-ink: #302a2b;
        --cart-muted: #817779;
        max-width: 1240px;
        color: var(--cart-ink);
        font-family: 'Outfit', sans-serif;
    }

    .cart-page h1,
    .cart-page h2,
    .cart-page h3,
    .cart-page h4,
    .cart-page h5,
    .cart-page h6,
    .cart-page .product-link,
    .cart-page .summary-title {
        font-family: 'Outfit', sans-serif !important;
    }

    .cart-heading { margin-bottom: 1.75rem; }
    .cart-breadcrumb .breadcrumb-item,
    .cart-breadcrumb .breadcrumb-item a { color: var(--cart-muted) !important; font-size: .9rem; }
    .cart-breadcrumb .breadcrumb-item.active { color: var(--cart-rose) !important; }
    .cart-title { color: var(--cart-ink); font-family: 'Outfit', sans-serif !important; font-size: clamp(1.8rem, 3vw, 2.35rem); letter-spacing: -.035em; }
    .cart-title-icon { color: #b56b7e; font-size: 1.45rem; vertical-align: .12em; }
    .cart-subtitle { color: var(--cart-muted); font-size: .95rem; }

    .cart-items-panel { overflow: hidden; border: 1px solid #eee3e5; border-radius: 20px; background: #fff; box-shadow: 0 12px 36px rgba(71, 38, 46, .07); }
    .cart-header {
        border-bottom: 1px solid #f0e6e8;
        background: #fbf6f6 !important;
        color: #75666a !important;
        letter-spacing: .08em;
    }

    .cart-item { min-height: 142px; border-color: #f1e9ea !important; transition: background .2s ease; }
    .cart-item:last-child { border-bottom: 0 !important; }
    .cart-item:hover { background: #fffdfd; }

    .item-col {
        width: 100%;
    }

    .image-container {
        width: 80px;
        height: 80px;
        min-width: 80px;
        flex-shrink: 0;
        border-radius: 14px;
        overflow: hidden;
        background-color: #f8f3f0;
        border: 1px solid #f0e5e2;
        box-shadow: 0 5px 15px rgba(58, 38, 35, .09);
    }

    @@media (min-width: 768px) {
        .item-col {
            width: 33.333%;
            text-align: center;
            justify-content: center !important;
        }
    }

    .summary-card {
        background: linear-gradient(160deg, #fff 55%, #fdf7f7);
        border: 1px solid #eee3e5;
        border-radius: 20px;
        box-shadow: 0 12px 36px rgba(71, 38, 46, .07);
    }

    .btn-checkout {
        background-color: var(--site-primary);
        border-color: var(--site-primary);
        border-radius: 12px;
    }

        .btn-checkout:hover {
            opacity: 0.9;
        }

    .product-link {
        color: #1a1a1a;
        transition: color 0.2s ease;
    }
    .product-link:hover {
        color: #8b0028 !important;
    }

    .qty-stepper {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: transparent;
        border: 0;
        border-radius: 0;
        padding: 0;
    }

    .cart-page .qty-btn {
        width: 22px;
        height: 26px;
        border-radius: 4px;
        border: 0 !important;
        background: transparent !important;
        color: #8b0028 !important;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        box-shadow: none !important;
        transition: color 0.15s ease;
        padding: 0;
    }
    .cart-page .qty-btn:hover {
        background: transparent !important;
        color: #5f001b !important;
        box-shadow: none !important;
    }

    .cart-page .btn-cart-delete {
        width: 26px;
        height: 26px;
        border: 0 !important;
        border-radius: 4px;
        background: transparent !important;
        color: #a28389 !important;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: none !important;
        transition: color 0.2s ease;
        padding: 0;
    }
    .cart-page .btn-cart-delete:hover {
        background: transparent !important;
        color: #8b0028 !important;
        border-color: transparent !important;
        box-shadow: none !important;
    }
    .cart-page .btn-cart-delete i {
        font-size: .82rem !important;
        font-weight: 300;
    }

    .cart-page .product-link { color: var(--cart-ink); }
    .cart-page .product-link h6 { font-size: 1rem; line-height: 1.4; }
    .cart-page .delivery-label { color: var(--cart-green) !important; font-weight: 500; }
    .cart-page .summary-title { font-family: 'Outfit', sans-serif !important; }
    .cart-page .summary-total { color: var(--cart-rose) !important; }
    .cart-page .btn-checkout { background: var(--cart-rose); border-color: var(--cart-rose); border-radius: 13px; box-shadow: 0 8px 18px rgba(139, 0, 40, .18) !important; transition: transform .2s ease, box-shadow .2s ease; }
    .cart-page .btn-checkout:hover { transform: translateY(-2px); box-shadow: 0 11px 22px rgba(139, 0, 40, .24) !important; }
    .cart-page .cart-empty { border: 1px solid #eee3e5; border-radius: 22px; background: radial-gradient(circle at 50% 0, #fcf1f3, #fff 64%); }

    @@media (max-width: 767.98px) {
        .cart-page { margin-top: 1.5rem !important; }
        .cart-item { padding: 1.1rem !important; }
        .cart-item .item-col { padding: .65rem 0; border-top: 1px solid #f4edef; }
        .image-container { width: 76px; height: 76px; min-width: 76px; }
    }
</style>

<div class="container cart-page my-5">
    <!-- BAŞARI / HATA MESAJLARI -->
    @if (TempData["BasariliMesaj"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["BasariliMesaj"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }
    @if (TempData["HataMesaji"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["HataMesaji"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
        </div>
    }

    <div class="cart-heading">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb cart-breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Anasayfa</a></li>
                <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">Sepetim</li>
            </ol>
        </nav>
        <h1 class="cart-title fw-bold mb-2"><i class="bi bi-basket2 cart-title-icon me-2"></i>Sepetim <span class="fs-5 fw-normal" style="font-family: inherit; color: #817779;">(@Model.Kalemler.Sum(k => k.Miktar) ürün)</span></h1>
        <p class="cart-subtitle mb-0">Seçtiğiniz çiçekler, sevdiklerinize ulaşmaya hazır.</p>
    </div>

    @if (Model.Kalemler == null || !Model.Kalemler.Any())
    {
        <div class="text-center py-5 p-5 cart-empty summary-card">
            <div class="mb-3" style="color:#b56b7e;font-size:2.5rem;"><i class="bi bi-flower1"></i></div>
            <h3 class="fw-bold text-dark mb-2">Sepetinizde Ürün Bulunmuyor</h3>
            <a href="/Urunler" class="btn btn-primary px-5 py-3 rounded-pill fw-bold text-white text-decoration-none mt-3" style="background-color: var(--site-primary);">Alışverişe Başla</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="cart-items-panel">
                    <div class="cart-header d-none d-md-flex text-dark fw-bold small text-uppercase py-3 px-4 bg-light">
                        <div style="flex: 3;">Ürün</div>
                        <div class="d-flex" style="flex: 4;">
                            <div class="item-col">Adet</div>
                            <div class="item-col">Fiyat</div>
                            <div class="item-col">Toplam</div>
                        </div>
                    </div>

                    @foreach (var item in Model.Kalemler)
                    {
                        <div class="cart-item d-flex flex-column flex-md-row align-items-md-center py-4 px-4 border-bottom position-relative">
                            <div class="d-flex align-items-center gap-3 mb-3 mb-md-0" style="flex: 3; min-width: 0;">
                                <form asp-action="Cikar" method="post" class="m-0 flex-shrink-0">
                                    <input type="hidden" name="kalemId" value="@item.Id" />
                                    <button class="btn-cart-delete" title="Sepetten Kaldır" aria-label="Ürünü sepetten kaldır">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </form>
                                <a href="/urun/id/@item.UrunId" class="image-container d-block text-decoration-none shadow-sm" title="@item.UrunAdi Detayına Git">
                                    <img src="@(string.IsNullOrEmpty(item.GorselUrl) ? "/images/no-image.jpg" : item.GorselUrl)"
                                         alt="@item.UrunAdi" class="w-100 h-100 object-fit-cover"
                                         onerror="this.src='/images/no-image.jpg'" />
                                </a>
                                <div class="pe-3" style="flex: 1; min-width: 0;">
                                    <div class="d-flex align-items-start justify-content-between gap-2">
                                        <a href="/urun/id/@item.UrunId" class="product-link text-decoration-none d-inline-block flex-grow-1" style="min-width: 0;" title="@item.UrunAdi Detayına Git">
                                            <h6 class="fw-bold mb-1 text-truncate">@item.UrunAdi</h6>
                                        </a>
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.VaryantAdi) && item.VaryantAdi != "Standart Boy / Model")
                                    {
                                        <small class="d-block text-muted mb-1 text-truncate">Varyant: @item.VaryantAdi</small>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Mahalle))
                                    {
                                        <small class="delivery-label d-block text-truncate" style="font-size: 0.8rem;">
                                            <i class="bi bi-geo-alt-fill me-1"></i> @item.Il / @item.Ilce / @item.Mahalle
                                        </small>
                                    }
                                </div>
                            </div>

                            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between w-100 gap-3 gap-md-0" style="flex: 4;">
                                <!-- ADET ARTIR / AZALT STEPPER -->
                                <div class="d-flex justify-content-between align-items-center item-col">
                                    <span class="d-md-none text-muted small fw-bold text-uppercase">Adet</span>
                                    <div class="qty-stepper shadow-sm">
                                        <form asp-action="MiktarGuncelle" method="post" class="m-0 d-inline">
                                            <input type="hidden" name="kalemId" value="@item.Id" />
                                            <input type="hidden" name="miktar" value="@(item.Miktar - 1)" />
                                            <button class="qty-btn" title="Adet Azalt" aria-label="Adedi azalt">
                                                <i class="bi bi-dash"></i>
                                            </button>
                                        </form>
                                        <span class="fw-bold text-dark px-2 user-select-none" style="min-width: 28px; text-align: center; font-size: 0.95rem;">@item.Miktar</span>
                                        <form asp-action="MiktarGuncelle" method="post" class="m-0 d-inline">
                                            <input type="hidden" name="kalemId" value="@item.Id" />
                                            <input type="hidden" name="miktar" value="@(item.Miktar + 1)" />
                                            <button class="qty-btn" title="Adet Artır" aria-label="Adedi artır">
                                                <i class="bi bi-plus"></i>
                                            </button>
                                        </form>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center item-col">
                                    <span class="d-md-none text-muted small fw-bold text-uppercase">Fiyat</span>
                                    <span class="fw-bold text-dark">₺@item.BirimFiyat.ToString("N2")</span>
                                </div>

                                <div class="d-flex justify-content-between align-items-center item-col">
                                    <span class="d-md-none text-muted small fw-bold text-uppercase">Toplam</span>
                                    <span class="fw-bolder text-dark">₺@((item.BirimFiyat * item.Miktar).ToString("N2"))</span>
                                </div>

                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- SAĞ: SİPARİŞ ÖZETİ KARTI -->
            <div class="col-lg-4">
                <div class="summary-card p-4 sticky-top" style="top: 100px;">
                    <h5 class="summary-title fw-bold text-dark mb-4 pb-2 border-bottom"><i class="bi bi-flower2 me-2" style="color:#b56b7e;"></i>Sipariş Özeti</h5>

                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span class="fw-semibold">Ara Toplam</span>
                        <span class="fw-bold">₺@araToplam.ToString("N2")</span>
                    </div>

                    <div class="d-flex justify-content-between mb-3 text-muted">
                        <span class="fw-semibold">Teslimat Ücreti</span>
                        <span class="fw-bold">₺@teslimatToplam.ToString("N2")</span>
                    </div>

                    @if (vipToplam > 0)
                    {
                        <div class="d-flex justify-content-between mb-3" style="color: #bfa100;">
                            <span class="fw-bold"><i class="bi bi-crown-fill me-1"></i> VIP Teslimat Ücreti</span>
                            <span class="fw-bold">₺@vipToplam.ToString("N2")</span>
                        </div>
                    }

                    <!-- KAMPANYA İNDİRİMİ SATIRI -->
                    @if (kampanyaIndirimi > 0)
                    {
                        <div class="d-flex justify-content-between mb-3 text-success">
                            <span class="fw-semibold">
                                <i class="bi bi-stars me-1"></i> @(string.IsNullOrEmpty(Model.UygulananKampanyaAdi) ? "Kampanya İndirimi" : Model.UygulananKampanyaAdi)
                            </span>
                            <span class="fw-bold">-₺@kampanyaIndirimi.ToString("N2")</span>
                        </div>
                    }

                    <!-- EĞER KUPON UYGULANDIYSA ÖZETTE GÖSTER -->
                    @if (kuponIndirimi > 0)
                    {
                        <div class="d-flex justify-content-between mb-3 text-success">
                            <span class="fw-semibold"><i class="bi bi-tag-fill me-1"></i> İndirim (@Model.IndirimKodu)</span>
                            <span class="fw-bold">-₺@kuponIndirimi.ToString("N2")</span>
                        </div>
                    }

                    <hr class="text-muted opacity-25 my-4" />

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <span class="fw-bold fs-5 text-dark">Toplam</span>
                        <span class="summary-total fw-bolder fs-4">₺@genelToplam.ToString("N2")</span>
                    </div>

                    <!-- KUPON GİRİŞ VEYA AKTİF KUPON ALANI -->
                    <div class="mb-4">
                        <label class="form-label text-muted small fw-bold">İndirim Kodu</label>
                        @if (string.IsNullOrEmpty(Model.IndirimKodu))
                        {
                            <form asp-action="KuponUygula" method="post" class="input-group shadow-sm" style="border-radius: 8px;">
                                <input type="text" name="kuponKodu" class="form-control shadow-none text-uppercase" placeholder="Kodu girin" required style="border-radius: 8px 0 0 8px; border-color: #cbd5e1; font-size: 0.9rem;">
                                <button class="btn fw-bold px-3 text-white" type="submit" style="background-color: #8b0028; border-color: #8b0028; border-radius: 0 8px 8px 0; font-size: 0.9rem; min-width: 85px;">
                                    Uygula
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="d-flex justify-content-between align-items-center bg-light border border-success px-3 py-2 rounded-3">
                                <span class="small fw-bold text-success text-uppercase">
                                    <i class="bi bi-check-circle-fill me-1"></i> @Model.IndirimKodu uygulandı
                                </span>
                                <form asp-action="KuponKaldir" method="post" class="m-0">
                                    <button type="submit" class="btn btn-sm btn-link text-danger p-0 text-decoration-none fw-bold" title="Kuponu Kaldır">
                                        <i class="bi bi-x-circle fs-6"></i> Kaldır
                                    </button>
                                </form>
                            </div>
                        }
                    </div>

                    <a href="/Odeme" id="checkoutBtn" data-auth="@User.Identity.IsAuthenticated" class="btn btn-checkout w-100 py-3 fw-bold text-white text-decoration-none shadow-sm fs-6 d-flex justify-content-center align-items-center">
                        Ödemeye Geç
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<!-- ================= ÖDEME TERCİHİ (GİRİŞ / MİSAFİR) MODALI ================= -->
<div class="modal fade" id="odemeSecimModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 24px; overflow: hidden; padding: 10px;">
            <div class="modal-header border-0 pb-0 justify-content-end">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body text-center px-4 pb-4 pt-0">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle shadow-sm" style="width: 70px; height: 70px; background-color: #fcf8ff; color: #3b1154;">
                        <i class="bi bi-shield-lock-fill fs-2"></i>
                    </div>
                </div>
                <h4 class="fw-bold text-dark mb-1">Ödeme İşlemi</h4>
                <p class="text-muted small mb-4">Siparişinizi tamamlamak için lütfen giriş yapın veya üye olmadan devam edin.</p>

                <div class="d-grid gap-3 mb-4">
                    <!-- Üye Giriş Butonu (Giriş sayfasına yönlendirir, dönüşte /Odeme sayfasına gider) -->
                    <a href="/Hesap/Giris?returnUrl=/Odeme" class="btn text-white py-3 fw-bold rounded-pill shadow-sm d-flex align-items-center justify-content-center gap-2" style="background-color: #3b1154;">
                        <i class="bi bi-person-fill fs-5"></i> Üye Girişi
                    </a>

                    <div class="position-relative text-center my-1">
                        <hr class="text-muted opacity-25 m-0" />
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small fw-semibold">veya</span>
                    </div>

                    <!-- Üye Olmadan Devam Et Butonu -->
                    <a href="/Odeme" class="btn py-3 fw-bold rounded-pill d-flex align-items-center justify-content-center gap-2" style="border: 1px solid #e2d9ec; color: #3b1154; background-color: #fcf8ff;">
                        <span>Üye Olmadan Devam Et</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                <div class="text-muted small d-flex align-items-center justify-content-center gap-1 opacity-75">
                    <i class="bi bi-lock-fill text-success"></i> 256-bit SSL Güvenli Ödeme
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const checkoutBtn = document.getElementById('checkoutBtn');
        if (checkoutBtn) {
            checkoutBtn.addEventListener('click', function (e) {
                const isAuthenticated = checkoutBtn.getAttribute('data-auth') === 'True';

                // Eğer kullanıcı giriş yapmamışsa modalı aç ve gitmesini engelle
                if (!isAuthenticated) {
                    e.preventDefault();
                    var modalEl = document.getElementById('odemeSecimModal');
                    var modal = new bootstrap.Modal(modalEl);
                    modal.show();
                }
                // Giriş yapmışsa doğrudan /Odeme sayfasına geçiş yapar.
            });
        }
    });
</script>
