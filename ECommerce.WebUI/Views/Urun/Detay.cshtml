@model ECommerce.Application.DTOs.Urun.UrunDetayDto
@{
    ViewData["Title"] = Model.Ad;
    Layout = "~/Views/Shared/_Layout.cshtml";

    string gorselYolu = string.IsNullOrWhiteSpace(Model.GorselUrl)
        ? "/images/no-image.jpg"
        : Model.GorselUrl;
}

<link rel="stylesheet" href="~/css/product-detail.css" asp-append-version="true" />

<div class="product-detail-container">
    @if (TempData["BasariliMesaj"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4" role="alert" style="border-radius:12px;">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["BasariliMesaj"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["HataMesaji"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert" style="border-radius:12px;">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["HataMesaji"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-5">
        <!-- SOL: Çoklu Fotoğraf Galerisi (1-5 Fotoğraf) -->
        <div class="col-lg-6">
            <div class="product-gallery-wrapper">
                <div class="product-image-box">
                    <img src="@gorselYolu" alt="@Model.Ad" id="anaUrunGorseli" />
                    <div class="static-badge">İndirimli Ürün</div>
                </div>

                @if (Model.TumGorseller != null && Model.TumGorseller.Count > 1)
                {
                    <div class="product-thumbnails-strip">
                        @for (int i = 0; i < Model.TumGorseller.Count; i++)
                        {
                            var gorsel = Model.TumGorseller[i];
                            <div class="thumb-item @(i == 0 ? "active" : "")" data-gorsel="@gorsel" onclick="resimDegistir(this, this.getAttribute('data-gorsel'))">
                                <img src="@gorsel" alt="@Model.Ad - Fotoğraf @(i + 1)" />
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- SAĞ: Sipariş Formu Partial View -->
        @await Html.PartialAsync("_UrunSiparisFormPartial", Model)
    </div>

    <!-- GÜVEN VE ÖDEME SEÇENEKLERİ BANNERI -->
    @await Html.PartialAsync("_GuvenOdemeBannerPartial")

    <!-- SEKMELER PARTIAL VIEW ÇAĞRISI -->
    @await Html.PartialAsync("_ProductTabsPartial", Model)

    <!-- BENZER ÜRÜNLER VIEWCOMPONENT -->
    @await Component.InvokeAsync("BenzerUrunler", new { kategoriId = Model.KategoriId, mevcutUrunId = Model.Id })
</div>

<!-- MODALLAR -->
@await Html.PartialAsync("_TeslimatModalPartial")
@await Html.PartialAsync("_YorumYapModalPartial", Model)

<!-- JAVASCRIPT DEĞİŞKENLERİ VE DOSYASI -->
<script>
    const teslimatBolgeleri = @Html.Raw(ViewBag.TeslimatBolgeleriJson ?? "[]");
    const rawWhatsappNo = "@(ViewBag.WhatsappNo as string ?? "905010146623")";
    const baseUrunAd = "@Html.Raw(Model.Ad)";
    const baseUrunKod = "@Html.Raw(Model.UrunKodu)";

    function resimDegistir(elem, yeniGorselUrl) {
        const anaResim = document.getElementById('anaUrunGorseli');
        if (!anaResim) return;

        anaResim.style.opacity = '0.4';
        setTimeout(() => {
            anaResim.src = yeniGorselUrl;
            anaResim.style.opacity = '1';
        }, 150);

        document.querySelectorAll('.thumb-item').forEach(el => el.classList.remove('active'));
        elem.classList.add('active');
    }
</script>
<script src="~/js/product-detail.js" asp-append-version="true"></script>