@model List<ECommerce.Application.DTOs.Urun.UrunListeDto>
@{
    ViewData["Title"] = "Tüm Ürünler";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <!-- Sayfa Başlığı -->
    <div class="text-center mb-5">
        <h1 class="fw-bold text-dark" style="letter-spacing: -0.5px;">Tüm Ürünlerimiz</h1>
        <p class="text-muted">En özenle hazırlanmış çiçek ve hediyelik ürünlerimizi keşfedin.</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center py-4 rounded-4" role="alert">
            <i class="bi bi-exclamation-circle fs-3 d-block mb-2"></i>
            Henüz eklenmiş aktif bir ürün bulunmuyor.
        </div>
    }
    else
    {
        <!-- Ürün Grid Alanı -->
        <div class="row g-4" id="urunGridContainer">
            @foreach (var urun in Model)
            {
                // Başlangıçta sadece ilk 8 ürünü gösteriyoruz, diğerlerine gizli class ekliyoruz
                bool ilkGrup = Model.IndexOf(urun) < 8;
                string gizliClass = ilkGrup ? "" : "d-none yuklenecek-urun";
                string gorsel = string.IsNullOrWhiteSpace(urun.GorselUrl) ? "/images/no-image.jpg" : urun.GorselUrl;

                <div class="col-lg-3 col-md-4 col-sm-6 @gizliClass">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card" style="transition: transform 0.2s;">

                        <!-- Görsel ve Favori Kalp Butonu Alanı -->
                        <div class="position-relative bg-light" style="height: 240px;">
                            <a href="/urun/@urun.SeoUrl" class="text-decoration-none">
                                <img src="@gorsel" alt="@urun.Ad" class="w-100 h-100 object-fit-cover" />
                            </a>

                            @if (!string.IsNullOrEmpty(urun.Etiket))
                            {
                                <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill small">@urun.Etiket</span>
                            }

                            <!-- Favori (Kalp) Butonu -->
                            <button type="button" class="btn-favori position-absolute top-0 end-0 m-3 rounded-circle bg-white shadow-sm border-0 d-flex align-items-center justify-content-center"
                                    style="width: 36px; height: 36px; z-index: 3;"
                                    data-urun-id="@urun.Id"
                                    title="Favorilere Ekle / Çıkar">
                                <i class="bi bi-heart text-danger" style="font-size: 1.1rem;"></i>
                            </button>
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <span class="text-muted small mb-1">Ürün Kodu: @urun.UrunKodu</span>
                            <a href="/urun/@urun.SeoUrl" class="text-decoration-none text-dark fw-bold mb-2 product-title-link">
                                @urun.Ad
                            </a>
                            <div class="mt-auto d-flex align-items-center justify-content-between pt-3">
                                <span class="fw-bold fs-5 text-dark">@urun.Fiyat.ToString("N2") ₺</span>
                                <a href="/urun/@urun.SeoUrl" class="btn text-white btn-sm rounded-pill px-3 fw-semibold shadow-sm" style="background-color: #3b1154;">
                                    İncele
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Daha Fazla Yükle Butonu -->
        @if (Model.Count > 8)
        {
            <div class="text-center mt-5">
                <button type="button" id="dahaFazlaBtn" class="btn text-white px-5 py-3 rounded-pill fw-bold shadow-sm" style="background-color: #3b1154; transition: opacity 0.2s;">
                    <i class="bi bi-arrow-down-circle me-2"></i> Daha Fazla Yükle
                </button>
            </div>
        }
    }
</div>

<!-- Kart Tasarım ve Hover Stilleri -->
<style>
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.08) !important;
    }

    .product-title-link:hover {
        color: #3b1154 !important;
    }
</style>

<!-- Daha Fazla Yükle Mantığı (JavaScript) -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const btn = document.getElementById("dahaFazlaBtn");
        if (btn) {
            btn.addEventListener("click", function () {
                // Gizli olan ürünlerden sıradaki 8 tanesini seçiyoruz
                const gizliUrunler = document.querySelectorAll(".yuklenecek-urun.d-none");

                for (let i = 0; i < 8 && i < gizliUrunler.length; i++) {
                    gizliUrunler[i].classList.remove("d-none");
                }

                // Eğer başka gizli ürün kalmadıysa butonu tamamen kaldırıyoruz
                if (document.querySelectorAll(".yuklenecek-urun.d-none").length === 0) {
                    btn.style.display = "none";
                }
            });
        }
    });
</script>