</style>

<script>
    const tumKartNotlari = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        kartNotlariListesi.Select(x => new {
            id = x.Id.ToString(),
            kategori = x.Kategori,
            mesaj = x.MesajIcerigi
        })
    ));

    let aktifKategoriNotlari = [];
    let aktifNotIndex = 0;

    function kategoriNotuSec(kategoriAdi, element) {
        document.querySelectorAll('#kartNotuKategoriler .fl-template-chip').forEach(c => c.classList.remove('active'));
        if (element) {
            element.classList.add('active');
        } else {
            const el = document.querySelector(`#kartNotuKategoriler .fl-template-chip[data-kategori="${kategoriAdi}"]`);
            if (el) el.classList.add('active');
        }

        aktifKategoriNotlari = tumKartNotlari.filter(n => (n.kategori || '').toLowerCase() === (kategoriAdi || '').toLowerCase());
        aktifNotIndex = 0;

        const txt = document.getElementById('kartNotuInput');
        const stepper = document.getElementById('notDegistirmeKontrolleri');
        const counter = document.getElementById('notSayacText');

        if (!aktifKategoriNotlari || aktifKategoriNotlari.length === 0) {
            if (stepper) stepper.style.display = 'none';
            return;
        }

        if (txt) {
            txt.value = aktifKategoriNotlari[0].mesaj;
            txt.focus();
        }

        if (stepper) {
            if (aktifKategoriNotlari.length > 1) {
                stepper.style.display = 'flex';
                if (counter) counter.textContent = `1/${aktifKategoriNotlari.length}`;
            } else {
                stepper.style.display = 'none';
            }
        }
    }

    function notAdimla(yon) {
        if (!aktifKategoriNotlari || aktifKategoriNotlari.length <= 1) return;

        aktifNotIndex += yon;
        if (aktifNotIndex >= aktifKategoriNotlari.length) {
            aktifNotIndex = 0; // Döngüsel başa dön
        } else if (aktifNotIndex < 0) {
            aktifNotIndex = aktifKategoriNotlari.length - 1; // Sona git
        }

        const txt = document.getElementById('kartNotuInput');
        const counter = document.getElementById('notSayacText');

        if (txt) {
            txt.value = aktifKategoriNotlari[aktifNotIndex].mesaj;
            txt.focus();
        }

        if (counter) {
            counter.textContent = `${aktifNotIndex + 1}/${aktifKategoriNotlari.length}`;
        }
    }
</script>
