@model ECommerce.Application.DTOs.Urun.UrunDetayDto
@{
    string rawWhatsapp = ViewBag.WhatsappNo as string ?? "905010146623";
    string stokSormaMesaji = Uri.EscapeDataString($"Merhaba, {Model.UrunKodu} kodlu {Model.Ad} çiçeği için stok ve teslimat durumu öğrenebilir miyim?");

    var teslimatSaatleriListesi = ViewBag.TeslimatSaatleri as List<ECommerce.Application.DTOs.TeslimatSaati.TeslimatSaatiDto> ?? new List<ECommerce.Application.DTOs.TeslimatSaati.TeslimatSaatiDto>();
    decimal vipUcret = ViewBag.VipUcreti != null ? Convert.ToDecimal(ViewBag.VipUcreti) : 0m;
    bool varyantVar = Model.Varyantlar != null && Model.Varyantlar.Any();
    int adimSayac = 1;
}

<div class="col-lg-6">
    <div class="fl-order-card">
        <!-- KOLEKSİYON VE PUAN SATIRI -->
        <div class="fl-header-meta">
            <span class="fl-collection-tag">
                HAUTE BOTANIQUE • @(string.IsNullOrWhiteSpace(Model.KategoriAdi) ? "ÖZEL KOLEKSİYON" : Model.KategoriAdi.ToUpper())
            </span>
            <div class="d-flex align-items-center gap-2">
                <span class="fl-rating-badge">
                    4.9 <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i>
                    <span>(@(Model.ToplamYorumSayisi > 0 ? Model.ToplamYorumSayisi : 128))</span>
                </span>
                <button type="button" class="btn-favori btn btn-light rounded-circle border-0 d-flex align-items-center justify-content-center shadow-none"
                        style="width: 36px; height: 36px; background: #FAF8F5;"
                        data-urun-id="@Model.Id"
                        title="Favorilere Ekle / Çıkar">
                    <i class="bi bi-heart text-danger fs-6"></i>
                </button>
                <button type="button" class="btn btn-light rounded-circle border-0 d-flex align-items-center justify-content-center shadow-none"
                        style="width: 36px; height: 36px; background: #FAF8F5;"
                        onclick="urunPaylas()"
                        title="Çiçeği Paylaş">
                    <i class="bi bi-share text-secondary fs-6"></i>
                </button>
            </div>
        </div>

        <!-- ÜRÜN BAŞLIĞI -->
        <h1 class="fl-product-main-title">@Model.Ad</h1>

        <!-- ŞİİRSEL / BOTANİK AÇIKLAMA -->
        <p class="fl-product-description">
            @if (!string.IsNullOrWhiteSpace(Model.Aciklama))
            {
                @Html.Raw(Model.Aciklama.Length > 220 ? Model.Aciklama.Substring(0, 220) + "..." : Model.Aciklama)
            }
            else
            {
                <text>Fransız bahçe gülleri, pudra pembe şakayıklar, taze okaliptüs yaprakları ve atölyemize özel ipek ambalaj tanzimi ile zarafetin somut hali.</text>
            }
        </p>

        <!-- FİYAT ALANI -->
        <div class="fl-price-row">
            <span class="fl-big-price">
                ₺<span id="urunFiyatDisplay" data-base-price="@Model.Fiyat.ToString(System.Globalization.CultureInfo.InvariantCulture)">@Model.Fiyat.ToString("N0")</span>
            </span>
            
        </div>

        <form asp-controller="Sepet" asp-action="Ekle" method="post" id="siparisFormu">
            <input type="hidden" name="UrunId" value="@Model.Id" />
            <input type="hidden" name="Adet" id="gercekAdetInput" value="1" />

            @if (varyantVar)
            {
                <!-- BOYUT TERCİHİ (Sadece Admin Eklediyse Gösterilir) -->
                <div class="fl-section-wrap">
                    <div class="fl-section-header">
                        <h6 class="fl-section-title">@(adimSayac++). BOYUT TERCİHİ</h6>
                        <a href="javascript:void(0)" onclick="boyutRehberiGoster()" class="fl-section-link">
                            <i class="bi bi-rulers me-1"></i>Boyut Rehberi
                        </a>
                    </div>

                    <div class="fl-sizes-grid">
                        @{
                            int vIndex = 0;
                        }
                        @foreach (var v in Model.Varyantlar!)
                        {
                            bool isFirst = (vIndex == 0);
                            <div class="fl-size-card @(isFirst ? "active" : "")"
                                 onclick="boyutSec(this, '@v.Id', @v.FiyatFarki.ToString(System.Globalization.CultureInfo.InvariantCulture), '@v.VaryantAdi')">
                                <span class="fl-radio-dot"></span>
                                <div class="fl-size-title">@v.VaryantAdi</div>
                                <div class="fl-size-desc">@(v.StokMiktari > 0 ? $"Stok: {v.StokMiktari} adet" : "Taze Tanzim")</div>
                                <div class="fl-size-price">
                                    @(v.FiyatFarki > 0 ? $"+₺{v.FiyatFarki:N0}" : (v.FiyatFarki < 0 ? $"-₺{Math.Abs(v.FiyatFarki):N0}" : $"₺{Model.Fiyat:N0}"))
                                </div>
                            </div>
                            vIndex++;
                        }
                    </div>
                </div>
            }

            <!-- TESLİMAT YERİ, TARİHİ VE SAATİ -->
            <div class="fl-section-wrap">
                <!-- Teslimat adresi: il, ilçe ve mahalle -->
                <div class="fl-delivery-location-wrap mb-3">
                    <button type="button" id="teslimatYeriToggle" class="fl-delivery-location-toggle" aria-expanded="false" aria-controls="mahalleSecimi">
                        <span class="fl-delivery-location-copy">
                            <span class="fl-delivery-location-title">Teslimat yeri</span>
                            <span id="secilenTeslimatYeri" class="fl-delivery-location-summary" aria-live="polite">Mahalle seçin</span>
                        </span>
                        <i class="bi bi-chevron-down fl-delivery-location-chevron" aria-hidden="true"></i>
                    </button>
                    <div id="mahalleSecimi" class="fl-neighborhood-list" role="radiogroup" aria-label="Teslimat yeri" hidden>
                        <p class="fl-neighborhood-empty">Teslimat bölgeleri yükleniyor…</p>
                    </div>
                </div>

                <!-- 2. Başlık: Teslimat Tarihi ve Saati -->
                <h6 class="fl-delivery-date-title">Teslimat Tarihi ve Saati</h6>

                <!-- 3. 3'lü Buton Kutuları (Bugün / Yarın / Tarih Seç) -->
                <div class="fl-delivery-date-grid">
                    <div class="fl-delivery-date-card active" onclick="tarihTuruSec(this, 'Bugun')">
                        <i class="bi bi-truck fl-delivery-icon"></i>
                        <span class="fl-delivery-label">Bugün</span>
                    </div>
                    <div class="fl-delivery-date-card" onclick="tarihTuruSec(this, 'Yarin')">
                        <i class="bi bi-calendar-check fl-delivery-icon"></i>
                        <span class="fl-delivery-label">Yarın</span>
                    </div>
                    <div class="fl-delivery-date-card" onclick="tarihTuruSec(this, 'TarihSec')">
                        <i class="bi bi-calendar3 fl-delivery-icon"></i>
                        <span class="fl-delivery-label">Tarih Seç</span>
                    </div>
                </div>

                <div id="ozelTarihBox" class="mb-3" style="display: none;">
                    <input type="date" id="ozelTarihInput" class="form-control rounded-3 mt-2" onchange="ozelTarihDegisti()" />
                </div>

                <!-- 4. Teslimat Saati Dropdown (Solunda saat ikonu olan) -->
                <div class="fl-delivery-time-select-wrap">
                    <div class="fl-select-with-icon">
                        <span class="fl-select-icon-box"><i class="bi bi-clock"></i></span>
                        <select id="teslimatSaatiSelect" class="fl-time-select" onchange="saatSecimiDegisti(this)">
                            <option value="" disabled>Teslimat saati seçin</option>
                            @if (teslimatSaatleriListesi != null && teslimatSaatleriListesi.Any())
                            {
                                int sIdx = 0;
                                foreach (var s in teslimatSaatleriListesi)
                                {
                                    bool isSelected = sIdx == 0;
                                    string saatMetni = $"{s.BaslangicSaati} - {s.BitisSaati}";
                                    <option value="@saatMetni" selected="@(isSelected ? "selected" : null)">
                                        @saatMetni @(!string.IsNullOrEmpty(s.Aciklama) ? $"({s.Aciklama})" : "")
                                    </option>
                                    sIdx++;
                                }
                            }
                            else
                            {
                                <option value="09:00 - 13:00">09:00 - 13:00 (Sabah)</option>
                                <option value="13:00 - 17:00" selected>13:00 - 17:00 (Öğle - En Popüler)</option>
                                <option value="17:00 - 21:00">17:00 - 21:00 (Akşam)</option>
                            }
                        </select>
                    </div>
                </div>

                <!-- VIP Teslimat Opsiyonu -->
                <div class="fl-vip-row mt-3">
                    <div class="form-check m-0 d-flex align-items-center gap-2">
                        <input class="form-check-input mt-0" type="checkbox" name="VipTeslimatAktifMi" value="true" id="vipCheckbox" onchange="vipDurumuDegisti()" />
                        <label class="form-check-label small fw-bold text-dark cursor-pointer" for="vipCheckbox">
                            <span class="badge bg-warning text-dark px-2 py-1 me-1">VIP</span> Özel Saatli VIP Teslimat Garantisi
                        </label>
                    </div>
                    <span class="fw-bold small text-dark">+₺@vipUcret.ToString("N0")</span>
                </div>
            </div>

            <!-- MÜHÜRLÜ EL YAZISI TEBRİK KARTI -->
            <div class="fl-section-wrap">
                <div class="fl-section-header">
                    <h6 class="fl-section-title">
                        <i class="bi bi-envelope-paper-heart me-1 text-danger"></i>@(adimSayac++). MÜHÜRLÜ EL YAZISI TEBRİK KARTI
                    </h6>
                    <span class="fl-free-pill">Ücretsiz Dokunuş</span>
                </div>

                <!-- Şablon Butonları -->
                <div class="fl-card-templates">
                    <span class="fl-template-chip" onclick="sablonDoldur('Doğum Günü', 'Yeni yaşında tüm hayallerinin gerçek olması, ömrünün bu çiçekler gibi renkli ve neşeli geçmesi dileğiyle... Doğum günün kutlu olsun!')">
                        🎂 Doğum Günü
                    </span>
                    <span class="fl-template-chip" onclick="sablonDoldur('Yıldönümü', 'Seninle geçen her gün bir bahar sabahı gibi taze ve güzel. Yıldönümümüz kutlu olsun sevgilim, nice mutlu yıllara!')">
                        💍 Yıldönümü
                    </span>
                    <span class="fl-template-chip" onclick="sablonDoldur('İçimden Geldi', 'Gününün sıradan bir anında yüzünde küçük bir tebessüm olmak istedim. Seni çok seviyorum...')">
                        🌸 İçimden Geldi
                    </span>
                    <span class="fl-template-chip" onclick="sablonDoldur('Teşekkür Ederim', 'Hayatıma kattığın tüm güzellikler ve desteğin için sonsuz teşekkürler. İyi ki varsın!')">
                        🕊️ Teşekkür Ederim
                    </span>
                </div>

                <!-- Alıcı İsmi Input -->
                <input type="text" name="AliciAdi" id="aliciAdiInput" class="fl-custom-input" placeholder="Alıcı İsmi (Örn: Sevgili Zeynep)" />

                <!-- Mesaj Textarea -->
                <textarea name="KartNotu" id="kartNotuInput" class="fl-custom-textarea" placeholder="Özel mesajınızı yazın... İtalyan pamuk kağıda özel mürekkep ve balmumu mühürle aktarılacaktır."></textarea>
            </div>

            <!-- GİZLİ INPUTLAR -->
            <input type="hidden" name="VaryantId" id="gizliVaryantId" value="@(varyantVar ? Model.Varyantlar!.First().Id.ToString() : "")" />
            <input type="hidden" name="BoyutAdi" id="gizliBoyutAdi" value="@(varyantVar ? Model.Varyantlar!.First().VaryantAdi : "Standart")" />
            <input type="hidden" name="BoyutFarki" id="gizliBoyutFark" value="@(varyantVar ? Model.Varyantlar!.First().FiyatFarki.ToString(System.Globalization.CultureInfo.InvariantCulture) : "0")" />
            <input type="hidden" name="VazoSecimi" id="gizliVazoSecimi" value="Standart Çiçek Buketi" />
            <input type="hidden" name="VazoFarki" id="gizliVazoFark" value="0" />

            <input type="hidden" name="Il" id="gizliIl" value="Elazığ" />
            <input type="hidden" name="Ilce" id="gizliIlce" value="Merkez" />
            <input type="hidden" name="Mahalle" id="gizliMahalle" value="" />
            <input type="hidden" name="TeslimatGunu" id="gizliTeslimatGunu" value="Bugun" />
            <input type="hidden" name="TeslimatSaati" id="gizliTeslimatSaati" value="13:00 - 17:00" />

            <input type="hidden" name="MahalleFarki" id="gizliMahalleFark" value="0" />
            <input type="hidden" name="VipFarki" id="gizliVipFark" value="0" data-ucret="@vipUcret.ToString(System.Globalization.CultureInfo.InvariantCulture)" />

            <!-- 4. AKSİYON & SİPARİŞ BUTONLARI -->
            <div class="fl-action-buttons-wrap">
                <div class="fl-quantity-order-row">
                    <div class="fl-qty-stepper">
                        <button type="button" class="fl-qty-btn" onclick="adetDegistir(-1)">-</button>
                        <input type="text" id="gorselAdet" class="fl-qty-input" value="1" readonly />
                        <button type="button" class="fl-qty-btn" onclick="adetDegistir(1)">+</button>
                    </div>

                    <button type="submit" class="fl-submit-btn" id="siparisVerBtn" disabled title="Sipariş vermek için teslimat mahallesi seçin">
                        <i class="bi bi-bag-check-fill"></i> Sipariş Ver
                    </button>
                </div>

                <a href="javascript:void(0)" id="whatsappSiparisBtn" aria-disabled="true" onclick="whatsappSiparis()" class="fl-whatsapp-btn is-disabled">
                    <i class="bi bi-whatsapp"></i> WhatsApp ile Hızlı Sipariş
                </a>
            </div>
        </form>
    </div>
</div>
