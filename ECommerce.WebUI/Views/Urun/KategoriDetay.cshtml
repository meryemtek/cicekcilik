@model List<ECommerce.Application.DTOs.Urun.UrunListeDto>
@{
    ViewData["Title"] = ViewBag.KategoriAdi;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <!-- Breadcrumb ve Kategori Başlığı -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Anasayfa</a></li>
                <li class="breadcrumb-item active text-dark fw-bold" aria-current="page">@ViewBag.KategoriAdi</li>
            </ol>
        </nav>
        <h1 class="fw-bold text-dark" style="font-size: 1.8rem; letter-spacing: -0.5px;">@ViewBag.KategoriAdi</h1>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-warning text-center py-5 rounded-4 shadow-sm" role="alert">
            <i class="bi bi-box-seam fs-1 d-block mb-3 text-warning"></i>
            <h4 class="fw-bold">Bu kategoride henüz ürün bulunmuyor</h4>
            <p class="text-muted mb-4">Çok yakında bu kategoride yeni ürünlerimiz yer alacaktır.</p>
            <a href="/urunler" class="btn text-white px-4 py-2 rounded-pill fw-semibold" style="background-color: #3b1154;">
                Tüm Ürünleri İncele
            </a>
        </div>
    }
    else
    {
        <!-- Ürünler Grid Listesi -->
        <div class="row g-4">
            @foreach (var urun in Model)
            {
                string gorsel = string.IsNullOrWhiteSpace(urun.GorselUrl) ? "/images/no-image.jpg" : urun.GorselUrl;

                <div class="col-lg-3 col-md-4 col-sm-6">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden product-card" style="transition: transform 0.2s;">

                        <!-- Görsel ve Favori Kalp Butonu Alanı -->
                        <div class="position-relative bg-light" style="height: 240px;">
                            <a href="/urun/@urun.SeoUrl" class="text-decoration-none">
                                <img src="@gorsel" alt="@urun.Ad" class="w-100 h-100 object-fit-cover" />
                            </a>

                            @if (!string.IsNullOrEmpty(urun.Etiket))
                            {
                                <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill small">@urun.Etiket</span>
                            }

                            <!-- Favori (Kalp) Butonu -->
                            <button type="button" class="btn-favori position-absolute top-0 end-0 m-3 rounded-circle bg-white shadow-sm border-0 d-flex align-items-center justify-content-center"
                                    style="width: 36px; height: 36px; z-index: 3;"
                                    data-urun-id="@urun.Id"
                                    title="Favorilere Ekle / Çıkar">
                                <i class="bi bi-heart text-danger" style="font-size: 1.1rem;"></i>
                            </button>
                        </div>

                        <div class="card-body d-flex flex-column p-4">
                            <span class="text-muted small mb-1">Ürün Kodu: @urun.UrunKodu</span>
                            <a href="/urun/@urun.SeoUrl" class="text-decoration-none text-dark fw-bold mb-2 product-title-link">
                                @urun.Ad
                            </a>
                            <div class="mt-auto d-flex align-items-center justify-content-between pt-3">
                                <span class="fw-bold fs-5 text-dark">@urun.Fiyat.ToString("N2") ₺</span>
                                <a href="/urun/@urun.SeoUrl" class="btn text-white btn-sm rounded-pill px-3 fw-semibold shadow-sm" style="background-color: #3b1154;">
                                    İncele
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Kart Stilleri -->
<style>
    .product-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.08) !important;
    }

    .product-title-link:hover {
        color: #3b1154 !important;
    }
</style>