@model ECommerce.Application.DTOs.Siparis.SiparisDetayDto
@{
    ViewData["Title"] = "Sipariş Detayı";
    ViewData["AktifMenu"] = "Siparislerim";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row g-4">
        <div class="col-lg-3">@await Html.PartialAsync("_HesapMenuPartial")</div>
        <div class="col-lg-9">
            <a href="/Hesap/Siparislerim" class="d-inline-block mb-3 text-decoration-none text-success"><i class="bi bi-arrow-left me-1"></i>Tüm siparişlerim</a>
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
                <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
                    <div>
                        <span class="text-muted small">Sipariş numarası</span>
                        <h1 class="h3 fw-bold mb-1">@Model.SiparisNumarasi</h1>
                        <span class="text-muted small">@Model.SiparisTarihi.ToString("dd.MM.yyyy HH:mm")</span>
                    </div>
                    <span class="badge rounded-pill bg-light text-dark border px-3 py-2">@Model.DurumAdi</span>
                </div>
                <hr />
                <div class="row g-3 small">
                    <div class="col-md-6"><span class="text-muted d-block">Alıcı</span><strong>@Model.AliciAdSoyad</strong><br />@Model.AliciTelefon</div>
                    <div class="col-md-6"><span class="text-muted d-block">Teslimat adresi</span><strong>@Model.TeslimatAdresi</strong></div>
                </div>
            </div>
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h2 class="h5 fw-bold mb-3">Sipariş Edilen Ürünler</h2>
                @foreach (var kalem in Model.Kalemler)
                {
                    <div class="d-flex justify-content-between align-items-center gap-3 py-3 border-bottom">
                        <div class="d-flex align-items-center gap-3">
                            <a href="/urun/id/@kalem.UrunId" class="d-block rounded-3 overflow-hidden border shadow-sm" style="width: 64px; height: 64px; min-width: 64px;" title="@kalem.UrunAdi Detayına Git">
                                <img src="@(string.IsNullOrEmpty(kalem.GorselUrl) ? "/images/no-image.jpg" : kalem.GorselUrl)" alt="@kalem.UrunAdi" class="w-100 h-100 object-fit-cover" onerror="this.src='/images/no-image.jpg'" />
                            </a>
                            <div>
                                <a href="/urun/id/@kalem.UrunId" class="text-decoration-none text-dark fw-bold d-inline-block mb-1" title="@kalem.UrunAdi Detayına Git" style="transition: color 0.2s;">
                                    @kalem.UrunAdi
                                </a>
                                <div class="small text-muted">@kalem.Miktar adet @(kalem.VaryantAdi != "Standart Boy / Model" && !string.IsNullOrEmpty(kalem.VaryantAdi) ? "— " + kalem.VaryantAdi : "")</div>
                                <div class="small text-muted">Birim Fiyat: ₺@kalem.BirimFiyat.ToString("N2")</div>
                            </div>
                        </div>
                        <div class="text-end">
                            <strong class="text-dark fs-6">₺@kalem.ToplamFiyat.ToString("N2")</strong>
                        </div>
                    </div>
                }

                <div class="mt-4 pt-2">
                    <div class="d-flex justify-content-between text-muted small mb-2">
                        <span>Ara Toplam</span>
                        <span>₺@Model.AraToplam.ToString("N2")</span>
                    </div>
                    @if (Model.TeslimatToplamUcreti > 0)
                    {
                        <div class="d-flex justify-content-between text-muted small mb-2">
                            <span>Teslimat Ücreti</span>
                            <span>₺@Model.TeslimatToplamUcreti.ToString("N2")</span>
                        </div>
                    }
                    @if (Model.VipToplamUcreti > 0)
                    {
                        <div class="d-flex justify-content-between small mb-2" style="color: #bfa100;">
                            <span><i class="bi bi-crown-fill me-1"></i> VIP Teslimat Ücreti</span>
                            <span>₺@Model.VipToplamUcreti.ToString("N2")</span>
                        </div>
                    }
                    @if (Model.KampanyaIndirimTutari > 0)
                    {
                        <div class="d-flex justify-content-between text-success small mb-2">
                            <span><i class="bi bi-stars me-1"></i> Kampanya İndirimi (@(Model.UygulananKampanyaAdi ?? "Kampanya"))</span>
                            <span>-₺@Model.KampanyaIndirimTutari.ToString("N2")</span>
                        </div>
                    }
                    @if (Model.KuponIndirimTutari > 0)
                    {
                        <div class="d-flex justify-content-between text-success small mb-2">
                            <span><i class="bi bi-tag-fill me-1"></i> İndirim Kuponu (@Model.KullanilanKuponKodu)</span>
                            <span>-₺@Model.KuponIndirimTutari.ToString("N2")</span>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between fs-5">
                        <strong class="text-dark">Toplam</strong>
                        <strong class="text-success">₺@Model.ToplamTutar.ToString("N2")</strong>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.KartNotu))
                {
                    <div class="mt-4 p-3 bg-light rounded-3 border">
                        <span class="small fw-bold text-muted d-block mb-1"><i class="bi bi-card-text me-1"></i> Çiçek Kart Notu:</span>
                        <p class="mb-0 small fst-italic text-dark">"@Model.KartNotu"</p>
                        @if (!string.IsNullOrEmpty(Model.GonderenGorunenAd))
                        {
                            <span class="small text-muted d-block mt-1">— Gönderen: <strong>@Model.GonderenGorunenAd</strong></span>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
