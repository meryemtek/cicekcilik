@{
    var aktifMenu = ViewData["AktifMenu"]?.ToString() ?? "";
}

<div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
    <div class="d-flex align-items-center mb-3 p-2 border-bottom">
        <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold me-3" style="width: 45px; height: 45px; background-color: #3b1154;">
            <i class="bi bi-person fs-5"></i>
        </div>
        <div>
            <h6 class="fw-bold mb-0 text-dark">Hesabım</h6>
            <small class="text-muted">Hoş geldiniz</small>
        </div>
    </div>

    <div class="account-menu">
        <!-- Kontrol Paneli -->
        <a href="/Hesap/Index" class="d-block py-2 px-3 mb-2 rounded-3 text-decoration-none fw-semibold @(aktifMenu == "KontrolPaneli" ? "text-white" : "text-dark")" style="@(aktifMenu == "KontrolPaneli" ? "background-color: #3b1154;" : "")">
            <i class="bi bi-speedometer2 me-2"></i> Kontrol Paneli
        </a>

        <!-- Siparişlerim Grubu -->
        <div class="menu-section mt-3 mb-2">
            <div class="text-uppercase fw-bold px-3 mb-1 d-flex align-items-center" style="font-size: 0.75rem; letter-spacing: 1px; color: #3b1154 !important;">
                <i class="bi bi-box-seam me-1"></i> Siparişlerim
            </div>
            <div class="list-group list-group-flush mt-1 gap-1">
                <a href="/Hesap/Siparislerim" class="list-group-item list-group-item-action border-0 rounded-3 py-2 small @(aktifMenu == "Siparislerim" ? "text-white fw-bold" : "text-dark fw-medium")" style="@(aktifMenu == "Siparislerim" ? "background-color: #8b0028;" : "")">Tüm Siparişlerim</a>
                <a href="#" class="list-group-item list-group-item-action border-0 rounded-3 py-2 text-dark small fw-medium">Değerlendirmelerim</a>
                <a href="#" class="list-group-item list-group-item-action border-0 rounded-3 py-2 text-dark small fw-medium">Satıcı Mesajlarım</a>
                <a href="#" class="list-group-item list-group-item-action border-0 rounded-3 py-2 text-dark small fw-medium">Tekrar Satın Al</a>
            </div>
        </div>

        <!-- Sana Özel Grubu -->
        <div class="menu-section mt-3 mb-2">
            <div class="text-uppercase fw-bold px-3 mb-1 d-flex align-items-center" style="font-size: 0.75rem; letter-spacing: 1px; color: #3b1154 !important;">
                <i class="bi bi-stars me-1"></i> Sana Özel
            </div>
            <div class="list-group list-group-flush mt-1 gap-1">
                <a href="#" class="list-group-item list-group-item-action border-0 rounded-3 py-2 text-dark small fw-medium">İndirim Kuponlarım</a>
                <a href="#" class="list-group-item list-group-item-action border-0 rounded-3 py-2 text-dark small fw-medium">Önceden Gezdiklerim</a>
                <a href="/Favoriler" class="list-group-item list-group-item-action border-0 rounded-3 py-2 text-dark small fw-medium text-danger">Favorilerim</a>
            </div>
        </div>

        <!-- Hesabım & Yardım Grubu -->
        <div class="menu-section mt-3 mb-2">
            <div class="text-uppercase fw-bold px-3 mb-1 d-flex align-items-center" style="font-size: 0.75rem; letter-spacing: 1px; color: #3b1154 !important;">
                <i class="bi bi-gear me-1"></i> Hesabım & Yardım
            </div>
            <div class="list-group list-group-flush mt-1 gap-1">
                <a href="#" class="list-group-item list-group-item-action border-0 rounded-3 py-2 text-dark small fw-medium">Kullanıcı Bilgilerim</a>
                <a href="#" class="list-group-item list-group-item-action border-0 rounded-3 py-2 text-dark small fw-medium">Adres Bilgilerim</a>
                <a href="#" class="list-group-item list-group-item-action border-0 rounded-3 py-2 text-dark small fw-medium">Kayıtlı Kartlarım</a>
                <a href="#" class="list-group-item list-group-item-action border-0 rounded-3 py-2 text-dark small fw-medium">Duyuru Tercihlerim</a>
                <a href="#" class="list-group-item list-group-item-action border-0 rounded-3 py-2 text-dark small fw-medium">Şifre Değişikliği</a>
            </div>
        </div>

        <div class="mt-3 pt-3 border-top">
            <a href="/Hesap/Cikis" class="d-block py-2 px-3 rounded-3 text-danger text-decoration-none fw-semibold">
                <i class="bi bi-box-arrow-right me-2"></i> Çıkış Yap
            </a>
        </div>
    </div>
</div>

<style>
    .list-group-item-action:hover {
        background-color: #f8f5f9;
        color: #8b0028 !important;
    }
</style>