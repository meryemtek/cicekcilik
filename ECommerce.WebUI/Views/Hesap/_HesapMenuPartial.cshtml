@{
    var aktifMenu = ViewData["AktifMenu"]?.ToString() ?? "";
}

<div class="bf-account-sidebar">
    <!-- Kullanıcı Profil Kartı -->
    <div class="bf-account-profile-header text-center mb-4">
        <div class="bf-account-avatar mx-auto mb-2">
            <i class="bi bi-person-fill"></i>
        </div>
        <h6 class="fw-bold mb-1 text-dark font-serif">@ViewData["HesapAdSoyad"]</h6>
        <span class="bf-member-badge">
            <i class="bi bi-gem me-1"></i> Lidya Üyesi
        </span>
    </div>

    <!-- Menü Linkleri -->
    <nav class="bf-account-nav">
        <!-- Genel Bakış -->
        <a href="/Hesap/Index" class="bf-nav-item @(aktifMenu == "KontrolPaneli" ? "active" : "")">
            <i class="bi bi-grid me-2"></i>
            <span>Hesap Özeti</span>
        </a>

        <!-- Siparişlerim -->
        <div class="bf-nav-group mt-3">
            <span class="bf-nav-group-title">SİPARİŞLERİM</span>
            <a href="/Hesap/Siparislerim" class="bf-nav-item @(aktifMenu == "Siparislerim" ? "active" : "")">
                <i class="bi bi-box-seam me-2"></i>
                <span>Tüm Siparişlerim</span>
            </a>
            <a href="/Favoriler" class="bf-nav-item">
                <i class="bi bi-heart me-2 text-rose"></i>
                <span>Favori Çiçeklerim</span>
            </a>
        </div>

        <!-- Hesap & Tercihler -->
        <div class="bf-nav-group mt-3">
            <span class="bf-nav-group-title">HESAP AYARLARI</span>
            <a href="/Hesap/Adreslerim" class="bf-nav-item @(aktifMenu == "Adreslerim" ? "active" : "")">
                <i class="bi bi-geo-alt me-2"></i>
                <span>Kayıtlı Adreslerim</span>
            </a>
            <a href="#sifreDegistir" class="bf-nav-item" data-bs-toggle="modal" data-bs-target="#sifreDegistirModal">
                <i class="bi bi-shield-lock me-2"></i>
                <span>Şifre Değiştir</span>
            </a>
        </div>

        <!-- Çıkış Yap -->
        <div class="mt-4 pt-3 border-top">
            <a href="/Hesap/Cikis" class="bf-nav-item bf-logout-item">
                <i class="bi bi-box-arrow-right me-2"></i>
                <span>Güvenli Çıkış</span>
            </a>
        </div>
    </nav>
</div>

<!-- ŞİFRE DEĞİŞTİR MODAL -->
<div class="modal fade" id="sifreDegistirModal" tabindex="-1" aria-labelledby="sifreDegistirModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg p-3">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title font-serif fw-bold text-dark" id="sifreDegistirModalLabel">Şifre Değiştir</h5>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Hesap güvenliğiniz için düzenli olarak şifrenizi güncellemenizi öneririz.</p>
                <form asp-controller="Hesap" asp-action="SifreDegistir" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mevcut Şifre</label>
                        <input type="password" name="MevcutSifre" class="form-control rounded-3" autocomplete="current-password" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Yeni Şifre</label>
                        <input type="password" name="YeniSifre" class="form-control rounded-3" autocomplete="new-password" minlength="6" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Yeni Şifre Tekrar</label>
                        <input type="password" name="YeniSifreTekrar" class="form-control rounded-3" autocomplete="new-password" minlength="6" required />
                    </div>
                    <button type="submit" class="btn w-100 rounded-pill py-2 text-white fw-bold shadow-sm" style="background-color: #1a3a2f;">
                        Şifreyi Güncelle
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .bf-account-sidebar {
        background: #ffffff;
        border: 1px solid rgba(232, 130, 150, .25);
        border-radius: 24px;
        padding: 28px 20px;
        box-shadow: 0 12px 32px -4px rgba(26, 58, 47, .06), 0 4px 12px rgba(232, 130, 150, .06);
    }

    .bf-account-avatar {
        width: 60px;
        height: 60px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1a3a2f, #02241a);
        color: #fcf9f8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        box-shadow: 0 6px 16px rgba(26, 58, 47, .2);
    }

    .bf-member-badge {
        display: inline-flex;
        align-items: center;
        padding: 3px 10px;
        border-radius: 999px;
        background: #ffd9de;
        color: #984255;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .bf-nav-group-title {
        display: block;
        padding: 6px 12px 4px;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .12em;
        color: #984255;
    }

    .bf-nav-item {
        display: flex;
        align-items: center;
        padding: 10px 14px;
        margin-bottom: 4px;
        border-radius: 12px;
        color: #414845;
        font-size: .84rem;
        font-weight: 600;
        text-decoration: none;
        transition: all .2s ease;
    }
    .bf-nav-item i {
        font-size: 1.1rem;
        transition: transform .2s ease;
    }
    .bf-nav-item:hover {
        background-color: #fcf9f8;
        color: #1a3a2f;
        transform: translateX(3px);
    }
    .bf-nav-item.active {
        background: #1a3a2f;
        color: #fcf9f8 !important;
        box-shadow: 0 4px 12px rgba(26, 58, 47, .18);
    }
    .bf-nav-item.active i {
        color: #ffd9de;
    }

    .text-rose {
        color: #984255 !important;
    }

    .bf-logout-item {
        color: #ba1a1a !important;
    }
    .bf-logout-item:hover {
        background-color: #ffdad6 !important;
        color: #93000a !important;
    }
</style>
