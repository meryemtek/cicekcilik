@model ECommerce.Application.DTOs.Auth.KayitDto
@{
    ViewData["Title"] = "Yeni Üyelik";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-dark" style="letter-spacing: -0.5px;">Aramıza Katılın</h2>
                    <p class="text-muted small">Hızlı ve güvenli alışveriş için hesap oluşturun.</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger rounded-3 small py-2 mb-3">
                        <div asp-validation-summary="All" class="text-danger m-0"></div>
                    </div>
                }

                <form asp-action="Kayit" method="post">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold small text-muted">Adınız</label>
                            <input asp-for="Ad" type="text" class="form-control rounded-3 py-2" placeholder="Adınız" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold small text-muted">Soyadınız</label>
                            <input asp-for="Soyad" type="text" class="form-control rounded-3 py-2" placeholder="Soyadınız" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">E-posta Adresi</label>
                        <input asp-for="Email" type="email" class="form-control rounded-3 py-2" placeholder="ornek@mail.com" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-muted">Telefon Numarası</label>
                        <input asp-for="Telefon" type="text" class="form-control rounded-3 py-2" placeholder="05XXXXXXXXX" required />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold small text-muted">Şifre</label>
                        <input asp-for="Sifre" type="password" class="form-control rounded-3 py-2" placeholder="En az 6 karakter" required />
                    </div>

                    <button type="submit" class="btn w-100 text-white py-3 rounded-pill fw-bold shadow-sm" style="background-color: #3b1154;">
                        Kayıt Ol
                    </button>
                </form>

                <div class="text-center mt-4 pt-3 border-top">
                    <p class="text-muted small mb-0">Zaten hesabınız var mı? <a href="/Hesap/Giris" class="text-decoration-none fw-bold" style="color: #3b1154;">Giriş Yapın</a></p>
                </div>
            </div>
        </div>
    </div>
</div>