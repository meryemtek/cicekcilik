@model ECommerce.WebUI.Models.HesapOzetViewModel
@{
    ViewData["Title"] = "Hesabım";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["AktifMenu"] = "KontrolPaneli";
}

<div class="bf-account-page py-5">
    <div class="container">
        <div class="row g-4">
            <!-- Sol Menü -->
            <div class="col-lg-3">
                @await Html.PartialAsync("_HesapMenuPartial")
            </div>

            <!-- Sağ İçerik Alanı -->
            <div class="col-lg-9">
                @if (TempData["BasariliMesaj"] != null)
                {
                    <div class="alert alert-success rounded-3" role="status">@TempData["BasariliMesaj"]</div>
                }
                @if (TempData["HataMesaj"] != null)
                {
                    <div class="alert alert-danger rounded-3" role="alert">@TempData["HataMesaj"]</div>
                }
                <!-- 1. Karşılama Kartı (Hero Banner) -->
                <div class="bf-account-hero-card mb-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <span class="bf-hero-pill mb-2">
                                <i class="bi bi-flower1 me-1"></i> Lidya Çiçek Dünyası
                            </span>
                            <h2 class="bf-account-hero-title mb-2">Hoş geldiniz, @Model.AdSoyad!</h2>
                            <p class="bf-account-hero-desc mb-0">
                                Bu panelden siparişlerinizin anlık durumunu takip edebilir, beğendiğiniz çiçekleri görüntüleyebilir ve teslimat tercihlerinizi düzenleyebilirsiniz.
                            </p>
                        </div>
                        <div class="col-md-4 text-md-end mt-3 mt-md-0">
                            <a href="/" class="btn bf-account-cta-btn">
                                <span>Çiçekleri Keşfet</span>
                                <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 2. Hızlı İşlem & Durum Kartları -->
                <div class="row g-3 mb-4">
                    <!-- Siparişlerim -->
                    <div class="col-md-4">
                        <div class="bf-stat-card">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="bf-stat-icon bf-stat-green">
                                    <i class="bi bi-box-seam"></i>
                                </span>
                                <span class="badge rounded-pill bg-light text-dark px-2 py-1 small">@Model.SiparisSayisi sipariş</span>
                            </div>
                            <h5 class="fw-bold text-dark font-serif mb-1">Siparişlerim</h5>
                            <p class="text-muted small mb-3">Verdiğiniz tüm siparişlerin hazırlık ve kargo durumu.</p>
                            <a href="/Hesap/Siparislerim" class="btn bf-card-action-btn w-100">
                                Siparişleri İncele <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Favorilerim -->
                    <div class="col-md-4">
                        <div class="bf-stat-card">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="bf-stat-icon bf-stat-rose">
                                    <i class="bi bi-heart-fill"></i>
                                </span>
                                <span class="badge rounded-pill bg-light text-dark px-2 py-1 small">@Model.FavoriSayisi favori</span>
                            </div>
                            <h5 class="fw-bold text-dark font-serif mb-1">Favori Çiçeklerim</h5>
                            <p class="text-muted small mb-3">Beğendiğiniz ve daha sonra sipariş vermek istediğiniz buketler.</p>
                            <a href="/Favoriler" class="btn bf-card-action-btn w-100">
                                Favorilere Git <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>

                    <!-- Adreslerim -->
                    <div class="col-md-4">
                        <div class="bf-stat-card">
                            <div class="d-flex align-items-center justify-content-between mb-3">
                                <span class="bf-stat-icon bf-stat-tertiary">
                                    <i class="bi bi-geo-alt"></i>
                                </span>
                                <span class="badge rounded-pill bg-light text-dark px-2 py-1 small">@Model.AdresSayisi adres</span>
                            </div>
                            <h5 class="fw-bold text-dark font-serif mb-1">Teslimat Adresleri</h5>
                            <p class="text-muted small mb-3">Ev, ofis veya sevdikleriniz için kayıtlı adres bilgileriniz.</p>
                            <a href="/Hesap/Adreslerim" class="btn bf-card-action-btn w-100">
                                Adresleri Yönet <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>

                @if (Model.SonSiparis != null)
                {
                    <div class="bf-info-banner p-4 rounded-4 mb-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        <div>
                            <span class="small text-muted">Son siparişiniz</span>
                            <h5 class="font-serif fw-bold mb-1">@Model.SonSiparis.SiparisNumarasi</h5>
                            <span class="small text-muted">@Model.SonSiparis.SiparisTarihi.ToString("dd.MM.yyyy") · @Model.SonSiparis.DurumAdi</span>
                        </div>
                        <a href="/Hesap/Siparislerim" class="btn bf-card-action-btn">Siparişlerimi Gör <i class="bi bi-arrow-right ms-1"></i></a>
                    </div>
                }

                <!-- 3. Hızlı Hizmet & Müşteri Desteği Bilgilendirme Kartı -->
                <div class="bf-info-banner p-4 rounded-4 mb-2">
                    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bf-info-badge">
                                <i class="bi bi-headset fs-4"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-1 font-serif">Özel Bir Sipariş veya Sorunuz mu Var?</h6>
                                <p class="text-muted small mb-0">Müşteri temsilcilerimiz Elazığ içi teslimatlar ve özel buket talepleriniz için hazır.</p>
                            </div>
                        </div>
                        <a href="/Iletisim" class="btn btn-outline-dark rounded-pill px-4 py-2 small fw-semibold flex-shrink-0">
                            Bize Ulaşın
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<style>
    .bf-account-page {
        background: #fcf9f8;
        min-height: 75vh;
    }

    .bf-account-hero-card {
        background: linear-gradient(135deg, #ffffff, #fff5f7);
        border: 1px solid rgba(232, 130, 150, .25);
        border-radius: 24px;
        padding: 32px 30px;
        box-shadow: 0 12px 32px -4px rgba(26, 58, 47, .06), 0 4px 12px rgba(232, 130, 150, .06);
    }

    .bf-hero-pill {
        display: inline-flex;
        align-items: center;
        padding: 4px 12px;
        border-radius: 999px;
        background: #ffd9de;
        color: #3f0015;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .1em;
        text-transform: uppercase;
    }

    .bf-account-hero-title {
        color: #02241a;
        font-family: 'Playfair Display', Georgia, serif !important;
        font-size: 1.85rem;
        font-weight: 600;
        letter-spacing: -.01em;
    }

    .bf-account-hero-desc {
        color: #414845;
        font-size: .88rem;
        font-weight: 300;
        line-height: 1.6;
    }

    .bf-account-cta-btn {
        background: #1a3a2f;
        color: #fcf9f8;
        border-radius: 999px;
        padding: 11px 22px;
        font-size: .78rem;
        font-weight: 600;
        letter-spacing: .08em;
        text-transform: uppercase;
        box-shadow: 0 4px 12px rgba(26, 58, 47, .2);
        transition: all .2s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
    }
    .bf-account-cta-btn:hover {
        background: #02241a;
        color: #ffffff;
        transform: translateY(-2px);
    }

    /* Stat Cards */
    .bf-stat-card {
        background: #ffffff;
        border: 1px solid rgba(232, 130, 150, .2);
        border-radius: 20px;
        padding: 24px 20px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        box-shadow: 0 8px 24px -4px rgba(26, 58, 47, .04);
        transition: all .25s ease;
    }
    .bf-stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 16px 32px -6px rgba(26, 58, 47, .1), 0 4px 12px rgba(232, 130, 150, .1);
    }

    .bf-stat-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }
    .bf-stat-green {
        background-color: #c7ebda;
        color: #1a3a2f;
    }
    .bf-stat-rose {
        background-color: #ffd9de;
        color: #984255;
    }
    .bf-stat-tertiary {
        background-color: #ffdcbd;
        color: #623f18;
    }

    .bf-card-action-btn {
        background-color: #fcf9f8;
        border: 1px solid rgba(232, 130, 150, .25);
        color: #1a3a2f;
        border-radius: 12px;
        font-size: .8rem;
        font-weight: 600;
        padding: 9px 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all .2s ease;
        text-decoration: none;
    }
    .bf-card-action-btn:hover {
        background-color: #1a3a2f;
        color: #ffffff;
        border-color: #1a3a2f;
    }

    /* Info Banner */
    .bf-info-banner {
        background: #ffffff;
        border: 1px solid rgba(232, 130, 150, .2);
        box-shadow: 0 8px 24px -4px rgba(26, 58, 47, .04);
    }
    .bf-info-badge {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background-color: #ffd9de;
        color: #984255;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }
</style>
