@model ECommerce.Application.DTOs.Siparis.SiparisDetayDto
@{
    ViewData["Title"] = "PayTR Güvenli Ödeme";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container my-4" style="max-width:960px">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div><span class="text-muted small">Sipariş @Model.SiparisNumarasi</span><h1 class="h4 fw-bold mb-0">Güvenli ödeme</h1></div>
        <span class="fw-bold">₺@Model.ToplamTutar.ToString("N2")</span>
    </div>
    <div class="bg-white border rounded-4 shadow-sm overflow-hidden" style="min-height:650px">
        <iframe src="@ViewBag.PaytrUrl" title="PayTR güvenli ödeme" style="width:100%;height:650px;border:0" allowpaymentrequest></iframe>
    </div>
</div>
