@model ECommerce.WebUI.Models.OdemeViewModel
@{
    var ilkKalem = Model.Sepet.Kalemler.FirstOrDefault();
    string teslimatBolgesiStr = ilkKalem != null ? $"{ilkKalem.Il} / {ilkKalem.Ilce} / {ilkKalem.Mahalle}" : "Belirtilmedi";
}

<div class="payment-card p-4 mb-4">
    <h5 class="fw-bold text-dark mb-3 pb-2 border-bottom">
        <i class="bi bi-geo-alt-fill me-2" style="color: #3b1154;"></i> 1. Alıcı Bilgileri
    </h5>
    <div class="row g-3">
        @if (Model.KayitliAdresler.Count > 0)
        {
            <div class="col-12">
                <label for="kayitli-adres-secimi" class="form-label small fw-bold text-muted">Kayıtlı adreslerim</label>
                <select id="kayitli-adres-secimi" class="form-select">
                    <option value="">Yeni teslimat adresi gireceğim</option>
                    @foreach (var adres in Model.KayitliAdresler)
                    {
                        var bolgeUyumlu = ilkKalem != null &&
                            string.Equals(adres.Il, ilkKalem.Il, StringComparison.CurrentCultureIgnoreCase) &&
                            string.Equals(adres.Ilce, ilkKalem.Ilce, StringComparison.CurrentCultureIgnoreCase);
                        <option value="@adres.Id" data-alici="@adres.AliciAdSoyad" data-telefon="@adres.Telefon" data-baslik="@adres.Baslik" data-adres="@adres.AcikAdres" disabled="@(!bolgeUyumlu)">
                            @adres.Baslik — @adres.Ilce / @adres.Il @(bolgeUyumlu ? "" : "(seçilen teslimat bölgesinden farklı)")
                        </option>
                    }
                </select>
                <div class="form-text">Sepetinizde seçtiğiniz il ve ilçeyle eşleşen adresler kullanılabilir.</div>
            </div>
        }
        <div class="col-md-6">
            <label class="form-label small fw-bold text-muted">Alıcı Ad Soyad</label>
            <input type="text" name="AliciAdSoyad" class="form-control" required placeholder="Alıcının Adı Soyadı" />
        </div>
        <div class="col-md-6">
            <label class="form-label small fw-bold text-muted">Alıcı Telefon</label>
            <input type="tel" name="AliciTelefon" class="form-control" required placeholder="05XXXXXXXXX" />
        </div>
        <div class="col-md-6">
            <label class="form-label small fw-bold text-muted">Gönderim Yeri Adı</label>
            <input type="text" name="GonderimYeriAdi" class="form-control" required placeholder="Örn: Ev, İş Yeri, Hastane vb." />
        </div>
        <div class="col-md-6">
            <label class="form-label small fw-bold text-muted">Teslimat Bölgesi (Sistem Seçimi)</label>
            <input type="text" class="form-control bg-light" value="@teslimatBolgesiStr" readonly />
        </div>
        <div class="col-12">
            <label class="form-label small fw-bold text-muted">Teslimat Açık Adresi</label>
            <textarea name="TeslimatAdresi" class="form-control" rows="2" required placeholder="Mahalle, Cadde, Sokak, Bina No, Kat / Daire"></textarea>
        </div>
    </div>
</div>
<script>
    document.getElementById('kayitli-adres-secimi')?.addEventListener('change', function () {
        const secili = this.selectedOptions[0];
        if (!secili?.value) return;
        const alanlar = { AliciAdSoyad: secili.dataset.alici, AliciTelefon: secili.dataset.telefon,
            GonderimYeriAdi: secili.dataset.baslik, TeslimatAdresi: secili.dataset.adres };
        for (const [ad, deger] of Object.entries(alanlar)) {
            const input = document.querySelector(`[name="${ad}"]`);
            if (input) input.value = deger || '';
        }
    });
</script>
