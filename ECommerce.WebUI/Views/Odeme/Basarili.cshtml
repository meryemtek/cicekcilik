@model ECommerce.Application.DTOs.Siparis.SiparisDetayDto
@{
    ViewData["Title"] = "Sipariş Başarılı";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container my-5 text-center">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="payment-card p-5 shadow-sm rounded-4 bg-white border">
                <div class="mb-4">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                </div>
                <h1 class="fw-bold text-dark mb-2" style="letter-spacing: -0.5px;">Siparişiniz Başarıyla Alındı!</h1>
                <p class="text-muted fs-5 mb-4">Sipariş Numaranız: <strong class="text-dark font-monospace">@Model.SiparisNumarasi</strong></p>

                <div class="alert alert-light border text-start p-4 mb-4 rounded-3">
                    <h6 class="fw-bold text-dark mb-3"><i class="bi bi-info-circle me-1 text-primary"></i> Sipariş Özeti ve Teslimat Bilgileri</h6>
                    <div class="row g-2 small text-muted">
                        <div class="col-md-6"><strong>Alıcı:</strong> @Model.AliciAdSoyad</div>
                        <div class="col-md-6"><strong>Alıcı Telefon:</strong> @Model.AliciTelefon</div>
                        <div class="col-12"><strong>Teslimat Adresi:</strong> @Model.TeslimatAdresi</div>
                        <div class="col-md-6 mt-2"><strong>Ödeme Yöntemi:</strong> @Model.OdemeYontemi</div>
                        <div class="col-md-6 mt-2"><strong>Toplam Tutar:</strong> <span class="text-dark fw-bold">₺@Model.ToplamTutar.ToString("N2")</span></div>
                        @if (!string.IsNullOrEmpty(Model.KartNotu))
                        {
                            <div class="col-12 mt-2"><strong>Kart Notu:</strong> "@Model.KartNotu" (@(string.IsNullOrEmpty(Model.GonderenGorunenAd) ? "İsimsiz" : Model.GonderenGorunenAd))</div>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-center gap-3">
                    <a href="/" class="btn btn-outline-dark px-4 py-2 rounded-pill fw-semibold">Anasayfaya Dön</a>
                    <a href="/Kullanici/Siparislerim" class="btn text-white px-4 py-2 rounded-pill fw-semibold" style="background-color: #3b1154;">Siparişlerimi Görüntüle</a>
                </div>
            </div>
        </div>
    </div>
</div>