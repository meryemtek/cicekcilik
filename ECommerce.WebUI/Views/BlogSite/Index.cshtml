@model List<ECommerce.Application.DTOs.Blog.BlogListeDto>
@{
    ViewData["Title"] = "Çiçek Rehberi ve Blog Yazıları";

    // Sidebar için Linq filtrelemeleri
    var enCokOkunanlar = Model.OrderByDescending(x => x.OkunmaSayisi).Take(5).ToList();
    var sonYazilar = Model.OrderByDescending(x => x.YayinlanmaTarihi).Take(5).ToList();
}

<div class="container py-5">
    <!-- Sayfa Başlığı -->
    <div class="text-center mb-5">
        <div class="d-inline-flex align-items-center gap-2 mb-2 px-3 py-1 rounded-pill" style="background: rgba(139, 0, 40, 0.08); color: var(--site-primary); font-size: 0.75rem; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase;">
            <i class="bi bi-flower1"></i> LİDYA ÇİÇEKÇİLİK BLOG
        </div>
        <h1 class="fw-bold display-6" style="color: #24213d; letter-spacing: -0.5px;">Çiçek Bakımı ve Öneri Rehberi</h1>
        <p class="text-muted mt-2" style="max-width: 600px; margin: 0 auto; font-size: 0.95rem;">
            Sevdiklerinize en uygun hediyeyi seçmeniz ve çiçeklerinizin ömrünü uzatmanız için hazırladığımız yazılar.
        </p>
    </div>

    <div class="row g-4">
        <!-- SOL TARAF: Blog Yazıları Listesi (Geniş Alan) -->
        <div class="col-lg-8">
            @if (Model != null && Model.Any())
            {
                <div class="row g-4">
                    @foreach (var blog in Model)
                    {
                        <div class="col-md-6">
                            <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative blog-custom-card">
                                <div class="position-relative overflow-hidden" style="height: 200px;">
                                    @if (!string.IsNullOrEmpty(blog.GorselUrl))
                                    {
                                        <img src="@blog.GorselUrl" class="w-100 h-100 object-fit-cover blog-card-img" alt="@blog.Baslik">
                                    }
                                    else
                                    {
                                        <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center text-muted">
                                            <i class="bi bi-image fs-1"></i>
                                        </div>
                                    }
                                    <div class="position-absolute bottom-0 start-0 m-3 px-3 py-1 rounded-pill text-white small fw-semibold" style="background: rgba(36, 33, 61, 0.75); backdrop-filter: blur(6px); font-size: 0.7rem;">
                                        <i class="bi bi-calendar3 me-1"></i> @blog.YayinlanmaTarihi.ToString("dd MMM yyyy")
                                    </div>
                                </div>
                                <div class="card-body p-4 d-flex flex-column">
                                    <h5 class="fw-bold mb-2 blog-card-title">
                                        <a href="/blog/@blog.SeoUrl" class="text-decoration-none text-dark stretched-link">
                                            @blog.Baslik
                                        </a>
                                    </h5>
                                    <p class="text-muted small mb-4 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                        @blog.Ozet
                                    </p>
                                    <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
                                        <span class="text-muted small"><i class="bi bi-eye text-danger"></i> @blog.OkunmaSayisi okuma</span>
                                        <a href="/blog/@blog.SeoUrl" class="btn btn-sm rounded-pill px-3 py-1 text-white fw-semibold blog-read-btn" style="background-color: var(--site-primary); z-index: 2; position: relative; text-decoration: none;">
                                            Oku <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
                    <i class="bi bi-journal-x fs-1 text-muted mb-3 d-block"></i>
                    <h5 class="fw-bold text-dark">Henüz Yayımlanmış Yazı Bulunmuyor</h5>
                    <p class="text-muted small">Çok yakında faydalı içeriklerimizle burada olacağız.</p>
                </div>
            }
        </div>

        <!-- SAĞ TARAF: Sidebar (En Çok Okunanlar & Son Yazılar) -->
        <div class="col-lg-4">

            <!-- Widget 1: En Çok Okunanlar -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-white">
                <h5 class="fw-bold mb-3 pb-2 border-bottom" style="color: #24213d; font-size: 1.1rem;">
                    <i class="bi bi-fire text-danger me-2"></i> En Çok Okunanlar
                </h5>
                <div class="d-flex flex-column gap-3">
                    @if (enCokOkunanlar.Any())
                    {
                        foreach (var pop in enCokOkunanlar)
                        {
                            <a href="/blog/@pop.SeoUrl" class="d-flex align-items-center gap-3 text-decoration-none sidebar-item">
                                <img src="@pop.GorselUrl" class="rounded-3 object-fit-cover" style="width: 60px; height: 60px;" alt="">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1" style="font-size: 0.9rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@pop.Baslik</h6>
                                    <span class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-eye"></i> @pop.OkunmaSayisi görüntülenme</span>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Henüz yeterli veri yok.</p>
                    }
                </div>
            </div>

            <!-- Widget 2: Son Eklenenler -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                <h5 class="fw-bold mb-3 pb-2 border-bottom" style="color: #24213d; font-size: 1.1rem;">
                    <i class="bi bi-clock-history text-primary me-2"></i> Son Eklenen Yazılar
                </h5>
                <div class="d-flex flex-column gap-3">
                    @if (sonYazilar.Any())
                    {
                        foreach (var son in sonYazilar)
                        {
                            <a href="/blog/@son.SeoUrl" class="d-flex align-items-center gap-3 text-decoration-none sidebar-item">
                                <img src="@son.GorselUrl" class="rounded-3 object-fit-cover" style="width: 60px; height: 60px;" alt="">
                                <div>
                                    <h6 class="fw-bold text-dark mb-1" style="font-size: 0.9rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">@son.Baslik</h6>
                                    <span class="text-muted" style="font-size: 0.75rem;"><i class="bi bi-calendar3"></i> @son.YayinlanmaTarihi.ToString("dd MMM yyyy")</span>
                                </div>
                            </a>
                        }
                    }
                    else
                    {
                        <p class="text-muted small mb-0">Henüz yazı bulunmuyor.</p>
                    }
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .blog-custom-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        border: 1px solid #eee9ed !important;
        background: #fff;
    }

        .blog-custom-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(35, 28, 40, 0.08) !important;
        }

            .blog-custom-card:hover .blog-card-img {
                transform: scale(1.05);
            }

    .blog-card-img {
        transition: transform 0.4s ease;
    }

    .sidebar-item {
        transition: transform 0.2s ease;
    }

        .sidebar-item:hover {
            transform: translateX(4px);
        }

            .sidebar-item:hover h6 {
                color: var(--site-primary) !important;
            }
</style>