@model ECommerce.Application.DTOs.Blog.BlogGuncelleDto
@{
    ViewData["Title"] = Model.Baslik;
    
    // SEO Meta Etiketleri için dinamik atama (Eğer Layout'un bu ViewData'ları destekliyorsa)
    ViewData["MetaBaslik"] = !string.IsNullOrEmpty(Model.MetaBaslik) ? Model.MetaBaslik : Model.Baslik;
    ViewData["MetaAciklama"] = !string.IsNullOrEmpty(Model.MetaAciklama) ? Model.MetaAciklama : Model.Ozet;
}

<div class="blog-detail-page py-5">
    <div class="container" style="max-width: 900px;">
        
        <!-- Geri Dön Butonu ve Kategori Rozeti -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <a href="/" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-2 fw-semibold back-link">
                <i class="bi bi-arrow-left"></i> Ana Sayfaya Dön
            </a>
            <span class="badge px-3 py-2 rounded-pill fw-semibold" style="background: rgba(139, 0, 40, 0.08); color: var(--site-primary);">
                <i class="bi bi-flower1 me-1"></i> Çiçek Rehberi
            </span>
        </div>

        <!-- Başlık ve Meta Bilgileri -->
        <div class="text-center mb-5">
            <h1 class="fw-bold display-5 mb-3" style="color: #24213d; letter-spacing: -1px; line-height: 1.2;">
                @Model.Baslik
            </h1>
            
            <div class="d-flex justify-content-center align-items-center gap-4 text-muted small">
                <span><i class="bi bi-calendar3 me-1"></i> @Model.YayinlanmaTarihi.ToString("dd MMMM yyyy")</span>
                <span>•</span>
                <span><i class="bi bi-eye me-1"></i> @Model.OkunmaSayisi Görüntülenme</span>
            </div>
        </div>

        <!-- Kapak Görseli -->
        @if (!string.IsNullOrEmpty(Model.GorselUrl))
        {
            <div class="mb-5 overflow-hidden rounded-4 shadow-sm" style="max-height: 450px;">
                <img src="@Model.GorselUrl" class="w-100 h-100 object-fit-cover" alt="@Model.Baslik" />
            </div>
        }

        <!-- Özet / Giriş Paragrafı -->
        @if (!string.IsNullOrEmpty(Model.Ozet))
        {
            <div class="lead fw-semibold p-4 rounded-4 mb-4" style="background: #faf9fa; border-left: 4px solid var(--site-primary); color: #44394b; line-height: 1.6;">
                @Model.Ozet
            </div>
        }

        <!-- Zengin Metin (HTML) İçerik Alanı -->
        <div class="blog-html-content fs-5 text-secondary" style="line-height: 1.9; color: #4a4552;">
            @Html.Raw(Model.Icerik)
        </div>

        <!-- Alt Paylaşım / İlgi Çekici Alan -->
        <div class="mt-5 pt-4 border-top d-flex justify-content-between align-items-center">
            <div class="text-muted small">
                <i class="bi bi-share me-1"></i> Bu yazıyı sevdiklerinizle paylaşabilirsiniz.
            </div>
            <a href="/" class="btn btn-sm rounded-pill px-4 text-white fw-semibold" style="background-color: var(--site-primary);">
                Alışverişe Başla
            </a>
        </div>
    </div>
</div>

<style>
    .back-link:hover {
        color: var(--site-primary) !important;
    }
    /* CKEditor üzerinden gelen HTML içeriklerin şık durması için stiller */
    .blog-html-content img {
        max-width: 100% !important;
        height: auto !important;
        border-radius: 12px;
        margin: 25px 0;
        box-shadow: 0 8px 25px rgba(35, 28, 40, 0.08);
    }
    .blog-html-content h2, 
    .blog-html-content h3, 
    .blog-html-content h4 {
        color: #24213d;
        font-weight: 700;
        margin-top: 35px;
        margin-bottom: 15px;
    }
    .blog-html-content p {
        margin-bottom: 20px;
    }
    .blog-html-content ul, 
    .blog-html-content ol {
        margin-bottom: 20px;
        padding-left: 20px;
    }
</style>