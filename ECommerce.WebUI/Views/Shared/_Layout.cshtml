@inject System.Net.Http.IHttpClientFactory HttpClientFactory
@using System.Text.Json
@using ECommerce.Application.DTOs.SiteAyari

@{
    string temaRengi = "#8b0028"; // Varsayılan Bordo
    try
    {
        var client = HttpClientFactory.CreateClient("ApiClient");
        var response = client.GetAsync("siteayarlari/site-ayarlari").Result;
        if (response.IsSuccessStatusCode)
        {
            var content = response.Content.ReadAsStringAsync().Result;
            var ayarlar = JsonSerializer.Deserialize<SiteAyariDto>(content, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (ayarlar != null && !string.IsNullOrEmpty(ayarlar.TemaRengiHex))
            {
                temaRengi = ayarlar.TemaRengiHex;
            }
        }
    }
    catch
    {
        // Bağlantı hatası durumunda varsayılan renk ile devam eder
    }
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Lidya Çiçekçilik | Elazığ Çiçekçi</title>

    <meta name="description"
          content="Lidya Çiçekçilik, Elazığ'da çiçek siparişi ve çiçek gönderimi hizmeti sunar. Gül, buket, orkide, aranjman ve özel gün çiçekleri için Lidya Çiçekçilik." />

    <meta name="robots" content="index, follow" />

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <style>
        /* =========================================================
                       DİNAMİK TEMA RENGİ ENTEGRASYONU
                       ========================================================= */
        :root {
            --site-primary: @temaRengi !important;
            --site-primary-hover: @(temaRengi)dd !important;
        }

        .search-box-container .input-group {
            border: 2px solid var(--site-primary) !important;
        }

        .search-box-container button {
            background-color: var(--site-primary) !important;
        }

            .search-box-container button:hover {
                background-color: var(--site-primary-hover) !important;
            }

        .header-top-bar a:hover,
        .user-actions a:hover,
        .header-nav .nav-link:hover {
            color: var(--site-primary) !important;
        }

        .btn-primary,
        .slider-action-btn,
        .category-banner-card span,
        .card .btn,
        button[type="submit"],
        .btn-success {
            background: linear-gradient(135deg, var(--site-primary), var(--site-primary-hover)) !important;
            border-color: var(--site-primary) !important;
            background-color: var(--site-primary) !important;
        }

            .btn-primary:hover,
            .slider-action-btn:hover,
            .card .btn:hover {
                background-color: var(--site-primary-hover) !important;
                border-color: var(--site-primary-hover) !important;
            }

        .btn-gunu-guzellestir {
            background-color: var(--site-primary) !important;
            border-color: var(--site-primary) !important;
            color: #fff !important;
            transition: all 0.3s ease;
        }

            .btn-gunu-guzellestir:hover {
                background-color: var(--site-primary-hover) !important;
            }

        .teslimat-metni {
            color: var(--site-primary) !important;
            font-weight: 500;
        }

        .teslimat-ikonu {
            color: var(--site-primary) !important;
        }

        /* =========================================================
                       YAPIŞKAN (STICKY) HEADER MİMARİSİ
                       ========================================================= */
        .sticky-header-wrapper {
            position: sticky;
            top: 0;
            z-index: 1030;
            background-color: #fff;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        }

        /* =========================================================
                       MOBİL OFFCANVAS MENÜ ÖZELLEŞTİRMELERİ
                       ========================================================= */
        #mobileMenuOffcanvas .navbar-nav {
            flex-direction: column !important;
            width: 100%;
            gap: 0 !important;
        }

        #mobileMenuOffcanvas .nav-item {
            border-bottom: 1px solid #f2edeo;
            width: 100%;
        }

        #mobileMenuOffcanvas .nav-link {
            padding: 12px 20px !important;
            font-weight: 600;
            color: #333 !important;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            #mobileMenuOffcanvas .nav-link:hover {
                background-color: #faf7fa;
                color: var(--site-primary) !important;
            }

        /* =========================================================
                       DİĞER ÖN YÜZ STİLLERİ
                       ========================================================= */
        .header-top-bar {
            background-color: #f8f9fa;
            font-size: 0.85rem;
            color: #6c757d;
            border-bottom: 1px solid #eaeaea;
        }

            .header-top-bar a {
                color: #6c757d;
                text-decoration: none;
                transition: color 0.2s;
            }

        .header-main {
            padding: 15px 0;
            background: #fff;
        }

        .search-box-container input {
            border: none;
            box-shadow: none !important;
            padding-left: 20px;
        }

        .search-box-container button {
            color: #fff;
            border: none;
            padding: 0 25px;
        }

        .user-actions a {
            color: #333;
            text-decoration: none;
            font-size: 0.85rem;
            text-align: center;
            transition: color 0.2s;
        }

        .user-actions i {
            font-size: 1.25rem;
            display: block;
            margin-bottom: 2px;
        }

        .header-nav {
            border-top: 0;
            border-bottom: 1px solid #eee4e1;
            background: #fcf9f8;
        }

        .flower-category-nav { overflow: visible; }
        .flower-category-nav > .container { display: flex; align-items: center; gap: 8px; }
        .flower-category-mobile-toggle { flex: 0 0 auto; border: 0; border-radius: 9px; color: #454545; }
        .flower-category-list { display: flex; align-items: stretch; justify-content: space-between; gap: 8px; width: 100%; margin: 0; padding: 0; list-style: none; }
        .flower-category-item { position: relative; flex: 0 0 auto; }
        .flower-category-link { position: relative; display: inline-flex; align-items: center; gap: 9px; min-height: 54px; padding: 0 10px; color: #454545; font-size: .86rem; font-weight: 600; letter-spacing: .02em; text-decoration: none; white-space: nowrap; transition: color .18s ease; }
        .flower-category-link::after { content: ''; position: absolute; right: 10px; bottom: 5px; left: 10px; height: 2px; border-radius: 2px; background: #984255; transform: scaleX(0); transition: transform .18s ease; }
        .flower-category-link i { color: #9c7b84; font-size: 1rem; }
        .flower-category-item:hover > .flower-category-link, .flower-category-item:focus-within > .flower-category-link { color: #984255; }
        .flower-category-item:hover > .flower-category-link i, .flower-category-item:focus-within > .flower-category-link i { color: #984255; }
        .flower-category-item:hover > .flower-category-link::after, .flower-category-item:focus-within > .flower-category-link::after, .flower-category-item.featured > .flower-category-link::after { transform: scaleX(1); }
        .flower-category-item.featured > .flower-category-link, .flower-category-item.featured > .flower-category-link i { color: #a34c9e; }
        .flower-category-submenu { position: absolute; z-index: 1040; top: 100%; left: 0; display: flex; flex-direction: column; min-width: 220px; padding: 8px; border: 1px solid #eee5e7; border-radius: 0 0 10px 10px; background: #fff; box-shadow: 0 12px 24px rgba(31, 49, 39, .13); opacity: 0; visibility: hidden; transform: translateY(5px); transition: opacity .16s ease, transform .16s ease, visibility .16s ease; }
        .flower-category-item:hover .flower-category-submenu, .flower-category-item:focus-within .flower-category-submenu { opacity: 1; visibility: visible; transform: translateY(0); }
        .flower-category-submenu a { padding: 9px 12px; border-radius: 6px; color: #4e514f; font-size: .86rem; text-decoration: none; white-space: nowrap; }
        .flower-category-submenu a:hover, .flower-category-submenu a:focus-visible { background: #f8f3f5; color: #984255; outline: none; }
        .flower-category-link:focus-visible { outline: 2px solid #984255; outline-offset: -3px; }

        @@media (max-width: 991.98px) {
            .flower-category-nav { overflow: visible; }
            .flower-category-mobile-toggle { order: 2; background: #f0e8e4; }
            .flower-category-list { flex: 1 1 auto; justify-content: flex-start; gap: 12px; width: auto; min-width: 0; overflow-x: auto; padding-right: 12px; scrollbar-width: none; }
            .flower-category-list::-webkit-scrollbar { display: none; }
            .flower-category-link { min-height: 48px; padding: 0 8px; font-size: .82rem; }
            .flower-category-submenu { position: fixed; top: auto; left: 12px; right: 12px; bottom: auto; flex-direction: row; flex-wrap: wrap; min-width: 0; border-radius: 10px; }
        }

        .local-seo-section {
            background: #fbfafc;
            border-top: 1px solid #eeeaf0;
            border-bottom: 1px solid #eeeaf0;
            padding: 55px 0 50px;
            margin-top: 20px;
        }

        .local-seo-wrapper {
            max-width: 1180px;
            margin: 0 auto;
        }

        .local-seo-content {
            background: #fff;
            border: 1px solid #eee9ef;
            border-radius: 18px;
            padding: 35px 40px;
            box-shadow: 0 8px 30px rgba(50, 35, 60, 0.035);
        }

        .local-seo-label {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            color: var(--site-primary);
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 1.4px;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .local-seo-title {
            color: #292336;
            font-size: 1.55rem;
            font-weight: 700;
            line-height: 1.35;
            margin-bottom: 16px;
        }

        .local-seo-content p {
            color: #69636d;
            font-size: 0.94rem;
            line-height: 1.85;
            margin-bottom: 14px;
        }

        .local-seo-content h3 {
            color: #393143;
            font-size: 1.08rem;
            font-weight: 700;
            margin-top: 28px;
            margin-bottom: 9px;
        }

        .local-seo-content strong {
            color: #44394b;
            font-weight: 600;
        }

        .local-seo-divider {
            height: 1px;
            background: #eeeaf0;
            margin: 25px 0;
        }

        .site-footer {
            background: #29252d;
            color: #fff;
        }

            .site-footer a {
                transition: color .2s ease;
            }

                .site-footer a:hover {
                    color: var(--site-primary) !important;
                }

        body, button, input, textarea, select { font-family: 'Outfit', sans-serif; }
        h1, h2, h3, h4, h5, h6 { font-family: 'Playfair Display', Georgia, serif; font-weight: 500; }
        body { margin-bottom: 0 !important; }
    </style>
</head>

<body>

    <!-- =========================================================
         1. ÜST BAR
    ========================================================= -->
    @await Component.InvokeAsync("HeaderInfo")

    @if (ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index")
    {
        @await Component.InvokeAsync("DuyuruBand")
    }


    <!-- =========================================================
         YAPIŞKAN ALAN BAŞLANGICI (LOGO/ARAMA + ANA MENÜ)
    ========================================================= -->
    <div class="sticky-header-wrapper">

        <!-- 3. LOGO / ARAMA / KULLANICI -->
        @await Component.InvokeAsync("HeaderMain")


        <!-- 4. ÇİÇEK KATEGORİ MENÜSÜ -->
        <nav class="header-nav flower-category-nav" aria-label="Çiçek kategorileri">
            <div class="container">
                <button class="navbar-toggler flower-category-mobile-toggle d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenuOffcanvas" aria-controls="mobileMenuOffcanvas" aria-label="Diğer menü bağlantılarını aç">
                    <i class="bi bi-list fs-4" aria-hidden="true"></i>
                </button>
                <ul class="flower-category-list">
                    <li class="flower-category-item">
                        <a class="flower-category-link" href="/urunler"><i class="bi bi-gift" aria-hidden="true"></i> ÇİÇEK</a>
                        <div class="flower-category-submenu">
                            <a href="/urunler">Tüm Çiçekler</a><a href="/Arama?q=Gül">Gül Buketleri</a><a href="/Arama?q=Orkide">Orkideler</a><a href="/Arama?q=Saksı%20Çiçeği">Saksı Çiçekleri</a>
                        </div>
                    </li>
                    <li class="flower-category-item featured">
                        <a class="flower-category-link" href="/Arama?q=Yapay%20Çiçek"><i class="bi bi-flower3" aria-hidden="true"></i> YAPAY ÇİÇEK</a>
                        <div class="flower-category-submenu">
                            <a href="/Arama?q=Yapay%20Çiçek">Tüm Yapay Çiçekler</a><a href="/Arama?q=Yapay%20Gül">Yapay Gül</a><a href="/Arama?q=Yapay%20Orkide">Yapay Orkide</a>
                        </div>
                    </li>
                    <li class="flower-category-item">
                        <a class="flower-category-link" href="/Arama?q=Premium%20Çiçek"><i class="bi bi-stars" aria-hidden="true"></i> PREMIUM ÇİÇEK</a>
                        <div class="flower-category-submenu">
                            <a href="/Arama?q=Premium%20Çiçek">Premium Tasarımlar</a><a href="/Arama?q=Özel%20Buket">Özel Tasarım Buketler</a><a href="/Arama?q=VIP">VIP Aranjmanlar</a>
                        </div>
                    </li>
                    <li class="flower-category-item">
                        <a class="flower-category-link" href="/Arama?q=Ayıcık"><i class="bi bi-flower1" aria-hidden="true"></i> AYICIK</a>
                        <div class="flower-category-submenu"><a href="/Arama?q=Ayıcık">Ayıcık Hediyeleri</a><a href="/Arama?q=Peluş">Peluş Oyuncaklar</a></div>
                    </li>
                    <li class="flower-category-item">
                        <a class="flower-category-link" href="/Arama?q=Balon"><i class="bi bi-balloon" aria-hidden="true"></i> BALON KUTUSU</a>
                        <div class="flower-category-submenu"><a href="/Arama?q=Balon">Balonlar</a><a href="/Arama?q=Balon%20Kutusu">Balon Kutuları</a><a href="/Arama?q=Hediye%20Kutusu">Hediye Kutuları</a></div>
                    </li>
                    <li class="flower-category-item">
                        <a class="flower-category-link" href="/Arama?q=Sevgiliye"><i class="bi bi-heart" aria-hidden="true"></i> SEVGİLİYE</a>
                        <div class="flower-category-submenu"><a href="/Arama?q=Sevgiliye%20Çiçek">Sevgiliye Çiçek</a><a href="/Arama?q=Gül">Gül Buketleri</a><a href="/Arama?q=Yıldönümü">Yıldönümü Hediyeleri</a></div>
                    </li>
                    <li class="flower-category-item">
                        <a class="flower-category-link" href="/Arama?q=Doğum%20Günü"><i class="bi bi-emoji-smile" aria-hidden="true"></i> GÖNDERİM AMACI</a>
                        <div class="flower-category-submenu"><a href="/Arama?q=Doğum%20Günü">Doğum Günü</a><a href="/Arama?q=Geçmiş%20Olsun">Geçmiş Olsun</a><a href="/Arama?q=Açılış">Açılış</a><a href="/Arama?q=Yeni%20Bebek">Yeni Bebek</a></div>
                    </li>
                    <li class="flower-category-item">
                        <a class="flower-category-link" href="/Arama?q=Butik%20Çiçek"><i class="bi bi-flower2" aria-hidden="true"></i> BUTİK ÇİÇEKLER</a>
                        <div class="flower-category-submenu"><a href="/Arama?q=Butik%20Çiçek">Butik Tasarımlar</a><a href="/Arama?q=Karışık%20Buket">Karışık Buketler</a><a href="/Arama?q=Orkide">Orkide Aranjmanları</a></div>
                    </li>
                </ul>
            </div>
        </nav>

    </div>
    <!-- =========================================================
         YAPIŞKAN ALAN BİTİŞİ
    ========================================================= -->
    <!-- =========================================================
         MOBİL OFF-CANVAS MENÜ ÇEKMECESİ (DRAWER)
    ========================================================= -->
    <div class="offcanvas offcanvas-start" tabindex="-1" id="mobileMenuOffcanvas" aria-labelledby="mobileMenuOffcanvasLabel">
        <div class="offcanvas-header border-bottom px-4 py-3">
            <h5 class="offcanvas-title fw-bold" id="mobileMenuOffcanvasLabel" style="color: var(--site-primary);">Lidya Çiçekçilik</h5>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
        </div>
        <div class="offcanvas-body p-0">
            <!-- Mobil Hızlı İşlemler Kısmı -->
            <div class="p-3 bg-light border-bottom d-flex justify-content-around text-center">
                <a href="/Hesap/Index" class="text-decoration-none text-dark small">
                    <i class="bi bi-person fs-5 d-block text-secondary"></i> Profilim
                </a>
                <a href="/Sepet" class="text-decoration-none text-dark small">
                    <i class="bi bi-cart3 fs-5 d-block text-secondary"></i> Sepet
                </a>
                <a href="/Favoriler" class="text-dark text-decoration-none position-relative d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <i class="bi bi-heart fs-5"></i>
                    <!-- İsteğe bağlı sayaç rozeti eklemek istersen: -->
                     <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="favoriSayac">0</span>
                </a>
            </div>

            <!-- Dinamik Menü Öğeleri -->
            <div class="mobile-menu-container">
                @await Component.InvokeAsync("Menu", new { konum = "Header" })
            </div>
        </div>
    </div>


    <!-- =========================================================
         ANA İÇERİK
    ========================================================= -->
    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- =========================================================
         FOOTER
    ========================================================= -->
    @await Component.InvokeAsync("Footer")

    <!-- Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.addEventListener('click', function (e) {
            const button = e.target.closest('.btn-favori');
            if (!button) return;

            const urunId = button.getAttribute('data-urun-id');
            const icon = button.querySelector('i');

            if (!urunId) return;

            fetch('/Favoriler/Toggle', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ urunId: urunId })
            })
                .then(async res => {
                    console.log("Sunucu Yanıt Durumu (Status):", res.status);

                    if (res.status === 401 || res.redirected) {
                        window.location.href = '/Hesap/Giris';
                        return null;
                    }

                    const text = await res.text();
                    try {
                        return JSON.parse(text);
                    } catch (err) {
                        console.error("JSON Ayrıştırma Hatası. Sunucudan Gelen Ham Metin:", text);
                        return null;
                    }
                })
                .then(data => {
                    if (!data) return;

                    if (data.eklendiMi) {
                        icon.classList.remove('bi-heart');
                        icon.classList.add('bi-heart-fill');
                        icon.style.color = '#dc3545';
                    } else {
                        icon.classList.remove('bi-heart-fill');
                        icon.classList.add('bi-heart');
                        icon.style.color = '';
                    }
                })
                .catch(err => console.error('Fetch Kritik Hatası:', err));
        });
    </script>
    <script>
        // Sayfa yüklendiğinde favori ürünleri kontrol edip kalpleri senkronize eder
        document.addEventListener("DOMContentLoaded", function () {
            fetch('/Favoriler/GetFavoriIdList')
                .then(res => res.json())
                .then(favoriIds => {
                    if (!Array.isArray(favoriIds)) return;

                    document.querySelectorAll('.btn-favori').forEach(button => {
                        const urunId = button.getAttribute('data-urun-id');
                        const icon = button.querySelector('i');
                        if (!urunId || !icon) return;

                        // Eğer ürün kullanıcının favorilerindeyse kalbi doldur
                        if (favoriIds.includes(urunId)) {
                            icon.classList.remove('bi-heart');
                            icon.classList.add('bi-heart-fill');
                            icon.style.color = '#dc3545';
                        } else {
                            icon.classList.remove('bi-heart-fill');
                            icon.classList.add('bi-heart');
                            icon.style.color = '';
                        }
                    });
                })
                .catch(err => console.error("Favori senkronizasyon hatası:", err));
        });

        // Kalp butonuna tıklandığında ekleme/çıkarma işlemini yöneten global dinleyici
        document.addEventListener('click', function (e) {
            const button = e.target.closest('.btn-favori');
            if (!button) return;

            const urunId = button.getAttribute('data-urun-id');
            const icon = button.querySelector('i');

            if (!urunId) return;

            fetch('/Favoriler/Toggle', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ urunId: urunId })
            })
                .then(async res => {
                    if (res.status === 401 || res.redirected) {
                        return null;
                    }
                    const text = await res.text();
                    try {
                        return JSON.parse(text);
                    } catch (err) {
                        return null;
                    }
                })
                .then(data => {
                    if (!data) return;

                    if (data.eklendiMi) {
                        icon.classList.remove('bi-heart');
                        icon.classList.add('bi-heart-fill');
                        icon.style.color = '#dc3545';
                    } else {
                        icon.classList.remove('bi-heart-fill');
                        icon.classList.add('bi-heart');
                        icon.style.color = '';
                    }
                })
                .catch(err => console.error('Fetch Kritik Hatası:', err));
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
