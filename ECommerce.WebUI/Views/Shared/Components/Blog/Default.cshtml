@model List<ECommerce.Application.DTOs.Blog.BlogListeDto>

@if (Model != null && Model.Any())
{
    <section class="home-blog-section py-5 my-3">
        <div class="container">
            <!-- Bölüm Üst Başlığı (Flex Düzeniyle Profesyonel Görünüm) -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-5 gap-3">
                <div>
                    <div class="blog-section-eyebrow d-inline-flex align-items-center gap-2 mb-2 px-3 py-1 rounded-pill" style="background: rgba(139, 0, 40, 0.08); color: var(--site-primary); font-size: 0.75rem; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase;">
                        <i class="bi bi-flower1"></i> ÇİÇEK REHBERİ & İPUÇLARI
                    </div>
                    <h2 class="fw-bold display-6 mb-1" style="color: #24213d; letter-spacing: -0.5px;">Lidya Çiçekçilik'den Güncel Haberler</h2>
                    <p class="text-muted mb-0" style="font-size: 0.95rem;">
                        Çiçek bakımı, özel gün hediye önerileri ve taze tasarım trendleriyle ilgili en güncel yazılarımız.
                    </p>
                </div>
                <div>
                    <!-- Tüm Blog Yazılarına Yönlendiren Şık Buton -->
                    <a href="/blog" class="btn btn-outline-dark rounded-pill px-4 py-2 fw-semibold d-inline-flex align-items-center gap-2 blog-all-btn">
                        Tüm Yazıları Gör <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>

            <!-- Blog Kartları Grid -->
            <div class="row g-4">
                @foreach (var blog in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative blog-custom-card">

                            <!-- Kapak Görseli ve Tarih Rozeti -->
                            <div class="position-relative overflow-hidden" style="height: 220px;">
                                @if (!string.IsNullOrEmpty(blog.GorselUrl))
                                {
                                    <img src="@blog.GorselUrl" class="w-100 h-100 object-fit-cover blog-card-img transition-all" alt="@blog.Baslik">
                                }
                                else
                                {
                                    <div class="w-100 h-100 bg-light d-flex align-items-center justify-content-center text-muted">
                                        <i class="bi bi-image fs-1"></i>
                                    </div>
                                }

                                <!-- Şık Glassmorphism Tarih Rozeti -->
                                <div class="position-absolute bottom-0 start-0 m-3 px-3 py-1 rounded-pill text-white small fw-semibold" style="background: rgba(36, 33, 61, 0.75); backdrop-filter: blur(6px); font-size: 0.75rem;">
                                    <i class="bi bi-calendar3 me-1"></i> @blog.YayinlanmaTarihi.ToString("dd MMM yyyy")
                                </div>
                            </div>

                            <!-- İçerik Alanı -->
                            <div class="card-body p-4 d-flex flex-column">
                                <h5 class="fw-bold mb-2 blog-card-title">
                                    <a href="/blog/@blog.SeoUrl" class="text-decoration-none text-dark stretched-link">
                                        @blog.Baslik
                                    </a>
                                </h5>

                                <p class="text-muted small mb-4 flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; line-height: 1.6;">
                                    @blog.Ozet
                                </p>

                                <!-- Alt Bilgi ve Dinamik Buton -->
                                <div class="d-flex align-items-center justify-content-between pt-3 border-top mt-auto">
                                    <span class="text-muted small d-flex align-items-center gap-1">
                                        <i class="bi bi-eye text-danger"></i> @blog.OkunmaSayisi okuma
                                    </span>

                                    <a href="/blog/@blog.SeoUrl" class="btn btn-sm rounded-pill px-3 py-2 text-white fw-semibold blog-read-btn" style="background-color: var(--site-primary); border-color: var(--site-primary); z-index: 2; position: relative; text-decoration: none;">
                                        Devamını Oku <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>

    <style>
        .blog-custom-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            border: 1px solid #eee9ed !important;
            background: #fff;
        }

            .blog-custom-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 15px 35px rgba(35, 28, 40, 0.1) !important;
            }

                .blog-custom-card:hover .blog-card-img {
                    transform: scale(1.06);
                }

        .blog-card-img {
            transition: transform 0.5s ease;
        }

        .blog-card-title a:hover {
            color: var(--site-primary) !important;
        }

        .blog-read-btn {
            background: var(--site-primary) !important;
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

            .blog-read-btn:hover {
                opacity: 0.9;
                transform: translateX(3px);
            }

        /* Tüm Yazıları Gör Butonu Stil Entegrasyonu */
        .blog-all-btn {
            border-color: #ddd5da !important;
            color: #24213d !important;
            transition: all 0.25s ease;
        }

            .blog-all-btn:hover {
                background-color: var(--site-primary) !important;
                border-color: var(--site-primary) !important;
                color: #fff !important;
                transform: translateY(-2px);
            }
    </style>
}