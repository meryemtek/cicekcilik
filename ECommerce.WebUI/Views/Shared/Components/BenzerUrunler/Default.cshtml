@model List<ECommerce.Application.DTOs.Urun.UrunListeDto>

@if (Model != null && Model.Any())
{
    <div class="similar-products-section mt-5 pt-4 border-top">
        <div class="row">
            <div class="col-12 text-center">
                <!-- Başlık ortalandı -->
                <h4 class="fw-bold mb-4" style="color: #3b1154;">
                    <i class="bi bi-heart-fill text-danger me-2"></i>Bunları da Beğenebilirsiniz
                </h4>
            </div>
            @foreach (var urun in Model)
            {
                <div class="col-lg-3 col-md-6 col-sm-6 mb-4">
                    <div class="card h-100 border-0 shadow-sm product-card-hover" style="border-radius: 16px; overflow: hidden; transition: all 0.3s ease;">

                        <div style="height: 200px; background: #f8f9fa; overflow: hidden; position: relative;">
                            <a href="/urun/@urun.SeoUrl" class="text-decoration-none">
                                <img src="@(string.IsNullOrEmpty(urun.GorselUrl) ? "/images/no-image.jpg" : urun.GorselUrl)"
                                     class="w-100 h-100"
                                     style="object-fit: cover;"
                                     alt="@urun.Ad"
                                     onerror="this.src='/images/no-image.jpg';" />
                            </a>

                            <!-- Favori (Kalp) Butonu -->
                            <button type="button" class="btn-favori position-absolute top-0 end-0 m-2 rounded-circle bg-white shadow-sm border-0 d-flex align-items-center justify-content-center"
                                    style="width: 34px; height: 34px; z-index: 3;"
                                    data-urun-id="@urun.Id"
                                    title="Favorilere Ekle / Çıkar">
                                <i class="bi bi-heart text-danger" style="font-size: 1rem;"></i>
                            </button>
                        </div>

                        <div class="card-body d-flex flex-column justify-content-between p-3 bg-white">
                            <div>
                                <span class="badge bg-light text-purple mb-2 px-2 py-1" style="color: #3b1154; font-size: 0.75rem;">Özel Seçim</span>
                                <h6 class="fw-bold text-dark text-truncate mb-2" title="@urun.Ad">@urun.Ad</h6>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                                <span class="fw-bold fs-6 text-dark">@urun.Fiyat.ToString("N2") ₺</span>
                                <a href="/urun/@urun.SeoUrl" class="btn btn-sm text-white px-3 fw-bold" style="background: #3b1154; border-radius: 10px; font-size: 0.85rem;">İncele</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    <style>
        .product-card-hover:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(59, 17, 84, 0.1) !important;
        }
    </style>
}