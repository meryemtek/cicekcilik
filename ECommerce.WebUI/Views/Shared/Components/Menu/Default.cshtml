@model IEnumerable<ECommerce.Application.DTOs.Menu.MenuItemListeDto>

<ul class="navbar-nav">
    @foreach (var menu in Model)
    {
        <li class="nav-item @(menu.AltMenuler.Any() ? "dropdown" : "")">
            <a class="nav-link @(menu.AltMenuler.Any() ? "dropdown-toggle" : "")"
               href="@menu.Url"
               data-bs-toggle="@(menu.AltMenuler.Any() ? "dropdown" : "")">

                @if (!string.IsNullOrEmpty(menu.IconClass))
                {
                    <i class="bi @menu.IconClass me-1"></i>
                }
                @menu.Baslik
            </a>

            @if (menu.AltMenuler.Any())
            {
                <ul class="dropdown-menu">
                    @foreach (var alt in menu.AltMenuler)
                    {
                        <li><a class="dropdown-item" href="@alt.Url">@alt.Baslik</a></li>
                    }
                </ul>
            }
        </li>
    }
</ul>