@model List<ECommerce.Application.DTOs.Menu.MenuItemListeDto>

@if (Model != null && Model.Any())
{
    <ul class="list-unstyled small d-flex flex-column gap-2 mb-0">
        @{
            foreach (var menu in Model)
            {
                <li>
                    <a href="@menu.Url" target="@menu.Target" class="text-white-50 text-decoration-none footer-link d-flex align-items-center gap-1">
                        <i class="bi bi-chevron-right small"></i> @menu.Baslik
                    </a>
                </li>
            }
        }
        <li>
            <a href="/iletisim" class="text-white-50 text-decoration-none footer-link d-flex align-items-center gap-1">
                <i class="bi bi-chevron-right small"></i> Bize Ulaşın
            </a>
        </li>
    </ul>
}