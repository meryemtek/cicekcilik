@model List<ECommerce.Application.DTOs.Menu.MenuItemListeDto>

<ul class="footer-links-list">
    @if (Model != null && Model.Any())
    {
        foreach (var menu in Model)
        {
            <li>
                <a href="@menu.Url" target="@menu.Target">
                    <i class="bi bi-chevron-right"></i>
                    <span>@menu.Baslik</span>
                </a>
            </li>
        }
    }
    else
    {
        <li>
            <a href="/Hakkimizda">
                <i class="bi bi-chevron-right"></i>
                <span>Hakkımızda</span>
            </a>
        </li>
        <li>
            <a href="/Iletisim">
                <i class="bi bi-chevron-right"></i>
                <span>İletişim & Konum</span>
            </a>
        </li>
        <li>
            <a href="/BankaHesaplari">
                <i class="bi bi-chevron-right"></i>
                <span>Banka Hesaplarımız</span>
            </a>
        </li>
        <li>
            <a href="/BlogSite">
                <i class="bi bi-chevron-right"></i>
                <span>Çiçek Bakım Rehberi</span>
            </a>
        </li>
    }
</ul>