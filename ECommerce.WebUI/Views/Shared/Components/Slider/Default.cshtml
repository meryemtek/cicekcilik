@using ECommerce.Application.DTOs.Slider
@model List<SliderListeDto>

@{
    var sliderlar = Model?.Where(x => x.AktifMi).OrderBy(x => x.SiraNo).ToList() ?? new List<SliderListeDto>();
    if (!sliderlar.Any())
    {
        sliderlar = new List<SliderListeDto>
        {
            new() { Baslik = "Doğanın en naif formu, sanatla buluştu.", AltMetin = "Elazığ'ın taze çiçekleriyle hazırlanan buketler ve aranjmanlar, sevdiklerinize zarafetle ulaşıyor.", LinkUrl = "/Arama?q=Buket", ButonMetni = "Koleksiyonu keşfet", ResimUrl = "/images/anasayfa/hero.jpg" },
            new() { Baslik = "Her ana zarif bir dokunuş", AltMetin = "Sevgiyle seçilen çiçekler, sıradan bir günü unutulmaz bir ana dönüştürür.", LinkUrl = "/Arama?q=Orkide", ButonMetni = "Orkideleri keşfet" },
            new() { Baslik = "Sevdiklerinize çiçekli bir sürpriz", AltMetin = "Renkler ve kokular arasından size en yakın olanı bulun, güzel bir anı paylaşın.", LinkUrl = "/Arama?q=Gül", ButonMetni = "Gülleri keşfet" }
        };
    }
}

<section class="bf-hero" aria-label="Öne çıkan çiçekler">
    <div class="bf-container">
        <div id="floralHeroSlider" class="carousel slide bf-hero-carousel" data-bs-ride="carousel" data-bs-interval="6500" data-bs-pause="hover">
            <div class="carousel-inner">
                @for (var i = 0; i < sliderlar.Count; i++)
                {
                    var slider = sliderlar[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="bf-hero-slide">
                            <div class="bf-hero-copy">
                                <span class="bf-hero-badge"><i class="bi bi-flower1" aria-hidden="true"></i> Lidya Çiçekçilik</span>
                                @if (!string.IsNullOrWhiteSpace(slider.Baslik))
                                {
                                    <h2>@slider.Baslik</h2>
                                }
                                @if (!string.IsNullOrWhiteSpace(slider.AltMetin))
                                {
                                    <p>@slider.AltMetin</p>
                                }
                                @if (!string.IsNullOrWhiteSpace(slider.LinkUrl))
                                {
                                    <a href="@slider.LinkUrl" class="bf-hero-link">
                                        <span>@(string.IsNullOrWhiteSpace(slider.ButonMetni) ? "Çiçekleri keşfet" : slider.ButonMetni)</span>
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </a>
                                }
                                <ul class="bf-hero-trust">
                                    <li><i class="bi bi-clock" aria-hidden="true"></i><span><strong>Aynı gün teslimat</strong><small>Elazığ içi hızlı gönderim</small></span></li>
                                    <li><i class="bi bi-droplet" aria-hidden="true"></i><span><strong>Taze çiçek garantisi</strong><small>Günlük taze seçilir</small></span></li>
                                    <li><i class="bi bi-pencil-square" aria-hidden="true"></i><span><strong>Özel not kartı</strong><small>Her siparişe dahil</small></span></li>
                                </ul>
                            </div>
                            <div class="bf-hero-visual" aria-hidden="true">
                                @if (!string.IsNullOrWhiteSpace(slider.ResimUrl))
                                {
                                    <img src="@slider.ResimUrl" alt="" loading="@(i == 0 ? "eager" : "lazy")" />
                                }
                                else
                                {
                                    <div class="bf-hero-illustration">
                                        <span class="bf-hero-flower flower-back">✿</span>
                                        <span class="bf-hero-flower flower-main">✿</span>
                                        <span class="bf-hero-flower flower-front">❀</span>
                                        <span class="bf-hero-leaf leaf-left">❧</span>
                                        <span class="bf-hero-leaf leaf-right">❧</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (sliderlar.Count > 1)
            {
                <div class="bf-hero-indicators">
                    @for (var i = 0; i < sliderlar.Count; i++)
                    {
                        <button type="button" data-bs-target="#floralHeroSlider" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")" aria-label="@(i + 1). slayt" aria-current="@(i == 0 ? "true" : "false")"></button>
                    }
                </div>
                <div class="bf-hero-controls">
                    <button type="button" data-bs-target="#floralHeroSlider" data-bs-slide="prev" aria-label="Önceki slayt"><i class="bi bi-arrow-left" aria-hidden="true"></i></button>
                    <button type="button" data-bs-target="#floralHeroSlider" data-bs-slide="next" aria-label="Sonraki slayt"><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                </div>
            }
        </div>
    </div>
</section>

<style>
    .bf-hero { padding: 28px 0 40px; }
    .bf-hero-carousel { position: relative; overflow: hidden; border-radius: 28px; border: 1px solid rgba(232, 130, 150, .22); background: #fcf9f8; box-shadow: 0 12px 32px -4px rgba(26, 58, 47, .08), 0 4px 12px rgba(232, 130, 150, .08); }
    .bf-hero-slide { display: grid; grid-template-columns: 5fr 7fr; align-items: center; gap: 40px; min-height: 520px; padding: 48px 56px 64px; background: radial-gradient(circle at 92% 8%, rgba(255, 178, 190, .32), transparent 42%), radial-gradient(circle at 4% 96%, rgba(199, 235, 218, .45), transparent 40%), #fcf9f8; }
    .bf-hero-copy { position: relative; z-index: 1; }
    .bf-hero-badge { display: inline-flex; align-items: center; gap: 8px; padding: 7px 15px; border-radius: 999px; background: #ffd9de; color: #3f0015; font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .bf-hero-badge i { color: #984255; }
    .bf-hero-copy h2 { margin: 20px 0 16px; color: #02241a; font-family: 'Playfair Display', Georgia, serif !important; font-size: clamp(2rem, 3.6vw, 3rem); font-weight: 500; line-height: 1.16; letter-spacing: -.015em; }
    .bf-hero-copy p { max-width: 440px; margin: 0 0 26px; color: #414845; font-size: 1rem; font-weight: 300; line-height: 1.75; }
    .bf-hero-link { display: inline-flex; align-items: center; gap: 12px; padding: 14px 30px; border-radius: 999px; background: #1a3a2f; color: #fcf9f8; font-size: .76rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; text-decoration: none; box-shadow: 0 6px 16px rgba(26, 58, 47, .22); transition: background .25s ease, transform .25s ease, box-shadow .25s ease; }
    .bf-hero-link:hover { background: #02241a; color: #fff; transform: translateY(-2px); box-shadow: 0 10px 22px rgba(26, 58, 47, .3); }
    .bf-hero-trust { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; margin: 32px 0 0; padding: 22px 0 0; border-top: 1px solid rgba(254, 148, 168, .35); list-style: none; }
    .bf-hero-trust li { display: flex; align-items: flex-start; gap: 9px; }
    .bf-hero-trust i { color: #984255; font-size: 1.25rem; line-height: 1.2; }
    .bf-hero-trust strong { display: block; color: #02241a; font-size: .76rem; font-weight: 600; line-height: 1.3; }
    .bf-hero-trust small { display: block; margin-top: 2px; color: #727974; font-size: .68rem; line-height: 1.3; }
    .bf-hero-visual { position: relative; display: grid; place-items: center; justify-self: center; width: fit-content; max-width: 100%; min-width: 0; }
    .bf-hero-visual img { display: block; width: auto; height: auto; max-width: 100%; max-height: 440px; object-fit: contain; object-position: center; border-radius: 24px; border: 1px solid rgba(232, 130, 150, .2); box-shadow: 0 24px 44px -8px rgba(26, 58, 47, .16); }
    .bf-hero-illustration { position: relative; width: 100%; height: 440px; overflow: hidden; border-radius: 24px; background: radial-gradient(circle at 48% 40%, rgba(255, 255, 255, .95), rgba(255, 217, 222, .55) 60%, rgba(171, 206, 191, .55)); box-shadow: 0 24px 44px -8px rgba(26, 58, 47, .12); }
    .bf-hero-flower, .bf-hero-leaf { position: absolute; display: block; font-family: Georgia, serif !important; line-height: 1; }
    .bf-hero-flower { color: #d96391; }
    .flower-main { left: 33%; top: 14%; font-size: 14rem; transform: rotate(-13deg); }
    .flower-back { left: 5%; top: 32%; color: #984255; font-size: 9rem; transform: rotate(17deg); }
    .flower-front { right: 5%; bottom: 8%; color: #fe94a8; font-size: 9rem; transform: rotate(18deg); }
    .bf-hero-leaf { color: #456558; font-size: 9rem; }
    .leaf-left { left: 12%; bottom: -10%; transform: rotate(-22deg); }
    .leaf-right { right: 3%; top: -10%; transform: rotate(145deg); }
    .bf-hero-indicators { position: absolute; z-index: 2; left: 56px; bottom: 26px; display: flex; gap: 7px; }
    .bf-hero-indicators button { width: 7px; height: 7px; padding: 0; border: 0; border-radius: 50%; background: #c1c8c3; transition: width .2s ease, background .2s ease; }
    .bf-hero-indicators button.active { width: 24px; border-radius: 6px; background: #984255; }
    .bf-hero-controls { position: absolute; z-index: 2; right: 28px; bottom: 22px; display: flex; gap: 8px; }
    .bf-hero-controls button { display: grid; place-items: center; width: 38px; height: 38px; border: 1px solid rgba(26, 58, 47, .15); border-radius: 50%; background: rgba(252, 249, 248, .9); color: #1a3a2f; transition: background .2s ease, color .2s ease; }
    .bf-hero-controls button:hover { background: #1a3a2f; color: #fff; }
    @@media (max-width: 991px) {
        .bf-hero-slide { grid-template-columns: 1fr; gap: 28px; min-height: 0; padding: 40px 36px 72px; }
        .bf-hero-visual img { max-height: 320px; }
        .bf-hero-illustration { height: 320px; }
        .bf-hero-indicators { left: 36px; }
    }
    @@media (max-width: 575px) {
        .bf-hero { padding: 14px 0 28px; }
        .bf-hero-carousel { border-radius: 22px; }
        .bf-hero-slide { padding: 30px 22px 70px; }
        .bf-hero-trust { grid-template-columns: 1fr; gap: 10px; }
        .bf-hero-visual img { max-height: 230px; border-radius: 18px; }
        .bf-hero-illustration { height: 230px; }
        .flower-main { font-size: 9rem; } .flower-back, .flower-front, .bf-hero-leaf { font-size: 6rem; }
        .bf-hero-indicators { left: 22px; bottom: 28px; }
        .bf-hero-controls { right: 16px; bottom: 18px; }
    }
    @@media (prefers-reduced-motion: reduce) { .bf-hero-link, .bf-hero-indicators button { transition: none; } }
</style>
