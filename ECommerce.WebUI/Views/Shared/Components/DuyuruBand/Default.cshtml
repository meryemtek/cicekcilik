@model IEnumerable<ECommerce.Application.DTOs.Duyuru.DuyuruDto>

@{
    var duyurular = Model?.ToList() ?? new List<ECommerce.Application.DTOs.Duyuru.DuyuruDto>();
}

@if (ViewData["ApiYuklenemedi"] is true)
{
    <span data-api-load-error hidden></span>
}

@if (duyurular.Any())
{
    <section class="announcement-bar" aria-label="Duyurular">
        <div class="announcement-inner">
            <div class="announcement-viewport">
                <div class="announcement-track">
                    @foreach (var duyuru in duyurular)
                    {
                        <span class="announcement-item">
                            <i class="bi bi-flower1" aria-hidden="true"></i>
                            <span>@duyuru.Metin</span>
                        </span>
                    }
                    @foreach (var duyuru in duyurular)
                    {
                        <span class="announcement-item" aria-hidden="true">
                            <i class="bi bi-flower1"></i>
                            <span>@duyuru.Metin</span>
                        </span>
                    }
                </div>
            </div>
            <span class="announcement-sparkle" aria-hidden="true"><i class="bi bi-heart-fill"></i></span>
        </div>
    </section>

    <style>
        .announcement-bar {
            --announcement-green: rgba(232, 244, 235, .78);
            --announcement-pink: rgba(250, 232, 239, .72);
            position: relative;
            overflow: hidden;
            padding: 6px 0;
            color: #486b56;
            background: linear-gradient(105deg, var(--announcement-green), rgba(250, 241, 243, .66) 48%, var(--announcement-pink));
            border-bottom: 1px solid rgba(201, 160, 174, .12);
        }

        .announcement-inner {
            display: flex;
            align-items: center;
            gap: 20px;
            max-width: 1440px;
            margin: 0 auto;
            padding: 0 24px;
        }

        .announcement-sparkle {
            color: #c38b9e;
        }

        .announcement-viewport {
            min-width: 0;
            flex: 1;
            overflow: hidden;
            mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
        }

        .announcement-track {
            display: flex;
            width: max-content;
            animation: announcement-scroll 15s linear infinite;
        }

        .announcement-item {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 0 30px;
            color: #496d56;
            font-family: 'Playfair Display', Georgia, serif !important;
            font-size: 1rem;
            font-weight: 500;
            letter-spacing: .01em;
            white-space: nowrap;
        }

        .announcement-item > span {
            font-family: 'Playfair Display', Georgia, serif !important;
        }

        .announcement-item > i {
            color: #c695a4;
            font-size: 1rem;
        }

        .announcement-sparkle {
            flex: 0 0 auto;
            font-size: .85rem;
        }

        .announcement-bar:hover .announcement-track {
            animation-play-state: paused;
        }

        @@keyframes announcement-scroll {
            to { transform: translateX(-50%); }
        }

        @@media (prefers-reduced-motion: reduce) {
            .announcement-track { animation: none; }
            .announcement-viewport { overflow-x: auto; }
        }

        @@media (max-width: 576px) {
            .announcement-bar { padding: 6px 0; }
            .announcement-inner { gap: 10px; padding: 0 12px; }
            .announcement-item { padding: 0 20px; font-size: .92rem; }
            .announcement-sparkle { display: none; }
        }
    </style>
}
