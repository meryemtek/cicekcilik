@using ECommerce.Application.DTOs.AnasayfaKategori
@model List<AnasayfaKategoriDto>

@{
    var kategoriler = Model?.Where(x => x.AktifMi).OrderBy(x => x.SiraNo).ToList() ?? new List<AnasayfaKategoriDto>();
}

<!-- =========================================================
     SERBEST & ÇİZGİSİZ ÇİÇEK KATEGORİLERİ AKIŞI
========================================================= -->
@if (kategoriler.Any())
{
    <div class="cat-showcase-wrapper" aria-label="Çiçek Kategorileri">
        @foreach (var kat in kategoriler)
        {
            <a href="/kategori/@kat.SeoUrl" class="cat-showcase-item" title="@kat.KategoriAdi">
                <div class="cat-card-squircle">
                    @if (!string.IsNullOrWhiteSpace(kat.GorselUrl))
                    {
                        <img src="@kat.GorselUrl" alt="@kat.KategoriAdi" loading="lazy" />
                    }
                    else
                    {
                        <i class="bi bi-flower2" aria-hidden="true"></i>
                    }
                </div>
                <span class="cat-card-title">@kat.KategoriAdi</span>
            </a>
        }
    </div>
}

<style>
    /* =========================================================
       SERBEST, ÇİZGİSİZ & ÇERÇEVESİZ KATEGORİ VİTRİNİ
    ========================================================= */
    .cat-showcase-wrapper {
        display: flex;
        align-items: flex-start;
        justify-content: flex-start;
        gap: 1.15rem;
        overflow-x: auto;
        /* Kapsayan çerçeve ve alt çizgi tamamen kaldırıldı */
        border: none !important;
        background: transparent !important;
        padding-top: 14px;
        padding-bottom: 14px;
        padding-left: 16px;
        padding-right: 16px;
        margin: 0 auto;
        max-width: 1440px;
        scrollbar-width: none; /* Firefox */
        -ms-overflow-style: none; /* IE/Edge */
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
    }

    .cat-showcase-wrapper::-webkit-scrollbar {
        display: none; /* Chrome/Safari */
    }

    @@media (min-width: 1200px) {
        .cat-showcase-wrapper {
            justify-content: center;
            gap: 1.35rem;
            padding-left: 24px;
            padding-right: 24px;
        }
    }

    /* Kategori Tekil Elemanı */
    .cat-showcase-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-decoration: none;
        width: 82px;
        min-width: 82px;
        transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
        cursor: pointer;
    }

    .cat-showcase-item:hover {
        transform: translateY(-4px);
    }

    /* Nane Yeşili Squircle Kart */
    .cat-card-squircle {
        width: 76px;
        height: 76px;
        background: #e5f6eb; /* Açık pastel nane yeşili */
        border-radius: 22px; /* Yumuşak squircle */
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
        padding: 6px;
        box-shadow: 0 4px 12px rgba(46, 125, 50, 0.08);
        border: 1px solid rgba(46, 125, 50, 0.08);
        transition: all 0.25s ease;
    }

    .cat-showcase-item:hover .cat-card-squircle {
        background: #d6f2df;
        box-shadow: 0 8px 20px rgba(46, 125, 50, 0.18);
        border-color: rgba(46, 125, 50, 0.22);
    }

    /* Çiçek Görseli */
    .cat-card-squircle img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 16px;
        transition: transform 0.35s ease;
    }

    .cat-card-squircle > i {
        color: #629075;
        font-size: 2rem;
    }

    .cat-showcase-item:hover .cat-card-squircle img {
        transform: scale(1.08);
    }

    /* Kategori Başlığı */
    .cat-card-title {
        margin-top: 6px;
        font-size: 0.76rem;
        font-weight: 600;
        color: #212529;
        text-align: center;
        line-height: 1.2;
        max-width: 100%;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: color 0.2s ease;
        font-family: 'Outfit', sans-serif;
    }

    .cat-showcase-item:hover .cat-card-title {
        color: #1b4332;
        font-weight: 700;
    }

    @@media (max-width: 576px) {
        .cat-showcase-item {
            width: 70px;
            min-width: 70px;
        }

        .cat-card-squircle {
            width: 66px;
            height: 66px;
            border-radius: 18px;
            padding: 5px;
        }

        .cat-card-title {
            font-size: 0.7rem;
            margin-top: 5px;
        }
    }
</style>
